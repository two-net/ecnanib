@page "/agents/{Id:guid}/setup/{Step?}"
@attribute [Authorize]
@using System.Globalization
@using System.Text.Json
@using Ecnanib.Agents.Configuration
@using Ecnanib.Ai.Abstractions
@using Ecnanib.Database.Entities
@using Ecnanib.Exchange.Abstractions
@using Ecnanib.Experience.Abstractions
@using Ecnanib.ModelSync.Abstractions
@using Microsoft.Extensions.Options
@inject IAgentService AgentService
@inject IStrategyCatalog Catalog
@inject IKeyService KeyService
@inject IModelCatalog ModelCatalog
@inject ICouncilSuggestions Suggestions
@inject IOptions<RiskCapsOptions> RiskCaps
@inject IAccountService Accounts
@inject NavigationManager Navigation

<PageTitle>@(_agent is { } titleAgent ? $"Set up {titleAgent.Name}: {WizardSteps.Title(_step)}" : "Agent setup")</PageTitle>

@if (_agent is { } agent)
{
    <p><a href="/agents/@Id">← @agent.Name</a></p>
    <h1>Set up @agent.Name</h1>
    <p class="hint">
        <span class="status @AgentMessages.StateClass(agent.State)">@AgentMessages.Describe(agent.State, agent.PauseCause)</span>
        @agent.Symbol on @AgentMessages.Market(agent.MarketType), @AgentMessages.Timeframe(agent.Timeframe) candles, @AgentMessages.Mode(agent.Mode).ToLowerInvariant() mode.
        @(agent.State == AgentState.Draft ? AgentMessages.SetupIntro : agent.State == AgentState.Running ? AgentMessages.RunningEditHint : "")
    </p>

    <WizardStepper Current="_step" AgentId="Id" />

    @if (_notice is not null)
    {
        <p class="notice" role="status">@_notice</p>
    }
    @if (_deprecatedRoles.Count > 0 && _step != WizardStep.Council)
    {
        <p class="warning" role="alert">@AgentMessages.DeprecatedModels(_deprecatedRoles) <a href="@WizardSteps.Href(Id, WizardStep.Council)">Go to the council step</a>.</p>
    }

    @if (_step == WizardStep.Basics)
    {
        <section class="card" aria-labelledby="settings-title">
            <h2 id="settings-title">Basics</h2>
            <EditForm Model="Settings" FormName="agent-settings" OnValidSubmit="SaveSettingsAsync" method="post">
                <DataAnnotationsValidator />
                @if (_settingsError is not null)
                {
                    <p class="error" role="alert">@_settingsError</p>
                }
                <ValidationSummary />
                <label>
                    Name
                    <InputText @bind-Value="Settings.Name" maxlength="100" autocomplete="off" required />
                </label>
                <label>
                    Market
                    <InputSelect @bind-Value="Settings.MarketType" disabled="@(!CanEdit(AgentField.MarketType))">
                        <option value="@MarketType.Spot">Spot (long only)</option>
                        <option value="@MarketType.UsdFutures">USDⓈ-M Futures (long or short)</option>
                    </InputSelect>
                </label>
                <label>
                    Symbol
                    <InputText @bind-Value="Settings.Symbol" maxlength="30" autocomplete="off" spellcheck="false" disabled="@(!CanEdit(AgentField.Symbol))" />
                </label>
                <label>
                    Timeframe
                    <InputSelect @bind-Value="Settings.Timeframe" disabled="@(!CanEdit(AgentField.Timeframe))">
                        @foreach (var timeframe in AgentsOptions.Timeframes)
                        {
                            <option value="@timeframe">@AgentsOptions.KeyOf(timeframe)</option>
                        }
                    </InputSelect>
                </label>
                <p class="hint">Changing the timeframe switches to that timeframe's default strategy and resets its parameters.</p>
                <label>
                    Mode
                    <InputSelect @bind-Value="Settings.Mode" disabled="@(!CanEdit(AgentField.Mode))">
                        <option value="@AgentMode.Paper">Paper</option>
                        <option value="@AgentMode.Live">Live</option>
                    </InputSelect>
                </label>
                <p class="hint">@AgentMessages.PaperHint</p>
                <label>
                    Binance key (live mode)
                    <InputSelect @bind-Value="Settings.ExchangeKeyId" disabled="@(!CanEdit(AgentField.ExchangeKey))">
                        <option value="">None</option>
                        @if (_keys is not null)
                        {
                            @foreach (var key in _keys.ExchangeKeys)
                            {
                                <option value="@key.Id">@key.Label (@key.Environment, @AgentMessages.Markets(key))</option>
                            }
                        }
                    </InputSelect>
                </label>
                @if (_keys is { ExchangeKeys.Count: 0 })
                {
                    <p class="hint">You have no Binance key; add one on the <a href="/keys">keys page</a> before starting a live agent.</p>
                }
                <fieldset>
                    <legend>Futures only</legend>
                    <label>
                        Leverage (1–@RiskCaps.Value.MaxLeverage)
                        <InputNumber @bind-Value="Settings.Leverage" min="1" max="@RiskCaps.Value.MaxLeverage" disabled="@(!CanEdit(AgentField.Leverage))" />
                    </label>
                    <label>
                        Margin
                        <InputSelect @bind-Value="Settings.MarginType" disabled="@(!CanEdit(AgentField.MarginType))">
                            <option value="@MarginType.Isolated">Isolated (default)</option>
                            <option value="@MarginType.Cross">Cross</option>
                        </InputSelect>
                    </label>
                </fieldset>
                <label class="check">
                    <InputCheckbox @bind-Value="Settings.Discretionary" disabled="@(!CanEdit(AgentField.Discretionary))" />
                    Discretionary mode: the council may propose an entry without a strategy setup (off by default).
                </label>
                <button type="submit" class="primary">@SaveLabel</button>
            </EditForm>
        </section>
    }
    else if (_step == WizardStep.Strategy)
    {
        <section class="card" aria-labelledby="strategy-title">
            <h2 id="strategy-title">Strategy and parameters</h2>
            <EditForm Model="Strategy" FormName="agent-strategy" OnValidSubmit="SaveStrategyAsync" method="post">
                @if (_strategyError is not null)
                {
                    <p class="error" role="alert">@_strategyError</p>
                }
                <label>
                    Strategy (@AgentMessages.Timeframe(agent.Timeframe))
                    <InputSelect @bind-Value="Strategy.StrategyId" disabled="@(!CanEdit(AgentField.Strategy))">
                        @foreach (var descriptor in Catalog.ForTimeframe(agent.Timeframe))
                        {
                            <option value="@descriptor.Id">@descriptor.Name</option>
                        }
                    </InputSelect>
                </label>
                @if (_strategy is not null)
                {
                    <p class="hint">@_strategy.Summary</p>
                    @if (_strategy.Version != agent.StrategyVersion)
                    {
                        <p class="error" role="alert">Version @agent.StrategyVersion of this strategy is no longer available; the parameters of version @_strategy.Version are shown. Upgrade the agent to run it.</p>
                    }
                    <fieldset>
                        <legend>Parameters (blank means the default)</legend>
                        <div class="parameters">
                            @foreach (var parameter in _strategy.Parameters)
                            {
                                var name = parameter.Name;
                                <label>
                                    @parameter.Label
                                    @if (parameter.Kind is StrategyParameterKind.Integer or StrategyParameterKind.Decimal)
                                    {
                                        <span class="muted">(@parameter.Min to @parameter.Max, default @parameter.DefaultText)</span>
                                        <InputText @bind-Value="Strategy.Values[name]" placeholder="@parameter.DefaultText" inputmode="@(parameter.Kind == StrategyParameterKind.Integer ? "numeric" : "decimal")" disabled="@(!CanEdit(AgentField.Parameters))" />
                                    }
                                    else if (parameter.Kind == StrategyParameterKind.Choice)
                                    {
                                        <InputSelect @bind-Value="Strategy.Values[name]" disabled="@(!CanEdit(AgentField.Parameters))">
                                            <option value="">Default (@parameter.DefaultText)</option>
                                            @foreach (var choice in parameter.Choices!)
                                            {
                                                <option value="@choice">@choice</option>
                                            }
                                        </InputSelect>
                                    }
                                    else
                                    {
                                        <InputSelect @bind-Value="Strategy.Values[name]" disabled="@(!CanEdit(AgentField.Parameters))">
                                            <option value="">Default (@parameter.DefaultText)</option>
                                            <option value="true">On</option>
                                            <option value="false">Off</option>
                                        </InputSelect>
                                    }
                                </label>
                            }
                        </div>
                    </fieldset>
                }
                <label class="check">
                    <InputCheckbox @bind-Value="Strategy.ResetToDefaults" disabled="@(!CanEdit(AgentField.Parameters))" />
                    Reset every parameter to its default.
                </label>
                <button type="submit" class="primary" disabled="@(!CanEdit(AgentField.Parameters) && !CanEdit(AgentField.Strategy))">@SaveLabel</button>
            </EditForm>
            @if (UpgradeAvailable)
            {
                <h3>Upgrade</h3>
                <p class="hint">Version @agent.LatestStrategyVersion of @(_strategy?.Name ?? agent.StrategyId) is available; this agent runs version @agent.StrategyVersion. @AgentMessages.UpgradeHint @(CanEdit(AgentField.StrategyVersion) ? "" : "Pause or stop the agent first.")</p>
                <form method="post" @formname="upgrade-strategy" @onsubmit="UpgradeAsync" class="inline">
                    <AntiforgeryToken />
                    <button type="submit" disabled="@(!CanEdit(AgentField.StrategyVersion))">Upgrade to version @agent.LatestStrategyVersion</button>
                </form>
            }
        </section>
    }
    else if (_step == WizardStep.Council)
    {
        <section id="council" class="card" aria-labelledby="council-title">
            <h2 id="council-title">Council</h2>
            <p>Four roles in order; the Risk Manager always runs last and cannot be disabled. A role's provider needs a valid key before the agent can start. Pick a model from the synced catalog, or choose "Other" and type a model id as the provider lists it.</p>
            @if (_suggestions.Count > 0)
            {
                <p class="hint">@ExperienceMessages.Suggestions(_suggestions, agent.Timeframe, agent.MarketType)</p>
            }
            <EditForm Model="Council" FormName="agent-council" OnValidSubmit="SaveCouncilAsync" method="post" class="wide">
                @if (_councilError is not null)
                {
                    <p class="error" role="alert">@_councilError</p>
                }
                <div class="table-wrap">
                    <table class="agents council" aria-labelledby="council-title">
                        <thead><tr><th scope="col">Role</th><th scope="col">Model</th><th scope="col">Other: provider and model id</th><th scope="col">Enabled</th></tr></thead>
                        <tbody>
                            <tr>
                                <td>Market Analyst<br /><span class="muted">@CouncilRoles.Responsibility(CouncilRole.MarketAnalyst)</span></td>
                                <td>
                                    <InputSelect @bind-Value="Council.MarketAnalystChoice" aria-label="Market Analyst model" disabled="@(!CanEdit(AgentField.Council))">@CatalogOptions()</InputSelect>
                                    @if (Deprecation(CouncilRole.MarketAnalyst) is { } analystNote)
                                    {
                                        <span class="muted warning-text">@analystNote</span>
                                    }
                                </td>
                                <td>
                                    <div class="other">
                                        <InputSelect @bind-Value="Council.MarketAnalystProvider" aria-label="Market Analyst provider" disabled="@(!CanEdit(AgentField.Council))">@ProviderOptions()</InputSelect>
                                        <InputText @bind-Value="Council.MarketAnalystModel" aria-label="Market Analyst model id" maxlength="200" autocomplete="off" spellcheck="false" placeholder="model id" disabled="@(!CanEdit(AgentField.Council))" />
                                    </div>
                                </td>
                                <td><InputCheckbox @bind-Value="Council.MarketAnalystEnabled" aria-label="Market Analyst enabled" disabled="@(!CanEdit(AgentField.Council))" /></td>
                            </tr>
                            <tr>
                                <td>Sentiment &amp; Flow<br /><span class="muted">@CouncilRoles.Responsibility(CouncilRole.SentimentFlow)</span></td>
                                <td>
                                    <InputSelect @bind-Value="Council.SentimentFlowChoice" aria-label="Sentiment &amp; Flow model" disabled="@(!CanEdit(AgentField.Council))">@CatalogOptions()</InputSelect>
                                    @if (Deprecation(CouncilRole.SentimentFlow) is { } sentimentNote)
                                    {
                                        <span class="muted warning-text">@sentimentNote</span>
                                    }
                                </td>
                                <td>
                                    <div class="other">
                                        <InputSelect @bind-Value="Council.SentimentFlowProvider" aria-label="Sentiment &amp; Flow provider" disabled="@(!CanEdit(AgentField.Council))">@ProviderOptions()</InputSelect>
                                        <InputText @bind-Value="Council.SentimentFlowModel" aria-label="Sentiment &amp; Flow model id" maxlength="200" autocomplete="off" spellcheck="false" placeholder="model id" disabled="@(!CanEdit(AgentField.Council))" />
                                    </div>
                                </td>
                                <td><InputCheckbox @bind-Value="Council.SentimentFlowEnabled" aria-label="Sentiment &amp; Flow enabled" disabled="@(!CanEdit(AgentField.Council))" /></td>
                            </tr>
                            <tr>
                                <td>Cross-Market Context<br /><span class="muted">@CouncilRoles.Responsibility(CouncilRole.CrossMarketContext)</span></td>
                                <td>
                                    <InputSelect @bind-Value="Council.CrossMarketContextChoice" aria-label="Cross-Market Context model" disabled="@(!CanEdit(AgentField.Council))">@CatalogOptions()</InputSelect>
                                    @if (Deprecation(CouncilRole.CrossMarketContext) is { } contextNote)
                                    {
                                        <span class="muted warning-text">@contextNote</span>
                                    }
                                </td>
                                <td>
                                    <div class="other">
                                        <InputSelect @bind-Value="Council.CrossMarketContextProvider" aria-label="Cross-Market Context provider" disabled="@(!CanEdit(AgentField.Council))">@ProviderOptions()</InputSelect>
                                        <InputText @bind-Value="Council.CrossMarketContextModel" aria-label="Cross-Market Context model id" maxlength="200" autocomplete="off" spellcheck="false" placeholder="model id" disabled="@(!CanEdit(AgentField.Council))" />
                                    </div>
                                </td>
                                <td><InputCheckbox @bind-Value="Council.CrossMarketContextEnabled" aria-label="Cross-Market Context enabled" disabled="@(!CanEdit(AgentField.Council))" /></td>
                            </tr>
                            <tr>
                                <td>Risk Manager<br /><span class="muted">@CouncilRoles.Responsibility(CouncilRole.RiskManager)</span></td>
                                <td>
                                    <InputSelect @bind-Value="Council.RiskManagerChoice" aria-label="Risk Manager model" disabled="@(!CanEdit(AgentField.Council))">@CatalogOptions()</InputSelect>
                                    @if (Deprecation(CouncilRole.RiskManager) is { } riskNote)
                                    {
                                        <span class="muted warning-text">@riskNote</span>
                                    }
                                </td>
                                <td>
                                    <div class="other">
                                        <InputSelect @bind-Value="Council.RiskManagerProvider" aria-label="Risk Manager provider" disabled="@(!CanEdit(AgentField.Council))">@ProviderOptions()</InputSelect>
                                        <InputText @bind-Value="Council.RiskManagerModel" aria-label="Risk Manager model id" maxlength="200" autocomplete="off" spellcheck="false" placeholder="model id" disabled="@(!CanEdit(AgentField.Council))" />
                                    </div>
                                </td>
                                <td>always</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                @if (_catalog.Count == 0)
                {
                    <p class="hint">No models are synced yet: add a provider key on the keys page and the catalog fills in. Until then, type the model id.</p>
                }
                <button type="submit" class="primary" disabled="@(!CanEdit(AgentField.Council))">@SaveLabel</button>
            </EditForm>

            <h3 id="council-presets-title">Presets</h3>
            <EditForm Model="Preset" FormName="council-preset" OnValidSubmit="ApplyPresetAsync" method="post">
                @if (_presetError is not null)
                {
                    <p class="error" role="alert">@_presetError</p>
                }
                <p>Defaults by strength (Appendix B): GPT as Market Analyst, Grok for Sentiment &amp; Flow, Gemini for Cross-Market Context and Claude as Risk Manager, each on its provider's newest catalog model, all roles enabled. They are starting points, not a claim of returns.</p>
                <button type="submit" name="preset" value="defaults" disabled="@(!CanEdit(AgentField.Council))">Use the defaults by strength</button>
                <p>Single-model mode: one model performs all four roles in sequence.</p>
                <label>
                    Model
                    <InputSelect @bind-Value="Preset.Choice" disabled="@(!CanEdit(AgentField.Council))">@CatalogOptions()</InputSelect>
                </label>
                <div class="other">
                    <InputSelect @bind-Value="Preset.Provider" aria-label="Provider for every role, when Other is chosen" disabled="@(!CanEdit(AgentField.Council))">@ProviderOptions()</InputSelect>
                    <InputText @bind-Value="Preset.Model" aria-label="Model id for every role, when Other is chosen" maxlength="200" autocomplete="off" spellcheck="false" placeholder="model id (when Other is chosen)" disabled="@(!CanEdit(AgentField.Council))" />
                </div>
                <button type="submit" name="preset" value="single" disabled="@(!CanEdit(AgentField.Council))">Use this model for every role</button>
            </EditForm>
        </section>
    }
    else if (_step == WizardStep.Risk)
    {
        <section class="card" aria-labelledby="risk-title">
            <h2 id="risk-title">Risk limits</h2>
            <EditForm Model="Risk" FormName="agent-risk" OnValidSubmit="SaveRiskAsync" method="post">
                <DataAnnotationsValidator />
                @if (_riskError is not null)
                {
                    <p class="error" role="alert">@_riskError</p>
                }
                <ValidationSummary />
                <label>
                    Risk per trade (% of equity, at most @RiskCaps.Value.MaxRiskPerTradePercent)
                    <InputNumber @bind-Value="Risk.RiskPerTradePercent" step="0.1" disabled="@(!CanEdit(AgentField.RiskLimits))" />
                </label>
                <label>
                    Open positions at most (up to @RiskCaps.Value.MaxOpenPositions)
                    <InputNumber @bind-Value="Risk.MaxOpenPositions" disabled="@(!CanEdit(AgentField.RiskLimits))" />
                </label>
                <label>
                    Daily loss limit (% of equity, at most @RiskCaps.Value.MaxDailyLossPercent)
                    <InputNumber @bind-Value="Risk.DailyLossLimitPercent" step="0.1" disabled="@(!CanEdit(AgentField.RiskLimits))" />
                </label>
                <label>
                    Notional cap (quote asset; empty for none)
                    <InputNumber @bind-Value="Risk.MaxNotional" disabled="@(!CanEdit(AgentField.RiskLimits))" />
                </label>
                <button type="submit" class="primary" disabled="@(!CanEdit(AgentField.RiskLimits))">@SaveLabel</button>
            </EditForm>
        </section>

        <section class="card" aria-labelledby="windows-title">
            <h2 id="windows-title">No-entry windows</h2>
            <p class="hint">@AgentMessages.WindowsHint</p>
            @if (_windowError is not null)
            {
                <p class="error" role="alert">@_windowError</p>
            }
            @if (agent.EntryWindows.Count == 0)
            {
                <p>No window.</p>
            }
            else
            {
                <form method="post" @formname="remove-window" @onsubmit="RemoveWindowAsync">
                    <AntiforgeryToken />
                    <div class="table-wrap">
                        <table class="agents" aria-labelledby="windows-title">
                            <thead><tr><th scope="col">Kind</th><th scope="col">When</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                            <tbody>
                                @foreach (var window in agent.EntryWindows)
                                {
                                    <tr>
                                        <td>@AgentMessages.Kind(window.Kind)</td>
                                        <td>@AgentMessages.Describe(window)</td>
                                        <td><button type="submit" name="windowId" value="@window.Id" disabled="@(!CanEdit(AgentField.EntryWindows))">Remove</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </form>
            }
            <h3>Add a window</h3>
            <EditForm Model="Window" FormName="add-window" OnValidSubmit="AddWindowAsync" method="post">
                <label>
                    Kind
                    <InputSelect @bind-Value="Window.Kind" disabled="@(!CanEdit(AgentField.EntryWindows))">
                        <option value="@EntryWindowKind.Recurring">Every week</option>
                        <option value="@EntryWindowKind.OneOff">One-off</option>
                    </InputSelect>
                </label>
                <fieldset>
                    <legend>Every week (UTC)</legend>
                    @* One label per control: a label names only the first control inside it. *@
                    <label>
                        From day
                        <InputSelect @bind-Value="Window.StartDay" disabled="@(!CanEdit(AgentField.EntryWindows))">@DayOptions()</InputSelect>
                    </label>
                    <label>
                        From time
                        <InputText @bind-Value="Window.StartTime" type="time" placeholder="21:00" disabled="@(!CanEdit(AgentField.EntryWindows))" />
                    </label>
                    <label>
                        Until day
                        <InputSelect @bind-Value="Window.EndDay" disabled="@(!CanEdit(AgentField.EntryWindows))">@DayOptions()</InputSelect>
                    </label>
                    <label>
                        Until time
                        <InputText @bind-Value="Window.EndTime" type="time" placeholder="01:00" disabled="@(!CanEdit(AgentField.EntryWindows))" />
                    </label>
                </fieldset>
                <fieldset>
                    <legend>One-off (UTC)</legend>
                    <label>
                        From
                        <InputText @bind-Value="Window.StartAt" type="datetime-local" disabled="@(!CanEdit(AgentField.EntryWindows))" />
                    </label>
                    <label>
                        Until
                        <InputText @bind-Value="Window.EndAt" type="datetime-local" disabled="@(!CanEdit(AgentField.EntryWindows))" />
                    </label>
                </fieldset>
                <button type="submit" disabled="@(!CanEdit(AgentField.EntryWindows))">Add window</button>
            </EditForm>
        </section>
    }
    else
    {
        <section class="card" aria-labelledby="review-title">
            <h2 id="review-title">Review</h2>
            @if (_actionError is not null)
            {
                <p class="error" role="alert">@_actionError</p>
            }
            <dl class="details">
                <dt>Trades</dt><dd>@agent.Symbol on @AgentMessages.Market(agent.MarketType), @AgentMessages.Timeframe(agent.Timeframe) candles, @AgentMessages.Mode(agent.Mode).ToLowerInvariant() mode @(agent.Discretionary ? "(discretionary)" : "") <a href="@WizardSteps.Href(Id, WizardStep.Basics)">Edit</a></dd>
                @if (agent.Mode == AgentMode.Live)
                {
                    <dt>Binance key</dt><dd>@(_keys?.ExchangeKeys.FirstOrDefault(k => k.Id == agent.ExchangeKeyId)?.Label ?? "none chosen")</dd>
                }
                @if (agent.MarketType == MarketType.UsdFutures)
                {
                    <dt>Leverage</dt><dd>@(agent.Leverage?.ToString(CultureInfo.InvariantCulture) ?? "default")×, @(agent.MarginType?.ToString().ToLowerInvariant() ?? "isolated") margin</dd>
                }
                <dt>Strategy</dt><dd>@(_strategy?.Name ?? agent.StrategyId) version @agent.StrategyVersion@(agent.Parameters.Count > 0 ? $", {AgentMessages.Plural(agent.Parameters.Count, "parameter changed", "parameters changed")}" : ", default parameters") <a href="@WizardSteps.Href(Id, WizardStep.Strategy)">Edit</a></dd>
                <dt>Council</dt>
                <dd>
                    @foreach (var role in agent.Council)
                    {
                        <span class="muted">@CouncilRoles.Display(role.Role): @ProviderNames.Display(role.Provider) @(role.Model.Length == 0 ? "(no model)" : role.Model)@(role.Enabled ? "" : " (disabled)")@(role.CatalogStatus == ModelStatus.Deprecated ? " (deprecated)" : "")</span>
                    }
                    <a href="@WizardSteps.Href(Id, WizardStep.Council)">Edit</a>
                </dd>
                <dt>Risk</dt><dd>@ExperienceMessages.Price(agent.RiskLimits.RiskPerTradePercent)% per trade, at most @agent.RiskLimits.MaxOpenPositions open, @ExperienceMessages.Price(agent.RiskLimits.DailyLossLimitPercent)% daily loss@(agent.RiskLimits.MaxNotional is { } cap ? $", notional cap {ExperienceMessages.Price(cap)}" : "") <a href="@WizardSteps.Href(Id, WizardStep.Risk)">Edit</a></dd>
                <dt>No-entry windows</dt><dd>@AgentMessages.Plural(agent.EntryWindows.Count, "window", "windows")</dd>
            </dl>
            @if (OfferDisclaimer)
            {
                @* FR-ACC-08: a live agent that can be started, whose owner has not accepted the current version, gets the text and the box beside Start. *@
                <RiskDisclaimerNotice Level="3" Status="_disclaimer" ReturnTo="@(WizardSteps.Href(Id, WizardStep.Review) + "?status=disclaimer-accepted")" />
            }
            @if (AgentStateMachine.CanStart(agent.State))
            {
                <p>Starting evaluates the agent at every @AgentMessages.Timeframe(agent.Timeframe) candle close from now on, also while you are offline.</p>
                <form method="post" @formname="start-agent" @onsubmit="StartAsync" class="inline">
                    <AntiforgeryToken />
                    <button type="submit" class="primary">Start the agent</button>
                </form>
            }
            else
            {
                <p>The agent is @AgentMessages.Describe(agent.State, agent.PauseCause).ToLowerInvariant(); pause, resume or stop it from <a href="/agents/@Id">its page</a>.</p>
            }
        </section>
    }

    <nav class="wizard-nav" aria-label="Setup steps navigation">
        @if (WizardSteps.Previous(_step) is { } previous)
        {
            <a class="button" href="@WizardSteps.Href(Id, previous)">← @WizardSteps.Title(previous)</a>
        }
        else
        {
            <span></span>
        }
        @if (WizardSteps.Next(_step) is { } next)
        {
            <a class="button" href="@WizardSteps.Href(Id, next)">@WizardSteps.Title(next) →</a>
        }
        else
        {
            <a class="button" href="/agents/@Id">Agent page →</a>
        }
    </nav>

    @if (!OfferDisclaimer)
    {
        @* FR-UI-05 on every step; the heading id and the form name are unique per page, so the review card's instance stands in when it is shown. *@
        <RiskDisclaimerNotice />
    }
}

@code {
    private AgentDetail? _agent;
    private StrategyDescriptor? _strategy;
    private DisclaimerStatus? _disclaimer;
    private KeyOverview? _keys;
    private WizardStep _step;
    private string? _notice;
    private string? _actionError;
    private string? _settingsError;
    private string? _strategyError;
    private string? _councilError;
    private string? _presetError;
    private string? _riskError;
    private string? _windowError;

    private IReadOnlyList<CatalogModel> _catalog = [];
    private IReadOnlyList<CouncilAssignmentView> _deprecatedRoles = [];
    private IReadOnlyList<CouncilSuggestion> _suggestions = [];

    [Parameter]
