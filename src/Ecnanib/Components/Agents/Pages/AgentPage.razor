    private sealed class StrategyFormInput
    {
        public string? StrategyId { get; set; }

        public string? AtrPeriod { get; set; }

        public string? EmaFastPeriod { get; set; }

        public string? EmaSlowPeriod { get; set; }

        public string? StopBufferAtr { get; set; }

        public string? PartialTakeProfitFraction { get; set; }

        public string? TrailingMethod { get; set; }

        public string? EntryTimeoutCandles { get; set; }

        public string? MarketFallback { get; set; }

        public bool ResetToDefaults { get; set; }

        public static StrategyFormInput From(AgentDetail agent) => new()
        {
            StrategyId = agent.StrategyId,
            AtrPeriod = Text(agent.Parameters, StrategyParameters.AtrPeriod),
            EmaFastPeriod = Text(agent.Parameters, StrategyParameters.EmaFastPeriod),
            EmaSlowPeriod = Text(agent.Parameters, StrategyParameters.EmaSlowPeriod),
            StopBufferAtr = Text(agent.Parameters, StrategyParameters.StopBufferAtr),
            PartialTakeProfitFraction = Text(agent.Parameters, StrategyParameters.PartialTakeProfitFraction),
            TrailingMethod = Text(agent.Parameters, StrategyParameters.TrailingMethod),
            EntryTimeoutCandles = Text(agent.Parameters, StrategyParameters.EntryTimeoutCandles),
            MarketFallback = Text(agent.Parameters, StrategyParameters.MarketFallback),
        };

        public IReadOnlyDictionary<string, string?> ToParameters() => new Dictionary<string, string?>(StringComparer.Ordinal)
        {
            [StrategyParameters.AtrPeriod] = AtrPeriod,
            [StrategyParameters.EmaFastPeriod] = EmaFastPeriod,
            [StrategyParameters.EmaSlowPeriod] = EmaSlowPeriod,
            [StrategyParameters.StopBufferAtr] = StopBufferAtr,
            [StrategyParameters.PartialTakeProfitFraction] = PartialTakeProfitFraction,
            [StrategyParameters.TrailingMethod] = TrailingMethod,
            [StrategyParameters.EntryTimeoutCandles] = EntryTimeoutCandles,
            [StrategyParameters.MarketFallback] = MarketFallback,
        };
    }

    private sealed class CouncilFormInput
    {
        public AiProvider MarketAnalystProvider { get; set; } = AiProvider.Gpt;

        public string? MarketAnalystModel { get; set; }

        public bool MarketAnalystEnabled { get; set; } = true;

        public AiProvider SentimentFlowProvider { get; set; } = AiProvider.Grok;

        public string? SentimentFlowModel { get; set; }

        public bool SentimentFlowEnabled { get; set; } = true;

        public AiProvider CrossMarketContextProvider { get; set; } = AiProvider.Gemini;

        public string? CrossMarketContextModel { get; set; }

        public bool CrossMarketContextEnabled { get; set; } = true;

        public AiProvider RiskManagerProvider { get; set; } = AiProvider.Claude;

        public string? RiskManagerModel { get; set; }

        public static CouncilFormInput From(AgentDetail agent)
        {
            var input = new CouncilFormInput();
            foreach (var role in agent.Council)
            {
                switch (role.Role)
                {
                    case CouncilRole.MarketAnalyst:
                        (input.MarketAnalystProvider, input.MarketAnalystModel, input.MarketAnalystEnabled) = (role.Provider, role.Model, role.Enabled);
                        break;
                    case CouncilRole.SentimentFlow:
                        (input.SentimentFlowProvider, input.SentimentFlowModel, input.SentimentFlowEnabled) = (role.Provider, role.Model, role.Enabled);
                        break;
                    case CouncilRole.CrossMarketContext:
                        (input.CrossMarketContextProvider, input.CrossMarketContextModel, input.CrossMarketContextEnabled) = (role.Provider, role.Model, role.Enabled);
                        break;
                    case CouncilRole.RiskManager:
                        (input.RiskManagerProvider, input.RiskManagerModel) = (role.Provider, role.Model);
                        break;
                }
            }

            return input;
        }

        public CouncilInput ToInput() => new(
        [
            new CouncilRoleInput(CouncilRole.MarketAnalyst, MarketAnalystProvider, MarketAnalystModel, MarketAnalystEnabled),
            new CouncilRoleInput(CouncilRole.SentimentFlow, SentimentFlowProvider, SentimentFlowModel, SentimentFlowEnabled),
            new CouncilRoleInput(CouncilRole.CrossMarketContext, CrossMarketContextProvider, CrossMarketContextModel, CrossMarketContextEnabled),
            new CouncilRoleInput(CouncilRole.RiskManager, RiskManagerProvider, RiskManagerModel, true),
        ]);
    }

