@page "/agents/{Id:guid}"
@attribute [Authorize]
@using Ecnanib.Database.Entities
@using Ecnanib.Experience.Abstractions
@using Ecnanib.Logging.Abstractions
@inject IAgentService AgentService
@inject IStrategyCatalog Catalog
@inject IExperienceReader Experience
@inject ILogReader Logs
@inject NavigationManager Navigation

<PageTitle>Agent</PageTitle>

@if (_agent is { } agent)
{
    <p><a href="/agents">← Dashboard</a></p>
    <h1>@agent.Name</h1>
    <AgentHeaderLive AgentId="Id" />
    @if (_deprecatedRoles.Count > 0)
    {
        <p class="warning" role="alert">@AgentMessages.DeprecatedModels(_deprecatedRoles) <a href="@WizardSteps.Href(Id, WizardStep.Council)">Go to the council</a>.</p>
    }
    <dl class="details">
        <dt>Trades</dt><dd>@agent.Symbol on @AgentMessages.Market(agent.MarketType), @AgentMessages.Timeframe(agent.Timeframe) candles, @AgentMessages.Mode(agent.Mode).ToLowerInvariant() mode</dd>
        <dt>Strategy</dt><dd>@(_strategy?.Name ?? agent.StrategyId) (version @agent.StrategyVersion@(UpgradeAvailable ? $", version {agent.LatestStrategyVersion} available" : ""))</dd>
        <dt>Created</dt><dd>@AgentMessages.Stamp(agent.CreatedAt)</dd>
        <dt>Updated</dt><dd>@AgentMessages.Stamp(agent.UpdatedAt)</dd>
    </dl>

    @if (_notice is not null)
    {
        <p class="notice" role="status">@_notice</p>
    }
    @if (agent.State == AgentState.Draft)
    {
        <p class="hint">@AgentMessages.DraftHint <a href="@WizardSteps.Href(Id, WizardStep.Strategy)">Continue the setup</a>.</p>
    }

    <section class="card" aria-labelledby="chart-title">
        <h2 id="chart-title">Chart</h2>
        <PriceChart AgentId="Id" />
    </section>

    <section class="card" aria-labelledby="actions-title">
        <h2 id="actions-title">Actions</h2>
        @if (_actionError is not null)
        {
            <p class="error" role="alert">@_actionError</p>
        }
        <div class="actions">
            @if (AgentStateMachine.CanStart(agent.State))
            {
                <form method="post" @formname="start-agent" @onsubmit="StartAsync" class="inline">
                    <AntiforgeryToken />
                    <button type="submit">Start</button>
                </form>
            }
            @if (AgentStateMachine.CanPause(agent.State))
            {
                <form method="post" @formname="pause-agent" @onsubmit="PauseAsync" class="inline">
                    <AntiforgeryToken />
                    <button type="submit">Pause</button>
                </form>
            }
            @if (AgentStateMachine.CanResume(agent.State))
            {
                <form method="post" @formname="resume-agent" @onsubmit="ResumeAsync" class="inline">
                    <AntiforgeryToken />
                    <button type="submit">Resume</button>
                </form>
            }
            <form method="post" @formname="clone-agent" @onsubmit="CloneAsync" class="inline">
                <AntiforgeryToken />
                <button type="submit">Clone</button>
            </form>
            <a class="button" href="@WizardSteps.Href(Id, WizardStep.Basics)">Edit setup</a>
        </div>
        @if (AgentStateMachine.CanStop(agent.State))
        {
            <h3>Stop</h3>
            <p>Stopping cancels the agent's open orders. @(agent.OpenPositions.Count > 0 ? "Choose what happens to its open positions." : "It has no open position.")</p>
            <EditForm Model="StopInput" FormName="stop-agent" OnValidSubmit="StopAsync" method="post">
                @if (agent.OpenPositions.Count > 0)
                {
                    <label>
                        Open positions
                        <InputSelect @bind-Value="StopInput.Positions">
                            <option value="close">Close at market now</option>
                            <option value="leave">Leave them open, shown as unmanaged</option>
                        </InputSelect>
                    </label>
                }
                <button type="submit" class="danger">Stop</button>
            </EditForm>
        }
        @if (AgentStateMachine.CanDelete(agent.State))
        {
            <h3>Delete</h3>
            <EditForm Model="DeleteInput" FormName="delete-agent" OnValidSubmit="DeleteAsync" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <label class="check">
                    <InputCheckbox @bind-Value="DeleteInput.Confirm" />
                    Delete this agent with its history, orders and trades.
                </label>
                <button type="submit" class="danger">Delete agent</button>
            </EditForm>
        }
    </section>

    <section class="card" aria-labelledby="positions-title">
        <h2 id="positions-title">Positions and orders</h2>
        <PositionsOrdersLive AgentId="Id" />
    </section>

    <section class="card" aria-labelledby="trades-title">
        <h2 id="trades-title">Trades</h2>
        <TradeTimeline AgentId="Id" />
    </section>

    <section id="council" class="card" aria-labelledby="setup-title">
        <h2 id="setup-title">Setup</h2>
        <dl class="details">
            <dt>Strategy</dt><dd>@(_strategy?.Name ?? agent.StrategyId), version @agent.StrategyVersion@(agent.Parameters.Count > 0 ? $" with {AgentMessages.Plural(agent.Parameters.Count, "changed parameter", "changed parameters")}" : ", default parameters")</dd>
            <dt>Council</dt>
            <dd>
                <ul class="plain">
                    @foreach (var role in agent.Council)
                    {
                        <li>@CouncilRoles.Display(role.Role): @ProviderNames.Display(role.Provider) @(role.Model.Length == 0 ? "(no model)" : role.Model)@(role.Enabled ? "" : " (disabled)")@(role.CatalogStatus == ModelStatus.Deprecated ? " (deprecated)" : "")</li>
                    }
                </ul>
            </dd>
            <dt>Risk</dt><dd>@agent.RiskLimits.RiskPerTradePercent% per trade, at most @agent.RiskLimits.MaxOpenPositions open, @agent.RiskLimits.DailyLossLimitPercent% daily loss@(agent.RiskLimits.MaxNotional is { } cap ? $", notional cap {cap}" : "")</dd>
            <dt>No-entry windows</dt><dd>@(agent.EntryWindows.Count == 0 ? "none" : string.Join("; ", agent.EntryWindows.Select(AgentMessages.Describe)))</dd>
            @if (agent.Discretionary)
            {
                <dt>Discretionary</dt><dd>The council may propose an entry without a strategy setup.</dd>
            }
        </dl>
        <p><a class="button" href="@WizardSteps.Href(Id, WizardStep.Basics)">Edit setup</a></p>
    </section>

    <section class="card" aria-labelledby="evaluations-title">
        <h2 id="evaluations-title">Decisions</h2>
        <DecisionsLive AgentId="Id" Timeframe="agent.Timeframe" />
    </section>

    <section class="card" aria-labelledby="usage-title">
        <h2 id="usage-title">Council usage</h2>
        <TokenUsage AgentId="Id" />
    </section>

    <section class="card" aria-labelledby="log-title">
        <h2 id="log-title">Log</h2>
        @if (_log is null || _log.Entries.Count == 0)
        {
            <p>@LogMessages.NoEntries</p>
        }
        else
        {
            <LogRows Entries="_log.Entries" AgentId="Id" />
        }
        <p><a class="button" href="/agents/@Id/log">All log entries and filters</a></p>
    </section>

    <section id="experience" class="card" aria-labelledby="experience-title">
        <h2 id="experience-title">Experience</h2>
        <p>@ExperienceMessages.AgentIntro</p>
        @if (_experience is null || _experience.Roles.Count == 0)
        {
            <p>@ExperienceMessages.NoStatistics</p>
        }
        else
        {
            <p class="hint">Computed @AgentMessages.Stamp(_experience.ComputedAt). <a href="/providers">Leaderboard</a>.</p>
            <div class="table-wrap">
                <table class="agents leaderboard">
                    <thead><tr><th scope="col">Role</th><th scope="col">Provider</th><th scope="col">Model</th><th scope="col">Timeframe</th><th scope="col">Market</th><MetricHeaders /></tr></thead>
                    <tbody>
                        @foreach (var row in _experience.Roles)
                        {
                            <tr class="@(row.IsCurrent ? "current-assignment" : "")">
                                <td>@CouncilRoles.Display(row.Role)</td>
                                <td><a href="/providers/@ProviderNames.Route(row.Provider)">@ProviderNames.Display(row.Provider)</a></td>
                                <td>@row.Model@(row.IsCurrent ? " (current)" : "")</td>
                                <td>@AgentMessages.Timeframe(row.Timeframe)</td>
                                <td>@AgentMessages.Market(row.MarketType)</td>
                                <MetricCells Metrics="row.Metrics" />
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <h3 id="trades-title">Closed trades</h3>
        @if (_experience is null || _experience.RecentTrades.Count == 0)
        {
            <p>@ExperienceMessages.NoTrades</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="agents leaderboard">
                    <thead><tr><th scope="col">Opened</th><th scope="col">Closed</th><th scope="col">Duration</th><th scope="col">Side</th><th scope="col">Entry</th><th scope="col">Exit</th><th scope="col">Size</th><th scope="col">R</th><th scope="col">P&amp;L</th><th scope="col">Fees</th><th scope="col">Funding</th><th scope="col">MAE</th><th scope="col">MFE</th><th scope="col">Exit</th><th scope="col">Decisions</th><th scope="col"></th></tr></thead>
                    <tbody>
                        @foreach (var trade in _experience.RecentTrades)
                        {
                            <tr>
                                <td>@AgentMessages.Stamp(trade.OpenedAt)</td>
                                <td>@AgentMessages.Stamp(trade.ClosedAt)</td>
                                <td>@ExperienceMessages.Duration(trade.Duration)</td>
                                <td>@trade.Side.ToString().ToLowerInvariant()@(trade.IsPaper ? " (paper)" : "")</td>
                                <td>@ExperienceMessages.Price(trade.EntryPrice)</td>
                                <td>@ExperienceMessages.Price(trade.ExitPrice)</td>
                                <td>@ExperienceMessages.Price(trade.Size)</td>
                                <td class="@ExperienceMessages.RClass(trade.RMultiple)">@ExperienceMessages.R(trade.RMultiple)</td>
                                <td class="@ExperienceMessages.RClass(trade.RealizedPnl)">@ExperienceMessages.Money(trade.RealizedPnl)</td>
                                <td>@ExperienceMessages.Money(trade.Fees)</td>
                                <td>@ExperienceMessages.Money(trade.Funding)</td>
                                <td>@ExperienceMessages.Percent(trade.MaxAdverseExcursion)</td>
                                <td>@ExperienceMessages.Percent(trade.MaxFavorableExcursion)</td>
                                <td>@ExperienceMessages.ExitReason(trade.ExitReason)</td>
                                <td>@(1 + trade.ManagingDecisions)</td>
                                <td><a href="/agents/@Id/evaluations/@trade.EntryEvaluationId">Entry deliberation</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card" aria-labelledby="history-title">
        <h2 id="history-title">Change history</h2>
        @if (agent.RecentChanges.Count == 0)
        {
            <p>No change recorded.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="agents data stack">
                    <thead><tr><th scope="col">When</th><th scope="col">Field</th><th scope="col">From</th><th scope="col">To</th></tr></thead>
                    <tbody>
                        @foreach (var change in agent.RecentChanges)
                        {
                            <tr>
                                <td data-label="When">@AgentMessages.Stamp(change.Timestamp)</td>
                                <td data-label="Field">@change.Field</td>
                                <td data-label="From"><code>@(change.OldValue ?? "")</code></td>
                                <td data-label="To"><code>@(change.NewValue ?? "")</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <RiskDisclaimerNotice />
}

@code {
    private AgentDetail? _agent;
    private StrategyDescriptor? _strategy;
    private string? _notice;
    private string? _actionError;
    private IReadOnlyList<CouncilAssignmentView> _deprecatedRoles = [];
    private AgentExperienceView? _experience;
    private LogPage? _log;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "stop-agent")]
    private StopFormInput StopInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "delete-agent")]
    private DeleteFormInput DeleteInput { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "status")]
    private string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "detail")]
    private string? Detail { get; set; }

    private Guid UserId => HttpContext.User.RequireUserId();

    private string Self => $"/agents/{Id}";

    protected override async Task OnInitializedAsync()
    {
        if (!await LoadAsync())
            return;

        StopInput ??= new();
        DeleteInput ??= new();
        _notice = AgentMessages.DetailNotice(Status, Detail);
    }

    private async Task<bool> LoadAsync()
    {
        _agent = await AgentService.GetAsync(UserId, Id, HttpContext.RequestAborted);
        if (_agent is null)
        {
            // Someone else's agent and a non-existent one look the same (NFR-SEC-03).
            Navigation.NotFound();
            return false;
        }

        _strategy = Catalog.Find(_agent.StrategyId, _agent.StrategyVersion) ?? Catalog.Find(_agent.StrategyId);
        _deprecatedRoles = _agent.Council.Where(c => c.Enabled && c.CatalogStatus == ModelStatus.Deprecated).ToList();
        _experience = await Experience.GetAgentAsync(UserId, Id, HttpContext.RequestAborted);
        _log = await Logs.QueryAsync(UserId, new LogQuery(Id, PageSize: 10), HttpContext.RequestAborted);
        return true;
    }

    private bool UpgradeAvailable => _agent is { LatestStrategyVersion: { } latest } agent && latest > agent.StrategyVersion;

    private async Task StartAsync() => await ActAsync(AgentService.StartAsync(UserId, Id, HttpContext.RequestAborted), "started");

    private async Task PauseAsync() => await ActAsync(AgentService.PauseAsync(UserId, Id, HttpContext.RequestAborted), "paused");

    private async Task ResumeAsync() => await ActAsync(AgentService.ResumeAsync(UserId, Id, HttpContext.RequestAborted), "resumed");

    private async Task StopAsync()
    {
        var result = await AgentService.StopAsync(UserId, Id, StopInput.Positions == "close", HttpContext.RequestAborted);
        if (result.Status == AgentActionStatus.Succeeded)
        {
            Navigation.NavigateTo(Self + "?status=stopped" + (result.Detail is null ? "" : "&detail=" + Uri.EscapeDataString(result.Detail)));
            return;
        }

        _actionError = AgentMessages.ForAction(result);
        await LoadAsync();
    }

    private async Task CloneAsync()
    {
        var result = await AgentService.CloneAsync(UserId, Id, HttpContext.RequestAborted);
        if (result.Status == AgentActionStatus.Succeeded)
        {
            Navigation.NavigateTo(WizardSteps.Href(result.AgentId!.Value, WizardStep.Basics) + "?status=cloned");
            return;
        }

        _actionError = AgentMessages.ForAction(result);
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        var result = await AgentService.DeleteAsync(UserId, Id, HttpContext.RequestAborted);
        if (result.Status is AgentActionStatus.Succeeded or AgentActionStatus.NotFound)
        {
            Navigation.NavigateTo("/agents?status=deleted");
            return;
        }

        _actionError = AgentMessages.ForAction(result);
        await LoadAsync();
    }

    private async Task ActAsync(Task<AgentActionResult> action, string status)
    {
        var result = await action;
        if (result.Status == AgentActionStatus.Succeeded)
        {
            Navigation.NavigateTo(Self + "?status=" + status);
            return;
        }

        _actionError = AgentMessages.ForAction(result);
        await LoadAsync();
    }

    private sealed class StopFormInput
    {
        public string Positions { get; set; } = "close";
    }

    private sealed class DeleteFormInput
    {
        [Range(typeof(bool), "true", "true", ErrorMessage = "Tick the box to confirm.")]
        public bool Confirm { get; set; }
    }
}
