@page "/agents"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Ecnanib.Database.Entities
@inject IAgentService AgentService
@inject NavigationManager Navigation

<PageTitle>Agents</PageTitle>

<h1>Agents</h1>
<p>Each agent trades one symbol on one market at one timeframe with one strategy and one council. Running and paused agents are evaluated server-side at every candle close, also while you are offline.</p>

@if (_notice is not null)
{
    <p class="notice" role="status">@_notice</p>
}
@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}

<p><a href="/agents/new">New agent…</a></p>

@if (_agents is null || _agents.Count == 0)
{
    <p>@AgentMessages.NoAgents</p>
}
else
{
    <div class="table-wrap">
        <table class="agents">
            <thead>
                <tr><th>Name</th><th>Market</th><th>Timeframe</th><th>Strategy</th><th>Mode</th><th>State</th><th>Last evaluation</th><th>Positions</th></tr>
            </thead>
            <tbody>
                @foreach (var agent in _agents)
                {
                    <tr>
                        <td><a href="/agents/@agent.Id">@agent.Name</a></td>
                        <td>@agent.Symbol <span class="muted">@AgentMessages.Market(agent.MarketType)</span></td>
                        <td>@AgentMessages.Timeframe(agent.Timeframe)</td>
                        <td>@agent.StrategyName</td>
                        <td>@AgentMessages.Mode(agent.Mode)</td>
                        <td>
                            <span class="status @AgentMessages.StateClass(agent.State)">@agent.State</span>
                            @if (agent.StateReason is not null)
                            {
                                <span class="muted">@agent.StateReason</span>
                            }
                            @if (agent.HasDeprecatedModel)
                            {
                                <a class="muted warning-text" href="/agents/@agent.Id#council">@AgentMessages.DeprecatedMark</a>
                            }
                        </td>
                        <td>
                            @if (agent.LastOutcome is { } outcome)
                            {
                                <text>@AgentMessages.Outcome(outcome)</text>
                                <span class="muted">@Stamp(agent.LastEvaluatedAt)</span>
                            }
                            else
                            {
                                <span class="muted">never</span>
                            }
                        </td>
                        <td>@agent.OpenPositions</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_agents.Any(a => AgentStateMachine.CanStop(a.State)))
    {
        <section aria-labelledby="stop-all-title">
            <h2 id="stop-all-title">Stop all my agents</h2>
            <p>@AgentMessages.StopAllHint</p>
            <EditForm Model="StopAll" FormName="stop-all" OnValidSubmit="StopAllAsync" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <label>
                    Open positions
                    <InputSelect @bind-Value="StopAll.Positions">
                        <option value="close">Close at market now</option>
                        <option value="leave">Leave them open, shown as unmanaged</option>
                    </InputSelect>
                </label>
                <label class="check">
                    <InputCheckbox @bind-Value="StopAll.Confirm" />
                    Stop every running, paused or failed agent and cancel their open orders.
                </label>
                <button type="submit" class="danger">Stop all my agents</button>
            </EditForm>
        </section>
    }
}

@code {
    private IReadOnlyList<AgentSummary>? _agents;
    private string? _notice;
    private string? _error;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "status")]
    private string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "detail")]
    private string? Detail { get; set; }

    [SupplyParameterFromForm(FormName = "stop-all")]
    private StopAllInput StopAll { get; set; } = default!;

    private Guid UserId => HttpContext.User.RequireUserId();

    protected override async Task OnInitializedAsync()
    {
        StopAll ??= new();
        _notice = Status switch
        {
            "deleted" => "The agent was deleted.",
            "stopped-all" => Detail ?? "Your agents were stopped.",
            _ => null,
        };
        _agents = await AgentService.ListAsync(UserId, HttpContext.RequestAborted);
    }

    /// <summary>FR-EXE-10: every agent that can be stopped is, orders cancelled and positions closed or left as chosen; the ones that could not be are listed.</summary>
    private async Task StopAllAsync()
    {
        var result = await AgentService.StopAllAsync(UserId, StopAll.Positions == "close", HttpContext.RequestAborted);
        if (result.Failed.Count == 0)
        {
            Navigation.NavigateTo("/agents?status=stopped-all&detail=" + Uri.EscapeDataString(AgentMessages.StoppedAll(result, StopAll.Positions == "close")));
            return;
        }

        _error = AgentMessages.StoppedAll(result, StopAll.Positions == "close");
        _agents = await AgentService.ListAsync(UserId, HttpContext.RequestAborted);
    }

    private sealed class StopAllInput
    {
        public string Positions { get; set; } = "close";

        [Range(typeof(bool), "true", "true", ErrorMessage = "Tick the box to confirm.")]
        public bool Confirm { get; set; }
    }

    private static string Stamp(DateTimeOffset? at) => at?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "never";
}
