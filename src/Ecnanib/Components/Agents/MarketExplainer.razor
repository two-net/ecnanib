@* FR-UI-02: going short, leverage, liquidation and funding in plain words, for someone deciding on Futures, and again
   beside the settings that limit them. *@

<section class="market-terms" aria-labelledby="@HeadingId">
    <h3 id="@HeadingId">@Strings.AgentWizardTermsHeading</h3>
    <dl class="market-terms-list">
        <dt>@Strings.AgentWizardTermShort</dt>
        <dd>@Strings.AgentWizardTermShortText</dd>
        <dt>@Strings.AgentWizardTermLeverage</dt>
        <dd>@Strings.AgentWizardTermLeverageText</dd>
        <dt>@Strings.AgentWizardTermLiquidation</dt>
        <dd>@Strings.AgentWizardTermLiquidationText</dd>
        <dt>@Strings.AgentWizardTermFunding</dt>
        <dd>@Strings.AgentWizardTermFundingText</dd>
    </dl>
</section>

@code {
    private const string HeadingId = "market-terms-heading";
}
