@using System.Globalization
@inject IAgents Agents

<li class="agent">
    <div class="agent-heading">
        @* The user chose the name. Razor encodes it, so it's only text. *@
        <h2 class="agent-name">@Agent.Settings.Name</h2>
        @if (Agent.IsDemo)
        {
            @* Demo in words, wherever a Demo agent appears (FR-UI-07). *@
            <span class="agent-tag">@Strings.AgentDemo</span>
        }
    </div>

    <dl class="facts">
        <dt>@Strings.AgentFieldStatus</dt>
        <dd>@AgentText.StatusOf(Agent.Status)</dd>
        <dt>@Strings.AgentFieldMarket</dt>
        <dd>@AgentText.MarketOf(Agent.Settings.Market)</dd>
        <dt>@Strings.AgentFieldPair</dt>
        <dd><code>@Agent.Settings.Symbol</code></dd>
        <dt>@Strings.AgentFieldTimeframe</dt>
        <dd>@AgentText.TimeframeOf(Agent.Settings.Timeframe)</dd>
        <dt>@Strings.AgentFieldExecutionMode</dt>
        <dd>@AgentText.ExecutionModeOf(Agent.Settings.ExecutionMode)</dd>
        <dt>@Strings.AgentFieldCapital</dt>
        <dd>@Capital</dd>
    </dl>

    @if (AgentText.ExplanationOf(Agent.StatusReason) is { } explanation)
    {
        <p class="agent-problem">@explanation</p>
    }

    <div class="agent-actions">
        @if (Agent.Status is AgentStatus.Draft or AgentStatus.Stopped or AgentStatus.Error or AgentStatus.Paused)
        {
            var resume = Agent.Status == AgentStatus.Paused;
            <button type="button" class="button" disabled="@_busy" aria-label="@Labelled(resume ? Strings.AgentResumeLabel : Strings.AgentActivateLabel)"
                    @onclick="ActivateAsync">
                @(resume ? Strings.AgentResume : Strings.AgentActivate)
            </button>
        }
        @if (Agent.Status == AgentStatus.Active)
        {
            <button type="button" class="button" disabled="@_busy" aria-label="@Labelled(Strings.AgentPauseLabel)" @onclick="PauseAsync">
                @Strings.AgentPause
            </button>
        }
        @if (Agent.Status != AgentStatus.Archived)
        {
            @* A plain link, because the settings page is static. *@
            <a href="@($"/agents/{Agent.Id}/settings")" aria-label="@Labelled(Strings.AgentSettingsLabel)">@Strings.AgentSettingsLink</a>
        }
        <button type="button" class="button" disabled="@_busy" aria-label="@Labelled(Strings.AgentCloneLabel)" @onclick="CloneAsync">
            @Strings.AgentClone
        </button>
        @foreach (var action in Confirmable)
        {
            if (_confirming != action)
            {
                <button type="button" class="button" disabled="@_busy" aria-label="@Labelled(LabelOf(action))"
                        @ref="_actionButtons[action]" @onclick="() => Confirm(action)">
                    @TextOf(action)
                </button>
            }
        }
    </div>

    @if (_confirming is { } pending)
    {
        <div class="agent-confirm">
            <p>@Labelled(ConfirmOf(pending))</p>
            <div class="agent-actions">
                <button type="button" class="button" disabled="@_busy" @ref="_confirm" @onclick="() => RunAsync(pending)">@SubmitOf(pending)</button>
                <button type="button" class="button" @onclick="Cancel">@Strings.AgentConfirmCancel</button>
            </div>
        </div>
    }

    @* Always there, so a screen reader announces the result when it appears. *@
    <div class="agent-result" role="status">
        @if (_message is not null)
        {
            <p>@_message</p>
        }
        @if (_problems.Count > 0)
        {
            <ul class="facts-list">
                @foreach (var problem in _problems)
                {
                    <li>@AgentText.ProblemOf(problem)</li>
                }
            </ul>
        }
        @if (_warnings.Count > 0)
        {
            <p>@Strings.AgentActivationWarnings</p>
            <ul class="facts-list">
                @foreach (var warning in _warnings)
                {
                    <li>@AgentText.WarningOf(warning)</li>
                }
            </ul>
        }
    </div>
</li>

@code {
    private string? _message;
    private IReadOnlyList<ActivationProblem> _problems = [];
    private IReadOnlyList<ActivationWarning> _warnings = [];
    private bool _busy;
    private Step? _confirming;
    private Step? _focusAction;
    private bool _focusConfirm;
    private ElementReference _confirm;
    private readonly Dictionary<Step, ElementReference> _actionButtons = [];

    [Parameter, EditorRequired]
    public AgentRecord Agent { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid UserId { get; set; }

    /// <summary>The agent as it is now, after a change of status, or when it changed meanwhile.</summary>
    [Parameter]
    public EventCallback<AgentRecord> OnChanged { get; set; }

    [Parameter]
    public EventCallback<AgentRecord> OnClone { get; set; }

    /// <summary>The agent was archived, or deleted when the flag is set. Either way, its card leaves this list.</summary>
    [Parameter]
    public EventCallback<(AgentRecord Agent, bool Deleted)> OnRemoved { get; set; }

    /// <summary>The changes that ask first, because they can't be taken back by the next click.</summary>
    private enum Step
    {
        Stop,
        Archive,
        Delete,
    }

    private IEnumerable<Step> Confirmable => Agent.Status switch
    {
        AgentStatus.Active => [Step.Stop],
        AgentStatus.Paused or AgentStatus.Error => [Step.Stop, Step.Archive],
        AgentStatus.Draft or AgentStatus.Stopped => [Step.Archive],
        AgentStatus.Archived => [Step.Delete],
        _ => [],
    };

    private string Capital => Agent.Settings.CapitalAllocation is { } capital
        ? string.Format(CultureInfo.CurrentCulture, Strings.AgentCapitalOf, capital, Agent.QuoteAsset)
        : Strings.AgentCapitalNone;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusConfirm)
        {
            _focusConfirm = false;
            await _confirm.FocusAsync();
        }
        else if (_focusAction is { } action)
        {
            _focusAction = null;

            if (_actionButtons.TryGetValue(action, out var button))
            {
                await button.FocusAsync();
            }
        }
    }

    private async Task ActivateAsync()
    {
        await BusyAsync(async () =>
        {
            var result = await Agents.ActivateAsync(UserId, Agent.Id, CancellationToken.None);

            _problems = result.Problems ?? [];
            _warnings = result.Warnings ?? [];
            _message = result.Outcome switch
            {
                ActivationOutcome.Activated => Strings.AgentActivated,
                ActivationOutcome.Refused => Strings.AgentActivateRefused,
                ActivationOutcome.NotAllowed => Strings.AgentNotAllowed,
                ActivationOutcome.Changed => Strings.AgentChanged,
                _ => Strings.AgentGone,
            };

            if (result.Agent is { } current)
            {
                await OnChanged.InvokeAsync(current);
            }
        });
    }

    private Task PauseAsync() => TransitionAsync(Agents.PauseAsync, Strings.AgentPausedNotice);

    private async Task CloneAsync() => await BusyAsync(() => OnClone.InvokeAsync(Agent));

    private void Confirm(Step action)
    {
        _confirming = action;
        _focusConfirm = true;
    }

    private void Cancel()
    {
        _focusAction = _confirming;
        _confirming = null;
    }

    private async Task RunAsync(Step action)
    {
        _confirming = null;

        switch (action)
        {
            case Step.Stop:
                await TransitionAsync(Agents.StopAsync, Strings.AgentStoppedNotice);
                break;
            case Step.Archive:
                await RemoveAsync(Agents.ArchiveAsync, deleted: false);
                break;
            case Step.Delete:
                await RemoveAsync(Agents.DeleteAsync, deleted: true);
                break;
        }
    }

    private async Task TransitionAsync(Func<Guid, Guid, CancellationToken, Task<TransitionResult>> transition, string done)
    {
        await BusyAsync(async () =>
        {
            var result = await transition(UserId, Agent.Id, CancellationToken.None);

            _problems = [];
            _warnings = [];
            _message = AgentText.TransitionErrorOf(result.Outcome) ?? done;

            if (result.Agent is { } current)
            {
                await OnChanged.InvokeAsync(current);
            }
        });
    }

    /// <summary>Once it's archived or deleted, the list moves or removes the card, and focus goes to its notice.</summary>
    private async Task RemoveAsync(Func<Guid, Guid, CancellationToken, Task<TransitionResult>> transition, bool deleted)
    {
        await BusyAsync(async () =>
        {
            var result = await transition(UserId, Agent.Id, CancellationToken.None);

            if (result.Outcome == TransitionOutcome.Done)
            {
                await OnRemoved.InvokeAsync((result.Agent ?? Agent, deleted));
                return;
            }

            _problems = [];
            _warnings = [];
            _message = AgentText.TransitionErrorOf(result.Outcome);

            if (result.Agent is { } current)
            {
                await OnChanged.InvokeAsync(current);
            }
        });
    }

    private async Task BusyAsync(Func<Task> work)
    {
        _busy = true;

        try
        {
            await work();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string TextOf(Step action) => action switch
    {
        Step.Stop => Strings.AgentStop,
        Step.Archive => Strings.AgentArchive,
        _ => Strings.AgentDelete,
    };

    private static string LabelOf(Step action) => action switch
    {
        Step.Stop => Strings.AgentStopLabel,
        Step.Archive => Strings.AgentArchiveLabel,
        _ => Strings.AgentDeleteLabel,
    };

    private static string ConfirmOf(Step action) => action switch
    {
        Step.Stop => Strings.AgentStopConfirm,
        Step.Archive => Strings.AgentArchiveConfirm,
        _ => Strings.AgentDeleteConfirm,
    };

    private static string SubmitOf(Step action) => action switch
    {
        Step.Stop => Strings.AgentStopSubmit,
        Step.Archive => Strings.AgentArchiveSubmit,
        _ => Strings.AgentDeleteSubmit,
    };

    private string Labelled(string format) => string.Format(CultureInfo.CurrentCulture, format, Agent.Settings.Name);
}
