@* The wizard's steps (FR-UI-01): earlier steps link back, the current one is marked, the others are plain text until the draft exists. *@
<ol class="stepper" aria-label="Setup steps">
    @foreach (var step in WizardSteps.Ordered)
    {
        <li class="@(step < Current ? "done" : null)" aria-current="@(step == Current ? "step" : null)">
            @if (AgentId is { } id && step != Current)
            {
                <a href="@WizardSteps.Href(id, step)">@WizardSteps.Title(step)</a>
            }
            else
            {
                <span>@WizardSteps.Title(step)</span>
            }
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired]
    public WizardStep Current { get; set; }

    /// <summary>Null while the agent does not exist yet (the create form is step one).</summary>
    [Parameter]
    public Guid? AgentId { get; set; }
}
