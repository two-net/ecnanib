@using System.Globalization

@* A Confirm agent's approval of the cycle's order (FR-APR-01): how it went, who decided and when, the Risk Engine's second
   look in full (FR-APR-03), and what execution did with it. *@

<dl class="facts">
    <dt>@Strings.ApprovalFieldStatus</dt>
    <dd>@ApprovalText.StatusOf(Record.Status)</dd>
    <dt>@Strings.TraceFieldResult</dt>
    <dd>@ApprovalText.OutcomeOf(Record)</dd>
    <dt>@Strings.ApprovalFieldProposed</dt>
    <dd>@Time.Format(Record.CreatedAt)</dd>
    @if (Record.IsPending)
    {
        <dt>@Strings.ApprovalFieldExpires</dt>
        <dd>@Time.Format(Record.ExpiresAt)</dd>
    }
    else if (Record.DecidedAt is { } decided)
    {
        <dt>@Strings.ApprovalFieldDecided</dt>
        <dd>@string.Format(CultureInfo.CurrentCulture, Strings.TraceDecidedOf, Record.DecidedByUser ? Strings.TraceDecidedByYou : Strings.TraceDecidedBySystem, Time.Format(decided))</dd>
    }
</dl>
<p><a href="@($"/approvals/{Record.Id}")">@Strings.TraceApprovalLink</a></p>

<div class="trace-group">
    <h3>@Strings.TraceSecondLookHeading</h3>
    @if (Approval.RevalidationRules.Count == 0)
    {
        <p>@Strings.TraceSecondLookNone</p>
    }
    else
    {
        <TraceRules Rules="Approval.RevalidationRules" Label="@Strings.TraceSecondLookRulesLabel" />
    }
</div>

@if (Record.Execution is { } execution)
{
    <div class="trace-group">
        <h3>@Strings.TraceApprovalExecutionHeading</h3>
        <TraceExecution Result="execution" />
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ApprovalTrace Approval { get; set; } = default!;

    [CascadingParameter]
    private DisplayTime Time { get; set; } = DisplayTime.Utc;

    private ApprovalRecord Record => Approval.Record;
}
