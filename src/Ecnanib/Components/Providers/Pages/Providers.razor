@page "/providers"
@attribute [Authorize]
@using Ecnanib.Ai.Abstractions
@using Ecnanib.Database.Entities
@using Ecnanib.Experience.Abstractions
@using Ecnanib.ModelSync.Abstractions
@inject IModelCatalog ModelCatalog
@inject IModelSyncService ModelSync
@inject IKeyService Keys
@inject IExperienceReader Experience
@inject NavigationManager Navigation

<PageTitle>Providers</PageTitle>

<h1>Providers</h1>
<p>@ProviderMessages.Intro</p>

@if (_notice is not null)
{
    <p class="@(_noticeIsError ? "error" : "notice")" role="@(_noticeIsError ? "alert" : "status")">@_notice</p>
}

<section class="card" aria-labelledby="sync-title">
    <h2 id="sync-title">Sync status</h2>
    @if (_syncError is not null)
    {
        <p class="error" role="alert">@_syncError</p>
    }
    <form method="post" @formname="sync-provider" @onsubmit="SyncAsync" class="inline">
        <AntiforgeryToken />
        <div class="table-wrap">
            <table class="data stack keys">
                <thead>
                    <tr><th scope="col">Provider</th><th scope="col">Last sync</th><th scope="col">Result</th><th scope="col">Trigger</th><th scope="col">Models</th><th scope="col">Deprecated</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var state in _states)
                    {
                        <tr>
                            <td data-label="Provider">@ProviderNames.Display(state.Provider)</td>
                            <td data-label="Last sync">@Stamp(state.LastSyncAt)</td>
                            <td data-label="Result">
                                <span class="status @ProviderMessages.StatusClass(state.LastStatus)">@state.LastStatus</span>
                                @if (state.LastStatus == SyncStatus.Failed && state.LastError is not null)
                                {
                                    <span class="muted">@state.LastError</span>
                                }
                            </td>
                            <td data-label="Trigger">@ProviderMessages.Trigger(state.Trigger)</td>
                            <td data-label="Models">@state.ModelCount</td>
                            <td data-label="Deprecated">@state.Deprecated</td>
                            <td>
                                @if (_ownValidKeys.Contains(state.Provider))
                                {
                                    <button type="submit" name="provider" value="@ProviderNames.Route(state.Provider)">Sync now</button>
                                }
                                else
                                {
                                    <a href="/keys/providers/@ProviderNames.Route(state.Provider)">@ProviderMessages.AddYourKey</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
    <p class="hint">@ProviderMessages.SyncHint</p>
</section>

<section class="card" aria-labelledby="leaderboard-title">
    <h2 id="leaderboard-title">Leaderboard</h2>
    <p>@ExperienceMessages.LeaderboardIntro</p>
    <FilterForm Filter="_filter" Action="/providers" />
    <p class="hint">Showing @ExperienceFilters.Describe(_filter). @(_leaderboard?.ComputedAt is { } computed ? $"Computed {Stamp(computed)}." : ExperienceMessages.NoStatistics)</p>
    <h3 id="leaderboard-mine-title">Your agents</h3>
    @if (_leaderboard is null || _leaderboard.Mine.Count == 0)
    {
        <p>@ExperienceMessages.NoRows</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data agents leaderboard">
                <thead><tr><th scope="col">#</th><th scope="col">Provider</th><th scope="col">Model</th><MetricHeaders /></tr></thead>
                <tbody>
                    @foreach (var (row, rank) in _leaderboard.Mine.Select((r, i) => (r, i + 1)))
                    {
                        <tr>
                            <td>@rank</td>
                            <td><a href="@DetailLink(row.Provider)">@ProviderNames.Display(row.Provider)</a></td>
                            <td>@row.Model</td>
                            <MetricCells Metrics="row.Metrics" />
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <h3 id="leaderboard-all-title">All users</h3>
    @if (_leaderboard is null || _leaderboard.SystemWide.Count == 0)
    {
        <p>@ExperienceMessages.NoRows</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data agents leaderboard">
                <thead><tr><th scope="col">#</th><th scope="col">Provider</th><th scope="col">Model</th><MetricHeaders /></tr></thead>
                <tbody>
                    @foreach (var (row, rank) in _leaderboard.SystemWide.Select((r, i) => (r, i + 1)))
                    {
                        <tr>
                            <td>@rank</td>
                            <td><a href="@DetailLink(row.Provider)">@ProviderNames.Display(row.Provider)</a></td>
                            <td>@row.Model</td>
                            <MetricCells Metrics="row.Metrics" />
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card" aria-labelledby="catalog-title">
    <h2 id="catalog-title">Catalog</h2>
    @foreach (var state in _states)
    {
        var models = _catalog.Where(m => m.Provider == state.Provider).ToList();
        <details class="catalog">
            <summary>@ProviderNames.Display(state.Provider): @ProviderMessages.Plural(state.Available, "available model", "available models"), @state.Deprecated deprecated</summary>
            @if (models.Count == 0)
            {
                <p class="hint">@ProviderMessages.NoModels(state.Provider)</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data stack keys">
                        <thead><tr><th scope="col">Model</th><th scope="col">Status</th><th scope="col">First seen</th><th scope="col">Last seen</th></tr></thead>
                        <tbody>
                            @foreach (var model in models)
                            {
                                <tr>
                                    <td data-label="Model">
                                        @model.DisplayName
                                        @if (model.DisplayName != model.ModelId)
                                        {
                                            <code class="muted">@model.ModelId</code>
                                        }
                                    </td>
                                    <td data-label="Status"><span class="status @ProviderMessages.StatusClass(model.Status)">@model.Status</span></td>
                                    <td data-label="First seen">@Stamp(model.FirstSeenAt)</td>
                                    <td data-label="Last seen">@Stamp(model.LastSeenAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </details>
    }
</section>

<p><a href="/keys">Keys</a> · <a href="/agents">Agents</a></p>

@code {
    private IReadOnlyList<ProviderSyncView> _states = [];
    private IReadOnlyList<CatalogModel> _catalog = [];
    private IReadOnlySet<AiProvider> _ownValidKeys = new HashSet<AiProvider>();
    private LeaderboardView? _leaderboard;
    private ExperienceFilter _filter = ExperienceFilter.None;
    private string? _notice;
    private bool _noticeIsError;
    private string? _syncError;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>The route name carried by the Sync now button that was clicked (only the activated submit button is posted).</summary>
    [SupplyParameterFromForm(FormName = "sync-provider", Name = "provider")]
    private string? SyncProvider { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    private string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "provider")]
    private string? Provider { get; set; }

    // Bound as text: a hand-edited value must not turn the page into an error.
    [SupplyParameterFromQuery(Name = "models")]
    private string? Models { get; set; }

    [SupplyParameterFromQuery(Name = "deprecated")]
    private string? Deprecated { get; set; }

    [SupplyParameterFromQuery(Name = ExperienceFilters.RoleName)]
    private string? Role { get; set; }

    [SupplyParameterFromQuery(Name = ExperienceFilters.TimeframeName)]
    private string? Timeframe { get; set; }

    [SupplyParameterFromQuery(Name = ExperienceFilters.MarketName)]
    private string? Market { get; set; }

    private Guid UserId => HttpContext.User.RequireUserId();

    protected override async Task OnInitializedAsync()
    {
        _states = await ModelCatalog.GetSyncStatesAsync(HttpContext.RequestAborted);
        _catalog = await ModelCatalog.ListAsync(HttpContext.RequestAborted);
        // NFR-SEC-03: a manual sync spends the user's own key only, so the button exists only where they have a valid one.
        _ownValidKeys = await Keys.ValidProvidersAsync(UserId, HttpContext.RequestAborted);
        _filter = ExperienceFilters.Parse(Role, Timeframe, Market);
        _leaderboard = await Experience.GetLeaderboardAsync(UserId, _filter, HttpContext.RequestAborted);
        (_notice, _noticeIsError) = (Status, ProviderNames.Parse(Provider)) switch
        {
            ("synced", { } p) => (ProviderMessages.Synced(p, Count(Models), Count(Deprecated)), false),
            ("nokey", { } p) => (ProviderMessages.NoKey(p), true),
            ("failed", { } p) => (ProviderMessages.Failed(p, _states.FirstOrDefault(s => s.Provider == p)?.LastError), true),
            _ => (null, false),
        };
    }

    private async Task SyncAsync()
    {
        if (ProviderNames.Parse(SyncProvider) is not { } provider)
        {
            _syncError = ProviderMessages.ChooseProvider;
            return;
        }

        var outcome = await ModelSync.SyncNowAsync(provider, UserId, HttpContext.RequestAborted);
        var route = ProviderNames.Route(provider);
        // The leaderboard filter travels with the notice, so a sync does not reset it.
        var filter = ExperienceFilters.Query(ExperienceFilters.Parse(Role, Timeframe, Market));
        var suffix = filter.Length == 0 ? "" : "&" + filter;
        Navigation.NavigateTo(outcome.Status switch
        {
            ModelSyncStatus.Synced => $"/providers?status=synced&provider={route}&models={outcome.Result?.Listed ?? 0}&deprecated={outcome.Result?.Deprecated ?? 0}{suffix}",
            ModelSyncStatus.NoValidKey => $"/providers?status=nokey&provider={route}{suffix}",
            _ => $"/providers?status=failed&provider={route}{suffix}",
        });
    }

    private string DetailLink(AiProvider provider)
    {
        var query = ExperienceFilters.Query(_filter);
        return "/providers/" + ProviderNames.Route(provider) + (query.Length == 0 ? "" : "?" + query);
    }

    private static int Count(string? value) => int.TryParse(value, out var count) && count >= 0 ? count : 0;

    private static string Stamp(DateTimeOffset? at) => at?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "never";
}
