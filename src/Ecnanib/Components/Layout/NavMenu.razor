@* Add a link here when its page lands. Only link to pages that exist. wwwroot/shell.js closes the menu. *@

<button type="button" class="nav-toggle" popovertarget="site-nav">@Strings.NavMenu</button>

<nav id="site-nav" class="nav" popover aria-label="@Strings.NavLabel">
    <a href="/#how-it-works">@Strings.NavHowItWorks</a>
    <a href="/#notices">@Strings.NavRisks</a>
    @* Not the default policy, which would hide sign-out from someone with a document to accept. *@
    <AuthorizeView Policy="@AccountPolicies.SignedIn">
        <Authorized>
            @if (AccountClaims.UserId(context.User) is { } userId)
            {
                <UnreadCount UserId="userId" />
            }
            <a href="/dashboard">@Strings.NavDashboard</a>
            <a href="/agents">@Strings.NavAgents</a>
            <a href="/approvals">@Strings.NavApprovals</a>
            <a href="/catalog">@Strings.NavCatalog</a>
            <a href="/credentials">@Strings.NavCredentials</a>
            <a href="/account">@Strings.NavAccount</a>
            @* A plain post, because a circuit can't clear a cookie. *@
            <form method="post" action="/sign-out" class="nav-form">
                <AntiforgeryToken />
                <button type="submit" class="nav-action">@Strings.NavSignOut</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <a href="/sign-in">@Strings.NavSignIn</a>
            <a href="/register">@Strings.NavRegister</a>
        </NotAuthorized>
    </AuthorizeView>
</nav>
