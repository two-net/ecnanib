@inherits LayoutComponentBase

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
    <a class="brand" href="/">Ecnanib</a>
    <AuthorizeView>
        <Authorized>
            <nav class="primary" aria-label="Primary">
                <NavLink href="/agents" Match="NavLinkMatch.Prefix">Dashboard</NavLink>
                <NavLink href="/keys" Match="NavLinkMatch.Prefix">Keys</NavLink>
                <NavLink href="/providers" Match="NavLinkMatch.Prefix">Providers</NavLink>
                <NavLink href="/status" Match="NavLinkMatch.All">Status</NavLink>
                <NavLink href="/settings" Match="NavLinkMatch.Prefix">Settings</NavLink>
            </nav>
            <details class="user-menu">
                <summary><span class="user">@context.User.Identity?.Name</span></summary>
                <div class="menu">
                    <a href="/settings">Settings</a>
                    <form method="post" action="/sign-out" class="inline">
                        <AntiforgeryToken />
                        <button type="submit" title="Ends your session on every device">Sign out</button>
                    </form>
                </div>
            </details>
        </Authorized>
        <NotAuthorized>
            <nav class="primary" aria-label="Primary">
                <NavLink href="/sign-in">Sign in</NavLink>
                <a class="button primary" href="/sign-up">Sign up</a>
            </nav>
        </NotAuthorized>
    </AuthorizeView>
</header>

<main id="main">
    @Body
</main>

@* NFR-LEGAL-01 "prominently": the one-sentence summary on every page, linking to the full text on the landing page. *@
<footer class="site-footer">
    <p>@RiskDisclaimer.Summary <a href="/#risk-disclaimer-title">Risk disclaimer</a></p>
</footer>

@* blazor.web.js shows this bar and wires .reload and .dismiss; the bar is an alert and the dismiss a named button (NFR-USE-01). *@
<div id="blazor-error-ui" role="alert" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">🗙</button>
</div>
