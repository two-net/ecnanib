@page "/status"
@attribute [Authorize]
@using Ecnanib.Agents.Abstractions
@using Ecnanib.Configuration
@using Ecnanib.Database
@using Ecnanib.Database.Entities
@using Ecnanib.Exchange.Abstractions
@using Ecnanib.Health.Abstractions
@using Microsoft.Extensions.Options
@inject ISystemHealth Health
@inject TimeProvider Clock
@inject IOptions<ServerOptions> Server

<PageTitle>System status</PageTitle>
@* Reloading is the reader's choice (WCAG 2.2.1): the page sits still until "Reload every minute" is followed, and that
   link's opposite stops it. *@
@if (_reload)
{
    <HeadContent>
        <meta http-equiv="refresh" content="@($"60;url={ReloadHref}")" />
    </HeadContent>
}

<div class="page-head">
    <div>
        <h1>System status</h1>
        <p class="hint">@HealthMessages.Intro</p>
    </div>
    @if (_report is { } head)
    {
        <p class="overall"><span class="status @HealthMessages.StateClass(head.Overall)">@HealthMessages.Describe(head.Overall)</span> <span class="muted">as of @HealthMessages.Stamp(head.At)</span></p>
    }
</div>

@if (_report is { } report)
{
    <section class="card" aria-labelledby="database-title">
        <h2 id="database-title">Database @Badge(SystemHealthStates.Worst(report.States.Database, report.States.InstanceLock))</h2>
        <dl class="details">
            <dt>Connectivity</dt>
            <dd><span class="status @HealthMessages.StateClass(report.Database.State)">@HealthMessages.Describe(report.Database.State)</span> @if (report.Database.Error is not null) { <span class="muted">@report.Database.Error</span> }</dd>
            <dt>Latency</dt>
            <dd>@HealthMessages.Latency(report.Database.Latency)</dd>
            <dt>Instance lock</dt>
            <dd><span class="status @HealthMessages.InstanceLockClass(report.InstanceLock.State)">@HealthMessages.InstanceLock(report.InstanceLock, report.At)</span></dd>
        </dl>
    </section>

    <section class="card" aria-labelledby="transport-title">
        <h2 id="transport-title">Transport</h2>
        <dl class="details">
            <dt>Public origin</dt>
            <dd>@HealthMessages.PublicOrigin(Server.Value)</dd>
            <dt>This request</dt>
            <dd>@HealthMessages.RequestTransport(HttpContext.Request.IsHttps, HttpContext.Connection.RemoteIpAddress)</dd>
            <dt>Trusted proxies</dt>
            <dd>@HealthMessages.TrustedProxies(Server.Value)</dd>
        </dl>
    </section>

    <section class="card" aria-labelledby="scheduler-title">
        <h2 id="scheduler-title">Agent scheduler @Badge(report.States.Scheduler)</h2>
        <dl class="details">
            <dt>Phase</dt>
            <dd><span class="status @HealthMessages.PhaseClass(report.Scheduler.Phase)">@HealthMessages.Phase(report.Scheduler.Phase)</span></dd>
            <dt>Started</dt>
            <dd>@HealthMessages.Stamp(report.Scheduler.StartedAt)</dd>
            <dt>Last minute tick</dt>
            <dd>@HealthMessages.Age(report.Scheduler.LastTickAt, report.At)</dd>
            <dt>Tracked agents</dt>
            <dd>@report.Scheduler.TrackedAgents</dd>
            <dt>Evaluations</dt>
            <dd>@report.Scheduler.InFlightEvaluations in flight of @report.Scheduler.MaxConcurrentEvaluations at most, @report.Scheduler.QueuedEvaluations queued</dd>
            <dt>Deadline misses</dt>
            <dd>@HealthMessages.DeadlineMisses(report.Scheduler.DeadlineMisses, report.Scheduler.LastDeadlineMissAt, report.At)</dd>
            <dt>Interrupted at start</dt>
            <dd>@HealthMessages.InterruptedAtStart(report.Scheduler.InterruptedAtStart)</dd>
            @if (report.Scheduler.LastError is not null)
            {
                <dt>Last error</dt>
                <dd><span class="error">@report.Scheduler.LastError</span> <span class="muted">@HealthMessages.Age(report.Scheduler.LastErrorAt, report.At)</span></dd>
            }
        </dl>
    </section>

    <section class="card" aria-labelledby="reconciliation-title">
        <h2 id="reconciliation-title">Exchange reconciliation @Badge(report.States.Reconciliation)</h2>
        @if (!report.Reconciliation.Available)
        {
            <p>@HealthMessages.ReconciliationUnavailable</p>
        }
        else
        {
            <dl class="details">
                <dt>Last round</dt>
                <dd>@HealthMessages.LastRound(report.Reconciliation, report.At)</dd>
                <dt>Restart checks</dt>
                <dd>@HealthMessages.RestartChecks(report.Reconciliation)</dd>
                <dt>Adoptions</dt>
                <dd>@HealthMessages.Adoptions(report.Reconciliation, report.At)</dd>
                @if (report.Reconciliation.LastError is not null)
                {
                    <dt>Last error</dt>
                    <dd><span class="error">@report.Reconciliation.LastError</span> <span class="muted">@HealthMessages.Age(report.Reconciliation.LastErrorAt, report.At)</span></dd>
                }
            </dl>
        }
    </section>

    <section class="card" aria-labelledby="streams-title">
        <h2 id="streams-title">Market streams @Badge(report.States.MarketStreams)</h2>
        <p class="hint">@HealthMessages.Streams(report.MarketStreams)</p>
        @if (report.MarketStreams.Count > 0)
        {
            <p class="hint">@HealthMessages.MarketStreamsNote</p>
            <div class="table-wrap">
                <table class="agents data stack" aria-labelledby="streams-title">
                    <thead><tr><th scope="col">Streams</th><th scope="col">Open</th><th scope="col">Health</th><th scope="col">Last message</th><th scope="col">Since</th><th scope="col">Last error</th></tr></thead>
                    <tbody>
                        @foreach (var group in HealthMessages.GroupStreams(report.MarketStreams))
                        {
                            <tr>
                                <td data-label="Streams"><code>@group.Name</code></td>
                                <td data-label="Open">@group.Count</td>
                                <td data-label="Health"><span class="status @HealthMessages.StreamClass(group.Worst)">@HealthMessages.Stream(group.Worst)</span></td>
                                <td data-label="Last message">@HealthMessages.Age(group.LastMessageAt, report.At)</td>
                                <td data-label="Since">@HealthMessages.Stamp(group.Since)</td>
                                <td data-label="Last error">@group.LastError</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <h3>Account streams @Badge(report.States.UserDataStreams)</h3>
        <p class="hint">@HealthMessages.UserDataNote</p>
        <p>@HealthMessages.Streams(report.UserDataStreams)@(report.UserDataStreams.Select(s => s.LastError).LastOrDefault(e => e is not null) is { } error ? $". Last error: {error}" : "")</p>
    </section>

    <section class="card" aria-labelledby="sync-title">
        <h2 id="sync-title">Model catalog sync @Badge(report.States.ModelSync)</h2>
        <dl class="details">
            <dt>Scheduled sync</dt>
            <dd>@HealthMessages.ModelSyncJob(report.ModelSyncJob, report.At)</dd>
        </dl>
        @if (report.ModelSyncError is not null)
        {
            <p class="error" role="alert">The sync states could not be read: @report.ModelSyncError</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="agents data stack" aria-labelledby="sync-title">
                    <thead><tr><th scope="col">Provider</th><th scope="col">Last sync</th><th scope="col">Result</th><th scope="col">Trigger</th><th scope="col">Models</th><th scope="col">Deprecated</th></tr></thead>
                    <tbody>
                        @foreach (var state in report.ModelSync)
                        {
                            <tr>
                                <td data-label="Provider">@ProviderNames.Display(state.Provider)</td>
                                <td data-label="Last sync">@HealthMessages.Stamp(state.LastSyncAt)</td>
                                <td data-label="Result">
                                    <span class="status @ProviderMessages.StatusClass(state.LastStatus)">@state.LastStatus</span>
                                    @if (state.LastStatus == SyncStatus.Failed && state.LastError is not null)
                                    {
                                        <span class="muted">@state.LastError</span>
                                    }
                                </td>
                                <td data-label="Trigger">@ProviderMessages.Trigger(state.Trigger)</td>
                                <td data-label="Models">@state.ModelCount</td>
                                <td data-label="Deprecated">@state.Deprecated</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <p class="hint"><a href="/providers">Sync a provider on the providers page</a>.</p>
    </section>

    <section class="card" aria-labelledby="limits-title">
        <h2 id="limits-title">Exchange rate limits @Badge(report.States.RateLimits)</h2>
        @if (report.RateLimits.Usages.Count == 0)
        {
            <p>No request weight has been used yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="agents data stack" aria-labelledby="limits-title">
                    <thead><tr><th scope="col">Limit</th><th scope="col">Used</th><th scope="col">Window</th></tr></thead>
                    <tbody>
                        @foreach (var usage in report.RateLimits.Usages)
                        {
                            <tr>
                                <td data-label="Limit">@usage.Limit</td>
                                <td data-label="Used">@usage.Current of @usage.Max</td>
                                <td data-label="Window">@usage.Window</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (report.RateLimits.LastTriggeredAt is { } triggered)
        {
            <p class="@(report.RateLimits.RetryAfterUntil > report.At ? "warning" : "hint")">A rate limit was hit @HealthMessages.Age(triggered, report.At)@(report.RateLimits.RetryAfterUntil is { } until && until > report.At ? $"; requests wait until {HealthMessages.Stamp(until)}" : "").</p>
        }
    </section>

    <p class="hint">@(_reload ? HealthMessages.ReloadingHint : HealthMessages.ReloadHint) <a href="@(_reload ? ReloadHref : Self)">Refresh now</a>. <a href="@(_reload ? Self : ReloadHref)">@(_reload ? HealthMessages.StopReloading : HealthMessages.StartReloading)</a></p>
}

@code {
    private const string Self = "/status";

    private const string ReloadHref = "/status?reload=1";

    private SystemHealthReport? _report;

    /// <summary>The part's own state beside its heading, so the card that degrades the whole is found at a glance and its accessible name says so.</summary>
    private static RenderFragment Badge(HealthState state) => @<span class="status @HealthMessages.StateClass(state)">@HealthMessages.Describe(state)</span>;
    private bool _reload;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Bound as text: a hand-edited value must not turn the page into an error.
    [SupplyParameterFromQuery(Name = "reload")]
    private string? Reload { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _reload = Reload == "1";
        _report = await Health.GetAsync(HttpContext.RequestAborted);
    }
}
