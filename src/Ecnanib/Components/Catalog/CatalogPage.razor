@page "/catalog"
@using System.Globalization
@inject ICatalog Catalog
@inject ICatalogSync CatalogSync
@inject ICredentials Credentials

@* Interactive, for the sync button, which ICatalogSync limits. The filters are a plain GET form, with no
   data-enhance, so they work without a script and a filtered page can be bookmarked (FR-CAT-07). Hidden
   models aren't listed: administrators withdrew them from offer (FR-CAT-05). See The pages in
   docs/architecture.md. *@

<PageTitle>@Strings.CatalogPageTitle</PageTitle>

<div class="page catalog-page">
    <h1>@Strings.CatalogHeading</h1>
    <p>@Strings.CatalogIntro</p>

    @* Always there, so a screen reader announces a notice when it appears. *@
    <p class="form-notice" role="status" hidden="@(_message is null)">@_message</p>

    <form method="get" action="/catalog" class="catalog-filters" aria-label="@Strings.CatalogFiltersLabel">
        <div class="field">
            <label for="catalog-provider">@Strings.CatalogFilterProvider</label>
            <select id="catalog-provider" name="provider">
                <option value="" selected="@(ProviderFilter is null)">@Strings.CatalogFilterAny</option>
                @foreach (var provider in Catalog.Providers)
                {
                    <option value="@provider" selected="@(provider == ProviderFilter)">@CatalogText.ProviderOf(provider)</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="catalog-capability">@Strings.CatalogFilterCapability</label>
            <select id="catalog-capability" name="capability" aria-describedby="catalog-capability-hint">
                <option value="" selected="@(CapabilityFilter is null)">@Strings.CatalogFilterAny</option>
                @foreach (var capability in Enum.GetValues<ModelCapability>())
                {
                    <option value="@capability" selected="@(capability == CapabilityFilter)">@CatalogText.CapabilityOf(capability)</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="catalog-status">@Strings.CatalogFilterStatus</label>
            <select id="catalog-status" name="status">
                <option value="" selected="@(StatusFilter is null)">@Strings.CatalogFilterAny</option>
                @foreach (var status in Statuses)
                {
                    <option value="@status" selected="@(status == StatusFilter)">@CatalogText.StatusOf(status)</option>
                }
            </select>
        </div>
        <div class="catalog-filter-actions">
            <button type="submit" class="button">@Strings.CatalogFilterApply</button>
            <a href="/catalog">@Strings.CatalogFilterClear</a>
        </div>
        <p id="catalog-capability-hint" class="field-hint catalog-filter-hint">@Strings.CatalogFilterCapabilityHint</p>
    </form>

    <div class="catalog-actions">
        <p class="catalog-count">@string.Format(CultureInfo.CurrentCulture, Strings.CatalogCount, Shown.Count, Offered.Count)</p>
        @if (_keyLabels.Count > 0)
        {
            @* On the circuit, which ICatalogSync limits, because hub traffic never reaches the limiter. *@
            <button type="button" class="button" disabled="@_syncing" @onclick="SyncAsync">
                @(_syncing ? Strings.CredentialsSyncingModels : Strings.CredentialsSyncModels)
            </button>
        }
    </div>

    @if (_models is null)
    {
        @* Not read yet, or not signed in. *@
    }
    else if (Offered.Count == 0)
    {
        <p>@Strings.CatalogEmpty <a href="/credentials">@Strings.CatalogEmptyLink</a></p>
    }
    else if (Shown.Count == 0)
    {
        <p>@Strings.CatalogNoMatch</p>
    }
    else
    {
        @* Its own scroll, so a phone scrolls the table rather than the page. Focusable, so a keyboard can too. *@
        <div class="catalog-table" role="region" tabindex="0" aria-label="@Strings.CatalogTableLabel">
            <table>
                <thead>
                    <tr>
                        <th scope="col">@Strings.CatalogColumnModel</th>
                        <th scope="col">@Strings.CatalogColumnProvider</th>
                        <th scope="col">@Strings.CatalogColumnCapabilities</th>
                        <th scope="col">@Strings.CatalogColumnTokens</th>
                        <th scope="col">@Strings.CatalogColumnPrice</th>
                        <th scope="col">@Strings.CatalogColumnStatus</th>
                        <th scope="col">@Strings.CatalogColumnKeys</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var model in Shown)
                    {
                        <CatalogModelRow @key="(model.Provider, model.ModelId)" Model="model">
                            <td>
                                @if (KeysOf(model) is { Count: > 0 } keys)
                                {
                                    @* The user chose the labels. Razor encodes them, so they're only text. *@
                                    <ul class="catalog-list">
                                        @foreach (var key in keys)
                                        {
                                            <li>@key</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="catalog-muted">@Strings.CatalogNoKeys</span>
                                }
                            </td>
                        </CatalogModelRow>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    /// <summary>The statuses a user can filter by. Hidden models aren't offered, so Hidden isn't one.</summary>
    private static readonly ModelStatus[] Statuses = [ModelStatus.Active, ModelStatus.Deprecated, ModelStatus.Retired];

    private IReadOnlyList<CatalogModel>? _models;
    private Dictionary<Guid, string> _keyLabels = [];
    private ILookup<(string Provider, string ModelId), string>? _access;
    private Guid _userId;
    private string? _message;
    private bool _syncing;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    /// <summary>Strings, because anyone can write this query, and only the names below mean anything.</summary>
    [SupplyParameterFromQuery(Name = "provider")]
    private string? Provider { get; set; }

    [SupplyParameterFromQuery(Name = "capability")]
    private string? Capability { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    private string? Status { get; set; }

    private string? ProviderFilter => Catalog.Providers.FirstOrDefault(provider => provider == Provider);

    private ModelCapability? CapabilityFilter =>
        Enum.GetValues<ModelCapability>().Cast<ModelCapability?>().FirstOrDefault(value => value.ToString() == Capability);

    private ModelStatus? StatusFilter => Statuses.Cast<ModelStatus?>().FirstOrDefault(value => value.ToString() == Status);

    private IReadOnlyList<CatalogModel> Offered => [.. (_models ?? []).Where(model => !model.Hidden)];

    /// <summary>By provider, then name. A capability matches only when it's known to be there.</summary>
    private IReadOnlyList<CatalogModel> Shown =>
    [
        .. Offered
            .Where(model => ProviderFilter is null || model.Provider == ProviderFilter)
            .Where(model => CapabilityFilter is not { } capability || model.Capabilities.Of(capability) == true)
            .Where(model => StatusFilter is not { } status || model.Status == status)
            .OrderBy(model => model.Provider, StringComparer.Ordinal)
            .ThenBy(model => model.DisplayName, StringComparer.CurrentCulture)
            .ThenBy(model => model.ModelId, StringComparer.Ordinal),
    ];

    protected override async Task OnInitializedAsync()
    {
        if (AccountClaims.UserId((await AuthenticationState).User) is not { } userId)
        {
            return;
        }

        _userId = userId;
        await LoadAsync();
    }

    /// <summary>
    /// The catalog, and which of the user's keys can use each model: a valid AI key whose last sync found it
    /// (FR-CAT-02). Validity comes from Credentials, as role assignments read it.
    /// </summary>
    private async Task LoadAsync()
    {
        var keys = await Credentials.ListAsync(_userId, CancellationToken.None);
        _keyLabels = keys
            .Where(key => key is { Kind: CredentialKind.Ai, Status: CredentialStatus.Valid })
            .ToDictionary(key => key.Id, key => key.Label);

        var access = await Catalog.ListAccessAsync(_userId, CancellationToken.None);
        _access = access
            .Where(row => row.Available && _keyLabels.ContainsKey(row.CredentialId))
            .ToLookup(row => (row.Provider, row.ModelId), row => _keyLabels[row.CredentialId]);

        _models = await Catalog.ListAsync(CancellationToken.None);
    }

    private IReadOnlyList<string> KeysOf(CatalogModel model) =>
        _access is null ? [] : [.. _access[(model.Provider, model.ModelId)].Order(StringComparer.CurrentCulture)];

    /// <summary>Waits for the sync, so the notice can say how it went (FR-CAT-03).</summary>
    private async Task SyncAsync()
    {
        _syncing = true;
        _message = null;

        try
        {
            _message = CredentialText.SyncResultOf(await CatalogSync.SyncUserAsync(_userId, CancellationToken.None));
            await LoadAsync();
        }
        finally
        {
            _syncing = false;
        }
    }
}
