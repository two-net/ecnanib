@page "/credentials"
@inject ICredentials Credentials
@inject ICatalog Catalog
@inject ICatalogSync CatalogSync

@* Interactive: validating and deleting take no secret. Adding and replacing a key do, so they're static
   pages, linked with a plain <a>: see Forms that take a secret in docs/architecture.md. *@

<PageTitle>@Strings.CredentialsPageTitle</PageTitle>

<div class="page form-page">
    <h1>@Strings.CredentialsHeading</h1>
    <p>@Strings.CredentialsIntro</p>

    @* Always there, so a screen reader announces a notice when it appears. *@
    <p class="form-notice" role="status" tabindex="-1" hidden="@(Notice is null)" @ref="_notice">@Notice</p>

    <div class="credentials-actions">
        <a class="button" href="/credentials/add">@Strings.CredentialsAddLink</a>
        @if (HasValidAiKey)
        {
            @* On the circuit, which ICatalogSync limits, because hub traffic never reaches the limiter. *@
            <button type="button" class="button" disabled="@_syncing" @onclick="SyncAsync">
                @(_syncing ? Strings.CredentialsSyncingModels : Strings.CredentialsSyncModels)
            </button>
        }
    </div>

    @if (_credentials is { Count: 0 })
    {
        <p>@Strings.CredentialsEmpty</p>
    }
    else if (_credentials is { } credentials)
    {
        <ul class="credentials">
            @foreach (var credential in credentials)
            {
                <CredentialCard @key="credential.Id"
                                Credential="credential"
                                UserId="_userId"
                                EgressIpAddresses="Credentials.EgressIpAddresses"
                                Models="_models.GetValueOrDefault(credential.Id)"
                                OnUpdated="Replace"
                                OnDeleted="Remove" />
            }
        </ul>
    }
</div>

@code {
    private List<CredentialRecord>? _credentials;
    private Dictionary<Guid, CredentialModels> _models = [];
    private Guid _userId;
    private string? _message;
    private bool _syncing;
    private bool _focusNotice;
    private ElementReference _notice;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    /// <summary>A string, because anyone can write this query, and only the names below mean anything.</summary>
    [SupplyParameterFromQuery]
    private string? Saved { get; set; }

    private string? Notice => _message ?? Saved switch
    {
        "added" => Strings.CredentialsAddedNotice,
        "rotated" => Strings.CredentialsRotatedNotice,
        "renamed" => Strings.CredentialsRenamedNotice,
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        if (AccountClaims.UserId((await AuthenticationState).User) is not { } userId)
        {
            return;
        }

        _userId = userId;
        _credentials = [.. await Credentials.ListAsync(userId, CancellationToken.None)];
        await LoadModelsAsync();
    }

    private bool HasValidAiKey =>
        _credentials?.Any(credential => credential.Kind == CredentialKind.Ai && credential.Status == CredentialStatus.Valid) == true;

    private async Task LoadModelsAsync() =>
        _models = CredentialModels.Of(await Catalog.ListAccessAsync(_userId, CancellationToken.None));

    /// <summary>Waits for the sync, which lists each valid AI key's models, so the notice can say how it went (FR-CAT-03).</summary>
    private async Task SyncAsync()
    {
        _syncing = true;
        _message = null;

        try
        {
            _message = CredentialText.SyncResultOf(await CatalogSync.SyncUserAsync(_userId, CancellationToken.None));
            await LoadModelsAsync();
        }
        finally
        {
            _syncing = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusNotice)
        {
            _focusNotice = false;
            await _notice.FocusAsync();
        }
    }

    /// <summary>After a check, which can also change what the key can use.</summary>
    private async Task Replace(CredentialRecord credential)
    {
        var index = _credentials?.FindIndex(existing => existing.Id == credential.Id) ?? -1;

        if (index >= 0)
        {
            _credentials![index] = credential;
        }

        await LoadModelsAsync();
    }

    /// <summary>The card and its buttons go, so focus moves to the notice that says so.</summary>
    private void Remove(CredentialRecord credential)
    {
        _credentials?.RemoveAll(existing => existing.Id == credential.Id);
        _message = Strings.CredentialsDeletedNotice;
        _focusNotice = true;
    }
}
