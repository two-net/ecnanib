@page "/credentials/add"
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(RateLimits.Authentication)]
@inject ICredentials Credentials
@inject ITwoFactor TwoFactor
@inject NavigationManager Navigation

@* Static, like every form that takes a secret: keys and codes never cross a circuit. Two forms, so each
   kind of key shows only its own fields with no script. *@

<PageTitle>@Strings.AddCredentialPageTitle</PageTitle>

<div class="page form-page">
    <h1>@Strings.AddCredentialHeading</h1>
    <p>@Strings.AddCredentialIntro</p>

    <h2>@Strings.AddCredentialAiHeading</h2>
    <p>@Strings.AddCredentialAiIntro</p>

    @if (Credentials.AiProviders.Count == 0)
    {
        <p>@Strings.AddCredentialNoAiProviders</p>
    }
    else
    {
        <EditForm Model="AiInput" FormName="add-ai-key" OnSubmit="AddAiAsync" class="form">
            @if (KeyForm.FormErrorOf(_aiResult, AiInput.Provider) is { } aiError)
            {
                <p class="form-error" role="alert">@aiError</p>
            }

            <div class="field">
                <label for="ai-provider">@Strings.FieldProvider</label>
                @* A plain select: see Forms that take a secret in docs/architecture.md. *@
                <select id="ai-provider" name="Input.Provider" required>
                    @foreach (var provider in Credentials.AiProviders)
                    {
                        <option value="@provider" selected="@(provider == AiInput.Provider)">@provider</option>
                    }
                </select>
            </div>

            <div class="field">
                <label for="ai-label">@Strings.FieldCredentialLabel</label>
                <input id="ai-label" name="Input.Label" type="text" value="@AiInput.Label" autocomplete="off" required
                       maxlength="@CredentialLimits.LabelMaxLength"
                       aria-invalid="@Invalid(AiLabelError)" aria-describedby="ai-label-hint ai-label-error" />
                <p id="ai-label-hint" class="field-hint">@Strings.CredentialLabelHint</p>
                <FieldError Id="ai-label-error" Message="@AiLabelError" />
            </div>

            <div class="field">
                <label for="ai-api-key">@Strings.FieldApiKey</label>
                @* Not InputText, which would write the key back into the page after a refusal. *@
                <input id="ai-api-key" name="Input.ApiKey" type="password" autocomplete="off" autocapitalize="none" spellcheck="false"
                       required maxlength="@CredentialLimits.KeyMaxLength" />
            </div>

            <button type="submit" class="button">@Strings.AddCredentialAiSubmit</button>
        </EditForm>
    }

    <h2>@Strings.AddCredentialBinanceHeading</h2>
    <p>@Strings.AddCredentialBinanceIntro</p>
    <EgressAddresses Addresses="Credentials.EgressIpAddresses" />

    <EditForm Model="BinanceInput" FormName="add-binance-key" OnSubmit="AddBinanceAsync" class="form">
        @if (BinanceFormError is { } binanceError)
        {
            <p class="form-error" role="alert">@binanceError</p>
        }

        <div class="field">
            <label for="binance-environment">@Strings.FieldEnvironment</label>
            <select id="binance-environment" name="Input.Environment" required aria-describedby="binance-environment-hint">
                @foreach (var environment in Environments)
                {
                    <option value="@environment" selected="@(environment.ToString() == BinanceInput.Environment)">@CredentialText.EnvironmentOf(environment)</option>
                }
            </select>
            <p id="binance-environment-hint" class="field-hint">@Strings.CredentialEnvironmentHint</p>
        </div>

        <div class="field">
            <label for="binance-label">@Strings.FieldCredentialLabel</label>
            <input id="binance-label" name="Input.Label" type="text" value="@BinanceInput.Label" autocomplete="off" required
                   maxlength="@CredentialLimits.LabelMaxLength"
                   aria-invalid="@Invalid(BinanceLabelError)" aria-describedby="binance-label-hint binance-label-error" />
            <p id="binance-label-hint" class="field-hint">@Strings.CredentialLabelHint</p>
            <FieldError Id="binance-label-error" Message="@BinanceLabelError" />
        </div>

        <BinanceKeyFields Prefix="binance" ShowTwoFactor="_twoFactorOn" SecretError="@SecretChoiceError"
                          TwoFactorError="@KeyForm.TwoFactorErrorOf(_binanceResult)" />

        <button type="submit" class="button">@Strings.AddCredentialBinanceSubmit</button>
    </EditForm>

    <p><a href="/credentials">@Strings.CredentialsBackLink</a></p>
</div>

@code {
    /// <summary>Demo first, because that's where to start (UC-01).</summary>
    private static readonly TradingEnvironment[] Environments = [TradingEnvironment.Demo, TradingEnvironment.Live];

    private Guid _userId;
    private bool _twoFactorOn;
    private SaveResult? _aiResult;
    private SaveResult? _binanceResult;
    private bool _environmentInvalid;
    private bool _secretChoiceInvalid;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>
    /// Where to go once a key is saved, such as the agent wizard that sent the user here (NFR-USA-02). A form posts to
    /// the page's own address, so it's there on the post too. Anyone can write it in a link, so only a local one is followed.
    /// </summary>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private string AfterSaving => LocalUrl.Or(ReturnUrl, "/credentials?saved=added");

    [SupplyParameterFromForm(FormName = "add-ai-key", Name = "Input")]
    private AiForm AiInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "add-binance-key", Name = "Input")]
    private BinanceForm BinanceInput { get; set; } = default!;

    private string? AiLabelError => KeyForm.LabelErrorOf(_aiResult);

    private string? BinanceLabelError => KeyForm.LabelErrorOf(_binanceResult);

    private string? SecretChoiceError => _secretChoiceInvalid ? Strings.CredentialSecretChoice : null;

    private string? BinanceFormError =>
        _environmentInvalid ? Strings.CredentialEnvironmentInvalid : KeyForm.FormErrorOf(_binanceResult, CredentialProviders.Binance);

    protected override async Task OnInitializedAsync()
    {
        AiInput ??= new AiForm();
        BinanceInput ??= new BinanceForm();

        // Private, so there's always a user. Guid.Empty would find nothing anyway.
        _userId = AccountClaims.UserId(HttpContext.User) ?? Guid.Empty;
        _twoFactorOn = await TwoFactor.IsEnabledAsync(_userId, HttpContext.RequestAborted);
    }

    private async Task AddAiAsync()
    {
        using var apiKey = SecretValue.FromString(KeyForm.Clean(AiInput.ApiKey));

        _aiResult = await Credentials.AddAiKeyAsync(_userId, AiInput.Provider, AiInput.Label, apiKey, HttpContext.RequestAborted);

        if (_aiResult.Outcome == SaveOutcome.Saved)
        {
            Navigation.NavigateTo(AfterSaving);
        }
    }

    private async Task AddBinanceAsync()
    {
        if (!KeyForm.TryEnvironment(BinanceInput.Environment, out var environment))
        {
            _environmentInvalid = true;
            return;
        }

        var secretText = KeyForm.Clean(BinanceInput.Secret);
        var privateKey = KeyForm.Pem(BinanceInput.PrivateKey);

        if (KeyForm.TypeOf(secretText, privateKey) is not { } keyType)
        {
            _secretChoiceInvalid = true;
            return;
        }

        using var apiKey = SecretValue.FromString(KeyForm.Clean(BinanceInput.ApiKey));
        using var secret = SecretValue.FromString(keyType == BinanceKeyType.Hmac ? secretText : privateKey);

        _binanceResult = await Credentials.AddBinanceKeyAsync(
            _userId, environment, BinanceInput.Label, keyType, apiKey, secret, BinanceInput.TwoFactorCode, HttpContext.RequestAborted);

        if (_binanceResult.Outcome == SaveOutcome.Saved)
        {
            Navigation.NavigateTo(AfterSaving);
        }
    }

    private static string? Invalid(string? error) => error is null ? null : "true";

    private sealed class AiForm
    {
        public string Provider { get; set; } = string.Empty;

        public string Label { get; set; } = string.Empty;

        public string ApiKey { get; set; } = string.Empty;
    }

    private sealed class BinanceForm
    {
        public string Environment { get; set; } = string.Empty;

        public string Label { get; set; } = string.Empty;

        public string ApiKey { get; set; } = string.Empty;

        public string Secret { get; set; } = string.Empty;

        public string PrivateKey { get; set; } = string.Empty;

        public string TwoFactorCode { get; set; } = string.Empty;
    }
}
