@* The server's addresses for a Binance key's IP restriction (FR-KEY-05), or who to ask for them. *@

@if (Addresses.Count > 0)
{
    <p>@Strings.CredentialIpWhitelistIntro</p>
    <ul class="egress-addresses">
        @foreach (var address in Addresses)
        {
            <li><code>@address</code></li>
        }
    </ul>
}
else
{
    <p>@Strings.CredentialIpAskOperator</p>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Addresses { get; set; } = [];
}
