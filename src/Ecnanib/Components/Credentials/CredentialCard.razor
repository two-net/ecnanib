@using System.Globalization
@inject ICredentials Credentials

<li class="credential">
    <div class="credential-heading">
        @* The user chose the label. Razor encodes it, so it's only text. *@
        <h2 class="credential-label">@Credential.Label</h2>
        @if (Credential.Environment == TradingEnvironment.Demo)
        {
            <span class="credential-tag">@Strings.CredentialDemo</span>
        }
    </div>
    <p class="credential-provider">@CredentialText.ProviderOf(Credential)</p>

    <dl class="facts">
        <dt>@Strings.CredentialFieldStatus</dt>
        <dd>@CredentialText.StatusOf(Credential.Status)</dd>
        <dt>@Strings.CredentialFieldEnding</dt>
        <dd><code>@CredentialText.Ending(Credential.LastFour)</code></dd>
        @if (Credential.KeyType is { } keyType)
        {
            <dt>@Strings.CredentialFieldKeyType</dt>
            <dd>@CredentialText.KeyTypeOf(keyType)</dd>
        }
        @if (Credential.Kind == CredentialKind.Exchange && Credential.Status is CredentialStatus.Valid or CredentialStatus.InsufficientPermissions)
        {
            <dt>@Strings.CredentialFieldSpot</dt>
            <dd>@CredentialText.MarketOf(Credential.SpotEnabled)</dd>
            <dt>@Strings.CredentialFieldFutures</dt>
            <dd>@CredentialText.MarketOf(Credential.FuturesEnabled)</dd>
        }
        <dt>@Strings.CredentialFieldCreated</dt>
        <dd>@Time.Format(Credential.CreatedAt)</dd>
        <dt>@Strings.CredentialFieldValidated</dt>
        <dd>@CredentialText.Time(Time, Credential.ValidatedAt)</dd>
        <dt>@Strings.CredentialFieldUsed</dt>
        <dd>@CredentialText.Time(Time, Credential.LastUsedAt)</dd>
        @if (Credential.Kind == CredentialKind.Ai)
        {
            <dt>@Strings.CredentialFieldModels</dt>
            <dd>@CredentialText.ModelsOf(Time, Models)</dd>
        }
    </dl>

    @if (CredentialText.ExplanationOf(Credential) is { } explanation)
    {
        <p class="credential-problem">@explanation</p>
    }

    @if (Credential.IpRestricted == false)
    {
        <div class="credential-warning">
            <p>@Strings.CredentialIpUnrestricted</p>
            <EgressAddresses Addresses="EgressIpAddresses" />
        </div>
    }

    <div class="credential-actions">
        <button type="button" class="button" aria-label="@Labelled(Strings.CredentialValidateLabel)" disabled="@_validating"
                @onclick="ValidateAsync">
            @Strings.CredentialValidate
        </button>
        @* A plain link, because the page is static: see Forms that take a secret in docs/architecture.md. *@
        <a href="@($"/credentials/{Credential.Id}")" aria-label="@Labelled(Strings.CredentialEditLabel)">@Strings.CredentialEdit</a>
        @if (!_confirming)
        {
            <button type="button" class="button" aria-label="@Labelled(Strings.CredentialDeleteLabel)" @ref="_delete" @onclick="Confirm">
                @Strings.CredentialDelete
            </button>
        }
    </div>

    @if (_confirming)
    {
        <div class="credential-confirm">
            <p>@Labelled(Strings.CredentialDeleteConfirm)</p>
            <div class="credential-actions">
                <button type="button" class="button" @ref="_confirm" @onclick="DeleteAsync">@Strings.CredentialDeleteSubmit</button>
                <button type="button" class="button" @onclick="Cancel">@Strings.CredentialDeleteCancel</button>
            </div>
        </div>
    }

    @* Always there, so a screen reader announces the result when it appears. *@
    <p class="form-notice" role="status" hidden="@(_message is null)">@_message</p>
</li>

@code {
    private string? _message;
    private bool _validating;
    private bool _confirming;
    private Focus _focus;
    private ElementReference _delete;
    private ElementReference _confirm;

    [Parameter, EditorRequired]
    public CredentialRecord Credential { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid UserId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<string> EgressIpAddresses { get; set; } = [];

    /// <summary>An AI key's models at its last sync, or null if it was never synced.</summary>
    [Parameter]
    public CredentialModels? Models { get; set; }

    [Parameter]
    public EventCallback<CredentialRecord> OnUpdated { get; set; }

    [Parameter]
    public EventCallback<CredentialRecord> OnDeleted { get; set; }

    /// <summary>Routes cascades it, from the user's preference or their browser (FR-PREF-05).</summary>
    [CascadingParameter]
    private DisplayTime Time { get; set; } = DisplayTime.Utc;

    /// <summary>Where focus goes once a button it was on has gone. Only after a render does the new one exist.</summary>
    private enum Focus
    {
        None,
        Confirm,
        Delete,
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var target = _focus;
        _focus = Focus.None;

        if (target == Focus.Confirm)
        {
            await _confirm.FocusAsync();
        }
        else if (target == Focus.Delete)
        {
            await _delete.FocusAsync();
        }
    }

    /// <summary>On the circuit, which <see cref="ICredentials.ValidateAsync"/> limits, because hub traffic never reaches the limiter.</summary>
    private async Task ValidateAsync()
    {
        _validating = true;
        _message = null;

        try
        {
            var result = await Credentials.ValidateAsync(UserId, Credential.Id, CancellationToken.None);

            _message = result.Outcome switch
            {
                ValidationOutcome.Checked when result.Credential is { } checkedNow =>
                    string.Format(CultureInfo.CurrentCulture, Strings.CredentialValidated, CredentialText.StatusOf(checkedNow.Status)),
                ValidationOutcome.TooSoon => Strings.CredentialValidateTooSoon,
                ValidationOutcome.Unreachable =>
                    string.Format(CultureInfo.CurrentCulture, Strings.CredentialValidateUnreachable, CredentialText.ProviderOf(Credential)),
                _ => Strings.CredentialGone,
            };

            if (result.Credential is { } current)
            {
                await OnUpdated.InvokeAsync(current);
            }
        }
        finally
        {
            _validating = false;
        }
    }

    private void Confirm()
    {
        _confirming = true;
        _focus = Focus.Confirm;
    }

    private void Cancel()
    {
        _confirming = false;
        _focus = Focus.Delete;
    }

    /// <summary>Once it's deleted, the list removes the card and moves focus to its notice.</summary>
    private async Task DeleteAsync()
    {
        if (await Credentials.DeleteAsync(UserId, Credential.Id, CancellationToken.None))
        {
            await OnDeleted.InvokeAsync(Credential);
            return;
        }

        _confirming = false;
        _focus = Focus.Delete;
        _message = Strings.CredentialGone;
    }

    private string Labelled(string format) => string.Format(CultureInfo.CurrentCulture, format, Credential.Label);
}
