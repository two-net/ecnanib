@page "/credentials/{Id:guid}"
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(RateLimits.Authentication)]
@inject ICredentials Credentials
@inject ITwoFactor TwoFactor
@inject NavigationManager Navigation

@* Static, because replacing a key takes a secret. Renaming takes none, but it's here beside it. *@

<PageTitle>@Strings.EditCredentialPageTitle</PageTitle>

@if (_credential is { } credential)
{
    <div class="page form-page">
        <h1>@Strings.EditCredentialHeading</h1>

        <dl class="facts">
            <dt>@Strings.FieldCredentialLabel</dt>
            @* The user chose the label. Razor encodes it, so it's only text. *@
            <dd>@credential.Label</dd>
            <dt>@Strings.FieldProvider</dt>
            <dd>@CredentialText.ProviderOf(credential)</dd>
            <dt>@Strings.CredentialFieldEnding</dt>
            <dd><code>@CredentialText.Ending(credential.LastFour)</code></dd>
            <dt>@Strings.CredentialFieldStatus</dt>
            <dd>@CredentialText.StatusOf(credential.Status)</dd>
        </dl>

        <h2>@Strings.EditCredentialRenameHeading</h2>

        <EditForm Model="RenameInput" FormName="rename-key" OnSubmit="RenameAsync" class="form">
            <div class="field">
                <label for="rename-label">@Strings.FieldCredentialLabel</label>
                <input id="rename-label" name="Input.Label" type="text" value="@(RenameInput.Label is { Length: > 0 } typed ? typed : credential.Label)"
                       autocomplete="off" required maxlength="@CredentialLimits.LabelMaxLength"
                       aria-invalid="@Invalid(RenameError)" aria-describedby="rename-label-hint rename-label-error" />
                <p id="rename-label-hint" class="field-hint">@Strings.CredentialLabelHint</p>
                <FieldError Id="rename-label-error" Message="@RenameError" />
            </div>

            <button type="submit" class="button">@Strings.EditCredentialRenameSubmit</button>
        </EditForm>

        <h2>@Strings.EditCredentialRotateHeading</h2>
        <p>@(credential.Kind == CredentialKind.Exchange ? Strings.EditCredentialRotateBinanceIntro : Strings.EditCredentialRotateAiIntro)</p>

        <EditForm Model="RotateInput" FormName="rotate-key" OnSubmit="RotateAsync" class="form">
            @if (RotateFormError is { } rotateError)
            {
                <p class="form-error" role="alert">@rotateError</p>
            }

            @if (credential.Kind == CredentialKind.Exchange)
            {
                <BinanceKeyFields Prefix="rotate" ShowTwoFactor="_twoFactorOn" SecretError="@SecretChoiceError"
                                  TwoFactorError="@KeyForm.TwoFactorErrorOf(_rotateResult)" />
            }
            else
            {
                <div class="field">
                    <label for="rotate-api-key">@Strings.FieldApiKey</label>
                    @* Not InputText, which would write the key back into the page after a refusal. *@
                    <input id="rotate-api-key" name="Input.ApiKey" type="password" autocomplete="off" autocapitalize="none" spellcheck="false"
                           required maxlength="@CredentialLimits.KeyMaxLength" />
                </div>
            }

            <button type="submit" class="button">@Strings.EditCredentialRotateSubmit</button>
        </EditForm>

        <p><a href="/credentials">@Strings.CredentialsBackLink</a></p>
    </div>
}

@code {
    private CredentialRecord? _credential;
    private Guid _userId;
    private bool _twoFactorOn;
    private RenameOutcome? _renameOutcome;
    private SaveResult? _rotateResult;
    private bool _secretChoiceInvalid;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "rename-key", Name = "Input")]
    private RenameForm RenameInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "rotate-key", Name = "Input")]
    private RotateForm RotateInput { get; set; } = default!;

    private string? RenameError => _renameOutcome == RenameOutcome.LabelInvalid ? KeyForm.LabelError : null;

    private string? SecretChoiceError => _secretChoiceInvalid ? Strings.CredentialSecretChoice : null;

    private string? RotateFormError => KeyForm.FormErrorOf(_rotateResult, _credential?.Provider ?? string.Empty);

    protected override async Task OnInitializedAsync()
    {
        RenameInput ??= new RenameForm();
        RotateInput ??= new RotateForm();

        // Private, so there's always a user. Guid.Empty would find nothing anyway.
        _userId = AccountClaims.UserId(HttpContext.User) ?? Guid.Empty;
        _credential = await Credentials.FindAsync(_userId, Id, HttpContext.RequestAborted);

        if (_credential is null)
        {
            // Another user's credential is answered like one that doesn't exist (NFR-SEC-04).
            Navigation.NotFound();
            return;
        }

        _twoFactorOn = await TwoFactor.IsEnabledAsync(_userId, HttpContext.RequestAborted);
    }

    private async Task RenameAsync()
    {
        if (_credential is null)
        {
            return;
        }

        _renameOutcome = await Credentials.RenameAsync(_userId, Id, RenameInput.Label, HttpContext.RequestAborted);

        if (_renameOutcome == RenameOutcome.Renamed)
        {
            Navigation.NavigateTo("/credentials?saved=renamed");
        }
        else if (_renameOutcome == RenameOutcome.NotFound)
        {
            Navigation.NotFound();
        }
    }

    private async Task RotateAsync()
    {
        if (_credential is not { } credential)
        {
            return;
        }

        if (credential.Kind == CredentialKind.Ai)
        {
            using var apiKey = SecretValue.FromString(KeyForm.Clean(RotateInput.ApiKey));

            _rotateResult = await Credentials.RotateAiKeyAsync(_userId, Id, apiKey, HttpContext.RequestAborted);
        }
        else
        {
            var secretText = KeyForm.Clean(RotateInput.Secret);
            var privateKey = KeyForm.Pem(RotateInput.PrivateKey);

            if (KeyForm.TypeOf(secretText, privateKey) is not { } keyType)
            {
                _secretChoiceInvalid = true;
                return;
            }

            using var apiKey = SecretValue.FromString(KeyForm.Clean(RotateInput.ApiKey));
            using var secret = SecretValue.FromString(keyType == BinanceKeyType.Hmac ? secretText : privateKey);

            _rotateResult = await Credentials.RotateBinanceKeyAsync(
                _userId, Id, keyType, apiKey, secret, RotateInput.TwoFactorCode, HttpContext.RequestAborted);
        }

        if (_rotateResult.Outcome == SaveOutcome.Saved)
        {
            Navigation.NavigateTo("/credentials?saved=rotated");
        }
    }

    private static string? Invalid(string? error) => error is null ? null : "true";

    private sealed class RenameForm
    {
        public string Label { get; set; } = string.Empty;
    }

    private sealed class RotateForm
    {
        public string ApiKey { get; set; } = string.Empty;

        public string Secret { get; set; } = string.Empty;

        public string PrivateKey { get; set; } = string.Empty;

        public string TwoFactorCode { get; set; } = string.Empty;
    }
}
