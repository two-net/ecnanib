@* The fields of a Binance key, on the add and replace forms. Each is a raw input that's never given a value,
   and the text area is never given content, so nothing typed is written back after a refusal: see Forms that
   take a secret in docs/architecture.md. *@

<div class="field">
    <label for="@($"{Prefix}-api-key")">@Strings.FieldApiKey</label>
    <input id="@($"{Prefix}-api-key")" name="Input.ApiKey" type="password" autocomplete="off" autocapitalize="none" spellcheck="false"
           required maxlength="@CredentialLimits.KeyMaxLength" />
</div>

<fieldset class="field secret-choice" aria-describedby="@($"{Prefix}-secret-hint {Prefix}-secret-error")">
    <legend>@Strings.CredentialSecretLegend</legend>
    <p id="@($"{Prefix}-secret-hint")" class="field-hint">@Strings.CredentialSecretHint</p>

    <div class="field">
        <label for="@($"{Prefix}-secret")">@Strings.FieldApiSecret</label>
        <input id="@($"{Prefix}-secret")" name="Input.Secret" type="password" autocomplete="off" autocapitalize="none" spellcheck="false"
               maxlength="@CredentialLimits.KeyMaxLength" aria-invalid="@Invalid(SecretError)" />
    </div>

    <div class="field">
        <label for="@($"{Prefix}-private-key")">@Strings.FieldPrivateKey</label>
        <textarea id="@($"{Prefix}-private-key")" name="Input.PrivateKey" rows="5" autocomplete="off" autocapitalize="none" spellcheck="false"
                  maxlength="@CredentialLimits.PrivateKeyMaxLength" aria-invalid="@Invalid(SecretError)"></textarea>
    </div>

    <FieldError Id="@($"{Prefix}-secret-error")" Message="@SecretError" />
</fieldset>

@if (ShowTwoFactor)
{
    <div class="field">
        <label for="@($"{Prefix}-code")">@Strings.FieldTwoFactorCode</label>
        @* Not InputText, which would write the code back into the page after a refusal. *@
        <input id="@($"{Prefix}-code")" name="Input.TwoFactorCode" type="text" autocomplete="one-time-code" autocapitalize="none"
               spellcheck="false" required maxlength="64"
               aria-invalid="@Invalid(TwoFactorError)" aria-describedby="@($"{Prefix}-code-hint {Prefix}-code-error")" />
        <p id="@($"{Prefix}-code-hint")" class="field-hint">@Strings.CredentialTwoFactorHint</p>
        <FieldError Id="@($"{Prefix}-code-error")" Message="@TwoFactorError" />
    </div>
}

@code {
    /// <summary>Starts every ID, so that two forms on one page don't share any.</summary>
    [Parameter, EditorRequired]
    public string Prefix { get; set; } = default!;

    /// <summary>Whether the user has two-factor on, so the action needs a code (FR-AUTH-05).</summary>
    [Parameter]
    public bool ShowTwoFactor { get; set; }

    [Parameter]
    public string? SecretError { get; set; }

    [Parameter]
    public string? TwoFactorError { get; set; }

    private static string? Invalid(string? error) => error is null ? null : "true";
}
