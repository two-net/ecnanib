@page "/keys/exchange/{Id:guid}"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Ecnanib.Database.Entities
@using Ecnanib.Exchange.Abstractions
@inject IKeyService Keys
@inject NavigationManager Navigation

<PageTitle>@(_key is { } titleKey ? $"Binance key “{titleKey.Label}”" : "Binance key")</PageTitle>

@if (_key is { } key)
{
    <div class="page narrow">
        <h1>Binance key “@key.Label”</h1>

        @if (_notice is not null)
        {
            <p class="@(_noticeIsError ? "error" : "notice")" role="@(_noticeIsError ? "alert" : "status")">@_notice</p>
        }

        <section class="card" aria-labelledby="details-title">
            <h2 id="details-title">Details</h2>
            <dl class="details">
                <dt>Environment</dt><dd>@key.Environment</dd>
                <dt>Markets</dt><dd>@Markets(key)</dd>
                <dt>Key</dt><dd><code>@key.MaskedApiKey</code></dd>
                <dt>Status</dt>
                <dd>
                    <span class="status @StatusClass(key.Status)">@key.Status</span>
                    @if (key.Status == KeyStatus.Invalid && key.LastValidationError is not null)
                    {
                        <span class="muted">@key.LastValidationError</span>
                    }
                </dd>
                <dt>Last checked</dt><dd>@UtcStamp.Minute(key.LastValidatedAt)</dd>
                <dt>Added</dt><dd>@UtcStamp.Minute(key.CreatedAt)</dd>
                <dt>Running or paused agents using it</dt><dd>@key.ActiveAgents</dd>
            </dl>
            <h3>Permissions reported by Binance</h3>
            @if (key.Permissions is { Verified: true } p)
            {
                <ul class="permissions">
                    <li>Reading: @YesNo(p.EnableReading)</li>
                    <li>Spot trading: @YesNo(p.EnableSpotTrading)</li>
                    <li>Futures: @YesNo(p.EnableFutures)</li>
                    <li>Withdrawals: @YesNo(p.EnableWithdrawals)</li>
                    <li>IP restricted: @YesNo(p.IpRestricted)</li>
                    @if (p.CreatedAt is { } created)
                    {
                        <li>Created: @UtcStamp.Minute(created)</li>
                    }
                </ul>
                @if ((key.AllowSpot && !p.EnableSpotTrading) || (key.AllowFutures && !p.EnableFutures))
                {
                    <p class="hint">A selected market has no trading permission on this key; agents on that market cannot place orders with it.</p>
                }
            }
            else
            {
                <p class="hint">@KeyMessages.TestnetPermissions</p>
            }
            <form method="post" @formname="validate-exchange-key" @onsubmit="ValidateAsync" class="inline">
                <AntiforgeryToken />
                <button type="submit">Validate now</button>
            </form>
        </section>

        <section class="card" aria-labelledby="replace-title">
            <h2 id="replace-title">Replace credentials</h2>
            <p>Enter a new key pair. The label, environment and markets stay, and agents keep using this key.</p>
            <EditForm Model="Replace" FormName="replace-exchange-key" OnValidSubmit="ReplaceAsync" OnInvalidSubmit="ClearSecrets" method="post">
                <DataAnnotationsValidator />
                @if (_replaceError is not null)
                {
                    <p class="error" role="alert">@_replaceError</p>
                }
                <ValidationSummary />
                <label>
                    New API key
                    <InputText @bind-Value="Replace.ApiKey" autocomplete="off" spellcheck="false" maxlength="256" required />
                </label>
                <label>
                    New secret
                    <InputText @bind-Value="Replace.ApiSecret" type="password" autocomplete="off" spellcheck="false" maxlength="256" required />
                </label>
                <p class="hint">@KeyMessages.BinanceKeyHint</p>
                <button type="submit" class="primary">Validate and replace</button>
            </EditForm>
        </section>

        <section class="card danger-zone" aria-labelledby="delete-title">
            <h2 id="delete-title">Delete key</h2>
            <p>Agents that reference this key lose it. @(key.ActiveAgents > 0 ? KeyMessages.AgentsInUse(key.ActiveAgents) : "No running or paused agent uses it.")</p>
            <EditForm Model="Delete" FormName="delete-exchange-key" OnValidSubmit="DeleteAsync" method="post">
                <DataAnnotationsValidator />
                @if (_deleteError is not null)
                {
                    <p class="error" role="alert">@_deleteError</p>
                }
                <ValidationSummary />
                <label class="check">
                    <InputCheckbox @bind-Value="Delete.Confirm" />
                    I understand that agents can no longer use this key.
                </label>
                @if (key.ActiveAgents > 0)
                {
                    <label class="check">
                        <InputCheckbox @bind-Value="Delete.StopAgents" />
                        Stop the @KeyMessages.Plural(key.ActiveAgents, "running or paused agent", "running or paused agents") that use it as part of the deletion.
                    </label>
                }
                <button type="submit" class="danger">Delete key</button>
            </EditForm>
        </section>

        <p><a href="/keys">Back to keys</a></p>
    </div>
}

@code {
    private ExchangeKeyView? _key;
    private string? _notice;
    private bool _noticeIsError;
    private string? _replaceError;
    private string? _deleteError;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "replace-exchange-key")]
    private ReplaceInput Replace { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "delete-exchange-key")]
    private DeleteInput Delete { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "status")]
    private string? Status { get; set; }

    private Guid UserId => HttpContext.User.RequireUserId();

    private string Self => $"/keys/exchange/{Id}";

    protected override async Task OnInitializedAsync()
    {
        Replace ??= new();
        Delete ??= new();
        _key = await Keys.GetExchangeKeyAsync(UserId, Id, HttpContext.RequestAborted);
        if (_key is null)
        {
            // Someone else's key and a non-existent one look the same (NFR-SEC-03).
            Navigation.NotFound();
            return;
        }

        (_notice, _noticeIsError) = Status switch
        {
            "valid" => ("Binance accepted the key.", false),
            "invalid" => ($"Binance rejected the key: {_key.LastValidationError ?? "see the status above"}.", true),
            "failed" => ("The key could not be checked; its status is unchanged. Try again.", true),
            _ => (null, false),
        };
    }

    private async Task ValidateAsync()
    {
        var result = await Keys.ValidateExchangeKeyAsync(UserId, Id, HttpContext.RequestAborted);
        Navigation.NavigateTo(result.Outcome switch
        {
            KeyValidationOutcome.Valid => Self + "?status=valid",
            KeyValidationOutcome.Invalid => Self + "?status=invalid",
            KeyValidationOutcome.Failed => Self + "?status=failed",
            _ => "/keys",
        });
    }

    private async Task ReplaceAsync()
    {
        var result = await Keys.ReplaceExchangeKeyAsync(UserId, Id, Replace.ApiKey, Replace.ApiSecret, HttpContext.RequestAborted);
        ClearSecrets();
        if (result.Status == KeySaveStatus.Succeeded)
        {
            Navigation.NavigateTo("/keys?status=exchange-replaced");
            return;
        }

        _replaceError = KeyMessages.ForSave(result, "Binance");
    }

    private async Task DeleteAsync()
    {
        var result = await Keys.DeleteExchangeKeyAsync(UserId, Id, Delete.StopAgents, HttpContext.RequestAborted);
        switch (result.Status)
        {
            case KeyDeletionStatus.Succeeded:
            case KeyDeletionStatus.NotFound:
                Navigation.NavigateTo($"/keys?status=exchange-deleted&agents={result.Agents}");
                return;
            case KeyDeletionStatus.AgentsInUse:
                _deleteError = KeyMessages.AgentsInUse(result.Agents);
                _key = await Keys.GetExchangeKeyAsync(UserId, Id, HttpContext.RequestAborted);
                break;
        }
    }

    // FR-KEY-04: a re-rendered form must never echo the key or secret back into the page.
    private void ClearSecrets()
    {
        Replace.ApiKey = "";
        Replace.ApiSecret = "";
    }

    private static string Markets(ExchangeKeyView key) => (key.AllowSpot, key.AllowFutures) switch
    {
        (true, true) => "Spot, Futures",
        (true, false) => "Spot",
        (false, true) => "Futures",
        _ => "None",
    };

    private static string StatusClass(KeyStatus status) => status switch
    {
        KeyStatus.Valid => "status-valid",
        KeyStatus.Invalid => "status-invalid",
        _ => "status-unvalidated",
    };

    private static string YesNo(bool value) => value ? "yes" : "no";

    private sealed class ReplaceInput
    {
        [Required(ErrorMessage = "Enter the new API key.")]
        public string ApiKey { get; set; } = "";

        [Required(ErrorMessage = "Enter the new secret.")]
        public string ApiSecret { get; set; } = "";
    }

    private sealed class DeleteInput
    {
        [Range(typeof(bool), "true", "true", ErrorMessage = "Tick the box to confirm.")]
        public bool Confirm { get; set; }

        public bool StopAgents { get; set; }
    }
}
