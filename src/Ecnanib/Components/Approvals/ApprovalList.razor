@page "/approvals"
@implements IDisposable
@inject IApprovals Approvals
@inject IAgents Agents
@inject LiveUpdates Live
@inject ILogger<ApprovalList> Logger

@* Interactive: approving and rejecting take no secret. FR-APR-02: the user approves or rejects in the app. A decided
   approval stays where it is until the page is opened again, so focus and the announcement of how it went aren't lost.
   A new approval joins the top as its notification commits, and one that expires changes in place (FR-UI-05). *@

<PageTitle>@Strings.ApprovalsPageTitle</PageTitle>

<div class="page form-page">
    <h1>@Strings.ApprovalsHeading</h1>
    <p>@Strings.ApprovalsIntro</p>

    @if (_pending is not null && _decided is not null)
    {
        <section class="approvals-section" aria-labelledby="approvals-pending">
            <h2 id="approvals-pending">@Strings.ApprovalsPendingHeading</h2>
            @if (_pending.Count == 0)
            {
                <p>@Strings.ApprovalsPendingEmpty</p>
            }
            else
            {
                <ul class="approvals">
                    @foreach (var approval in _pending)
                    {
                        <li @key="approval.Id">
                            <ApprovalCard Approval="approval" Agent="AgentOf(approval)" UserId="_userId" OnChanged="Replace" />
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="approvals-section" aria-labelledby="approvals-decided">
            <h2 id="approvals-decided">@Strings.ApprovalsDecidedHeading</h2>
            @if (_decided.Count == 0)
            {
                <p>@Strings.ApprovalsDecidedEmpty</p>
            }
            else
            {
                <ul class="approvals">
                    @foreach (var approval in _decided)
                    {
                        <li @key="approval.Id">
                            <ApprovalCard Approval="approval" Agent="AgentOf(approval)" UserId="_userId" OnChanged="Replace" />
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>

@code {
    private Guid _userId;
    private List<ApprovalRecord>? _pending;
    private List<ApprovalRecord>? _decided;
    private Dictionary<Guid, AgentRecord> _agents = [];
    private IDisposable? _live;
    private LiveRefresh? _refresh;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if (AccountClaims.UserId((await AuthenticationState).User) is not { } userId)
        {
            return;
        }

        _userId = userId;

        var list = await Approvals.ListAsync(userId, CancellationToken.None);
        _pending = [.. list.Pending];
        _decided = [.. list.Decided];

        // Archived ones too, because a decided approval's agent may have been archived since.
        _agents = (await Agents.ListAsync(userId, includeArchived: true, CancellationToken.None)).ToDictionary(agent => agent.Id);

        // An approval raises a notification when it's proposed and when it expires, so that's the signal to read again.
        if (RendererInfo.IsInteractive)
        {
            _refresh = new LiveRefresh(InvokeAsync, MergeAsync, Logger);
            _live = Live.Subscribe(userId, change =>
            {
                if (change.Change == LiveChange.Notification)
                {
                    _refresh.Request();
                }
            });
        }
    }

    public void Dispose() => _live?.Dispose();

    /// <summary>
    /// A new pending approval goes at the top. One already shown is replaced where it is, so nothing the user is
    /// looking at moves.
    /// </summary>
    private async Task MergeAsync()
    {
        if (_pending is null || _decided is null)
        {
            return;
        }

        var list = await Approvals.ListAsync(_userId, CancellationToken.None);
        var shown = _pending.Concat(_decided).Select(approval => approval.Id).ToHashSet();

        foreach (var current in list.Pending.Concat(list.Decided).Where(approval => shown.Contains(approval.Id)))
        {
            Replace(current);
        }

        var added = list.Pending.Where(approval => !shown.Contains(approval.Id)).ToList();

        if (added.Any(approval => !_agents.ContainsKey(approval.AgentId)))
        {
            _agents = (await Agents.ListAsync(_userId, includeArchived: true, CancellationToken.None)).ToDictionary(agent => agent.Id);
        }

        _pending.InsertRange(0, added);
        StateHasChanged();
    }

    private AgentRecord? AgentOf(ApprovalRecord approval) => _agents.GetValueOrDefault(approval.AgentId);

    /// <summary>In place, in whichever list it's in.</summary>
    private void Replace(ApprovalRecord current)
    {
        foreach (var list in new[] { _pending, _decided })
        {
            if (list?.FindIndex(approval => approval.Id == current.Id) is { } index and >= 0)
            {
                list[index] = current;
            }
        }
    }
}
