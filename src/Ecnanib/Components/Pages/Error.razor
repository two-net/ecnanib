@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics

<PageTitle>@Strings.ErrorPageTitle</PageTitle>

<div class="page message-page">
    <h1>@Strings.ErrorHeading</h1>
    <p>@Strings.ErrorMessage</p>
    <p><a href="/">@Strings.GoHome</a></p>

    @if (ShowRequestId)
    {
        <p>
            <strong>@Strings.ErrorRequestId</strong> <code>@RequestId</code>
        </p>
    }
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
