@page "/forgot-password"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(RateLimits.Authentication)]
@inject IPasswordResets PasswordResets

<PageTitle>@Strings.ForgotPasswordPageTitle</PageTitle>

<div class="page form-page">
    <h1>@Strings.ForgotPasswordHeading</h1>

    @if (PasswordResets.Mode == PasswordResetMode.ByAdministrator)
    {
        <p>@Strings.ForgotPasswordByAdministrator</p>
    }
    else if (_sent)
    {
        @* The same whether or not an account uses the address, so this answer doesn't say which. *@
        <p class="form-notice" role="status">@Strings.ForgotPasswordSent</p>
    }
    else
    {
        <p>@Strings.ForgotPasswordIntro</p>

        <EditForm Model="Input" FormName="forgot-password" OnSubmit="SubmitAsync" class="form">
            <div class="field">
                <label for="email">@Strings.FieldEmail</label>
                <InputText id="email" type="email" autocomplete="username" required @bind-Value="Input.Email" />
            </div>

            <button type="submit" class="button">@Strings.ForgotPasswordSubmit</button>
        </EditForm>
    }

    <p><a href="/sign-in">@Strings.ForgotPasswordBackToSignIn</a></p>
</div>

@code {
    private bool _sent;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private ForgotPasswordForm Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new ForgotPasswordForm();

    private async Task SubmitAsync()
    {
        await PasswordResets.RequestAsync(Input.Email, HttpContext.RequestAborted);

        _sent = true;
    }

    private sealed class ForgotPasswordForm
    {
        public string Email { get; set; } = string.Empty;
    }
}
