@page "/account/password"
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(RateLimits.Authentication)]
@using System.Globalization
@inject IAccounts Accounts
@inject NavigationManager Navigation

<PageTitle>@Strings.ChangePasswordPageTitle</PageTitle>

<div class="page form-page">
    <h1>@Strings.ChangePasswordHeading</h1>
    <p>@Strings.ChangePasswordIntro</p>

    <EditForm Model="Input" FormName="change-password" OnSubmit="SubmitAsync" class="form">
        <div class="field">
            <label for="current-password">@Strings.FieldCurrentPassword</label>
            @* Not InputText, which would write the password back into the page after a refusal. *@
            <input id="current-password" name="Input.CurrentPassword" type="password" autocomplete="current-password" required
                   aria-invalid="@Invalid(CurrentPasswordError)" aria-describedby="current-password-error" />
            <FieldError Id="current-password-error" Message="@CurrentPasswordError" />
        </div>

        <div class="field">
            <label for="new-password">@Strings.FieldNewPassword</label>
            <input id="new-password" name="Input.NewPassword" type="password" autocomplete="new-password" required
                   minlength="@Rules.PasswordMinLength" maxlength="@Rules.PasswordMaxLength"
                   aria-invalid="@Invalid(NewPasswordError)" aria-describedby="new-password-hint new-password-error" />
            <p id="new-password-hint" class="field-hint">@PasswordHint</p>
            <FieldError Id="new-password-error" Message="@NewPasswordError" />
        </div>

        <div class="field">
            <label for="confirm-password">@Strings.FieldConfirmPassword</label>
            <input id="confirm-password" name="Input.ConfirmPassword" type="password" autocomplete="new-password" required
                   aria-invalid="@Invalid(ConfirmPasswordError)" aria-describedby="confirm-password-error" />
            <FieldError Id="confirm-password-error" Message="@ConfirmPasswordError" />
        </div>

        <button type="submit" class="button">@Strings.ChangePasswordSubmit</button>
    </EditForm>
</div>

@code {
    private PasswordChangeResult? _result;
    private bool _passwordsDiffer;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private PasswordForm Input { get; set; } = default!;

    private RegistrationRules Rules => Accounts.RegistrationRules;

    private string PasswordHint => string.Format(CultureInfo.CurrentCulture, Strings.RegisterPasswordHint, Rules.PasswordMinLength);

    private string? CurrentPasswordError => _result == PasswordChangeResult.CurrentPasswordWrong ? Strings.ChangePasswordRefused : null;

    private string? NewPasswordError =>
        _result == PasswordChangeResult.PasswordTooShort ? PasswordHint
        : _result == PasswordChangeResult.PasswordTooLong ? Strings.RegisterPasswordTooLong
        : null;

    private string? ConfirmPasswordError => _passwordsDiffer ? Strings.RegisterPasswordsDiffer : null;

    protected override void OnInitialized() => Input ??= new PasswordForm();

    private static string? Invalid(string? error) => error is null ? null : "true";

    private async Task SubmitAsync()
    {
        if (Input.NewPassword != Input.ConfirmPassword)
        {
            _passwordsDiffer = true;
            return;
        }

        _result = await Accounts.ChangePasswordAsync(HttpContext.User, Input.CurrentPassword, Input.NewPassword, HttpContext.RequestAborted);

        if (_result == PasswordChangeResult.Changed)
        {
            Navigation.NavigateTo("/account?passwordChanged=true");
        }
    }

    private sealed class PasswordForm
    {
        public string CurrentPassword { get; set; } = string.Empty;

        public string NewPassword { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
