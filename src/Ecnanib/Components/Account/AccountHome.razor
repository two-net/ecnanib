@page "/account"
@using System.Globalization
@inject IAccounts Accounts
@inject IAdministrators Administrators
@inject IEmailVerification Verification
@inject IPasswordResets PasswordResets
@inject ITwoFactor TwoFactor

<PageTitle>@Strings.AccountPageTitle</PageTitle>

<div class="page form-page">
    <h1>@Strings.AccountHeading</h1>

    @if (PasswordChanged == "true")
    {
        <p class="form-notice" role="status">@Strings.AccountPasswordChanged</p>
    }
    else if (EmailVerified == "true")
    {
        <p class="form-notice" role="status">@Strings.AccountEmailVerifiedNotice</p>
    }

    @if (_overview is { } overview)
    {
        <dl class="facts">
            <dt>@Strings.FieldEmail</dt>
            <dd>@overview.Email</dd>
            @if (Verification.IsEnabled)
            {
                <dt>@Strings.AccountEmailVerification</dt>
                <dd>@(overview.EmailVerified ? Strings.AccountEmailVerifiedYes : Strings.AccountEmailVerifiedNo)</dd>
            }
            <dt>@Strings.AccountRole</dt>
            <dd>@(_isAdministrator ? Strings.AccountRoleAdministrator : Strings.AccountRoleUser)</dd>
            <dt>@Strings.AccountTwoFactor</dt>
            <dd>@(_twoFactorOn ? Strings.AccountTwoFactorOn : Strings.AccountTwoFactorOff)</dd>
        </dl>

        @if (Verification.IsEnabled && !overview.EmailVerified)
        {
            <p>@Strings.AccountVerifyIntro</p>
            <button type="button" class="button" @onclick="SendVerificationAsync">@Strings.AccountVerifySend</button>
            @* Always there, so a screen reader announces the result when it appears. *@
            <p class="form-notice" role="status" hidden="@(_sendResult is null)">@SendResultText</p>
        }

        @if (_canConfirm)
        {
            <p><a href="/account/administrator">@Strings.AccountConfirmAdministratorLink</a></p>
        }

        @if (_isAdministrator && PasswordResets.Mode == PasswordResetMode.ByAdministrator)
        {
            <p><a href="/admin/password-reset">@Strings.AccountIssueResetLink</a></p>
        }

        <p><a href="/account/password">@Strings.AccountChangePasswordLink</a></p>
        @* A plain link, because the page is static: see Forms that take a secret in docs/architecture.md. *@
        <p><a href="/account/two-factor">@(_twoFactorOn ? Strings.AccountManageTwoFactorLink : Strings.AccountSetUpTwoFactorLink)</a></p>
        <p><a href="/account/activity">@Strings.AccountActivityLink</a></p>
        @* A plain link, because the page is static: see Preferences in docs/architecture.md. *@
        <p><a href="/account/preferences">@Strings.AccountPreferencesLink</a></p>

        <SessionList UserId="_userId" CurrentSessionId="_sessionId" />

        <h2>@Strings.AccountDocumentsHeading</h2>

        <ul class="facts-list">
            @foreach (var acceptance in overview.Acceptances)
            {
                <li>@Describe(acceptance)</li>
            }
        </ul>
    }
</div>

@code {
    private AccountOverview? _overview;
    private Guid _userId;
    private Guid? _sessionId;
    private bool _isAdministrator;
    private bool _canConfirm;
    private bool _twoFactorOn;
    private VerificationEmailResult? _sendResult;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    /// <summary>Routes cascades it, from the user's preference or their browser (FR-PREF-05).</summary>
    [CascadingParameter]
    private DisplayTime Time { get; set; } = DisplayTime.Utc;

    /// <summary>A string, because a bool makes any other value a 500, and anyone can write this query.</summary>
    [SupplyParameterFromQuery]
    private string? PasswordChanged { get; set; }

    /// <summary>A string, for the same reason as <see cref="PasswordChanged"/>.</summary>
    [SupplyParameterFromQuery]
    private string? EmailVerified { get; set; }

    private string? SendResultText => _sendResult switch
    {
        VerificationEmailResult.Sent => Strings.AccountVerifySent,
        VerificationEmailResult.TooSoon => Strings.AccountVerifyTooSoon,
        VerificationEmailResult.AlreadyVerified => Strings.AccountEmailVerifiedNotice,
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;

        if (AccountClaims.UserId(user) is not { } userId)
        {
            return;
        }

        _userId = userId;
        _sessionId = AccountClaims.SessionId(user);
        _overview = await Accounts.FindAsync(userId, CancellationToken.None);
        _isAdministrator = await Administrators.IsAdministratorAsync(userId, CancellationToken.None);
        _canConfirm = await Administrators.CanConfirmAsync(userId, CancellationToken.None);
        _twoFactorOn = await TwoFactor.IsEnabledAsync(userId, CancellationToken.None);
    }

    /// <summary>On the circuit, which the throttle on sending bounds, because hub traffic never reaches the limiter.</summary>
    private async Task SendVerificationAsync() =>
        _sendResult = await Verification.SendAsync(_userId, CancellationToken.None);

    private string Describe(LegalAcceptanceRecord acceptance) =>
        string.Format(
            CultureInfo.CurrentCulture,
            Strings.AccountDocumentAccepted,
            acceptance.Document == LegalDocument.TermsOfUse ? Strings.LegalTermsOfUseTitle : Strings.LegalRiskDisclosureTitle,
            acceptance.Version,
            Time.Format(acceptance.AcceptedAt));
}
