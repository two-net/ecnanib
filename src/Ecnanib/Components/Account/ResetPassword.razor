@page "/reset-password"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(RateLimits.Authentication)]
@using System.Globalization
@inject IAccounts Accounts
@inject IPasswordResets PasswordResets
@inject NavigationManager Navigation

<PageTitle>@Strings.ResetPasswordPageTitle</PageTitle>

<div class="page form-page">
    <h1>@Strings.ResetPasswordHeading</h1>

    @if (!_live)
    {
        <p class="form-error" role="alert">@Strings.ResetPasswordLinkInvalid</p>
        <p><a href="/forgot-password">@Strings.ResetPasswordRequestNew</a></p>
    }
    else
    {
        <p>@Strings.ResetPasswordIntro</p>

        @* No action, so the post goes back to this address, token and all. Showing the form uses nothing,
           so a mail scanner that opens the link can't spend it. *@
        <EditForm Model="Input" FormName="reset-password" OnSubmit="SubmitAsync" class="form">
            <div class="field">
                <label for="new-password">@Strings.FieldNewPassword</label>
                @* Not InputText, which would write the password back into the page after a refusal. *@
                <input id="new-password" name="Input.NewPassword" type="password" autocomplete="new-password" required
                       minlength="@Rules.PasswordMinLength" maxlength="@Rules.PasswordMaxLength"
                       aria-invalid="@Invalid(NewPasswordError)" aria-describedby="new-password-hint new-password-error" />
                <p id="new-password-hint" class="field-hint">@PasswordHint</p>
                <FieldError Id="new-password-error" Message="@NewPasswordError" />
            </div>

            <div class="field">
                <label for="confirm-password">@Strings.FieldConfirmPassword</label>
                <input id="confirm-password" name="Input.ConfirmPassword" type="password" autocomplete="new-password" required
                       aria-invalid="@Invalid(ConfirmPasswordError)" aria-describedby="confirm-password-error" />
                <FieldError Id="confirm-password-error" Message="@ConfirmPasswordError" />
            </div>

            <button type="submit" class="button">@Strings.ResetPasswordSubmit</button>
        </EditForm>
    }
</div>

@code {
    private bool _live;
    private PasswordResetResult? _result;
    private bool _passwordsDiffer;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private ResetForm Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private RegistrationRules Rules => Accounts.RegistrationRules;

    private string PasswordHint => string.Format(CultureInfo.CurrentCulture, Strings.RegisterPasswordHint, Rules.PasswordMinLength);

    private string? NewPasswordError =>
        _result == PasswordResetResult.PasswordTooShort ? PasswordHint
        : _result == PasswordResetResult.PasswordTooLong ? Strings.RegisterPasswordTooLong
        : null;

    private string? ConfirmPasswordError => _passwordsDiffer ? Strings.RegisterPasswordsDiffer : null;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new ResetForm();
        _live = await PasswordResets.IsLiveAsync(Token, HttpContext.RequestAborted);
    }

    private static string? Invalid(string? error) => error is null ? null : "true";

    private async Task SubmitAsync()
    {
        if (Input.NewPassword != Input.ConfirmPassword)
        {
            _passwordsDiffer = true;
            return;
        }

        _result = await PasswordResets.ResetAsync(Token, Input.NewPassword, HttpContext.RequestAborted);

        switch (_result)
        {
            case PasswordResetResult.Reset:
                // Not SignOutAsync: whoever is signed in here may be someone else. If it was this
                // account, its session is gone, so the next request clears the cookie anyway.
                Navigation.NavigateTo("/sign-in?passwordReset=true");
                return;

            case PasswordResetResult.InvalidLink:
                _live = false;
                return;
        }
    }

    private sealed class ResetForm
    {
        public string NewPassword { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
