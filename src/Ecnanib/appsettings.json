{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Binance.Net": "Warning",
      "CryptoExchange.Net": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Exchange": {
    "RequestTimeoutSeconds": 15,
    "ReceiveWindowMs": 5000,
    "ReconciliationIntervalSeconds": 60,
    "Production": {
      "SpotRest": "https://api.binance.com",
      "SpotStreams": "wss://stream.binance.com:9443/",
      "SpotWsApi": "wss://ws-api.binance.com:443/",
      "FuturesRest": "https://fapi.binance.com",
      "FuturesStreams": "wss://fstream.binance.com/",
      "FuturesWsApi": "wss://ws-fapi.binance.com/"
    },
    "Testnet": {
      "SpotRest": "https://testnet.binance.vision",
      "SpotStreams": "wss://stream.testnet.binance.vision",
      "SpotWsApi": "wss://ws-api.testnet.binance.vision",
      "FuturesRest": "https://demo-fapi.binance.com",
      "FuturesStreams": "wss://demo-fstream.binance.com/",
      "FuturesWsApi": null
    },
    "Streams": {
      "NoDataTimeoutSeconds": 120,
      "ReconnectInitialDelaySeconds": 2,
      "ReconnectMaxDelaySeconds": 60,
      "CandleCloseGraceSeconds": 3,
      "LateCloseGraceSeconds": 10,
      "PricePollIntervalSeconds": 5,
      "MarkPricePollIntervalSeconds": 15,
      "MarkPriceUpdateIntervalMs": 3000,
      "UserDataPollIntervalSeconds": 10
    },
    "Retry": {
      "MaxAttempts": 3,
      "BaseDelayMs": 500,
      "MaxDelayMs": 10000,
      "MaxRetryAfterWaitSeconds": 30
    }
  }
}
