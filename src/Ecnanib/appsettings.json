{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ecnanib;Username=postgres"
  },
  "Security": {
    "PasswordMinLength": 12,
    "MaxFailedSignIns": 5,
    "LockoutMinutes": 15,
    "SessionIdleTimeoutMinutes": 60,
    "SessionAbsoluteTimeoutHours": 24,
    "TrustedProxies": [],
    "RateLimits": {
      "RequestsPerMinute": 300,
      "AuthenticationRequestsPerMinute": 10
    }
  },
  "Admin": {
    "AdminEmails": []
  },
  "Email": {
    "Enabled": false
  },
  "Legal": {
    "BlockedCountries": []
  },
  "Logging": {
    "MinimumLevel": "Information",
    "Overrides": {
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Sinks": {
      "Console": { "Enabled": true },
      "File": {
        "Enabled": true,
        "Path": "logs/ecnanib-.log",
        "RollingInterval": "Day",
        "RetainedFileCount": 14
      },
      "Database": {
        "Enabled": true,
        "MinimumLevel": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
