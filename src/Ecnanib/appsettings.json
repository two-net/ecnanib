{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ecnanib;Username=postgres"
  },
  "Security": {
    "PasswordMinLength": 12,
    "MaxFailedSignIns": 5,
    "LockoutMinutes": 15,
    "SessionIdleTimeoutMinutes": 60,
    "SessionAbsoluteTimeoutHours": 24,
    "CredentialRevalidationHours": 24,
    "TrustedProxies": [],
    "RateLimits": {
      "RequestsPerMinute": 300,
      "AuthenticationRequestsPerMinute": 10
    }
  },
  "Admin": {
    "AdminEmails": []
  },
  "Email": {
    "Enabled": false
  },
  "Legal": {
    "BlockedCountries": []
  },
  "Binance": {
    "Spot": {
      "LiveBaseUrl": "https://api.binance.com",
      "DemoBaseUrl": "https://demo-api.binance.com"
    },
    "Futures": {
      "LiveBaseUrl": "https://fapi.binance.com",
      "DemoBaseUrl": "https://demo-fapi.binance.com"
    },
    "MarketDataBaseUrl": "https://data-api.binance.vision",
    "RecvWindowMs": 5000,
    "ProtectiveRecvWindowMs": 2000,
    "WeightHeadroomPercent": 30,
    "ExchangeInfoRefreshHours": 24,
    "ReconcileIntervalSeconds": 60
  },
  "AiProviders": {
    "Anthropic": { "BaseUrl": "https://api.anthropic.com" },
    "Google": { "BaseUrl": "https://generativelanguage.googleapis.com" },
    "OpenAI": { "BaseUrl": "https://api.openai.com" },
    "xAI": { "BaseUrl": "https://api.x.ai" }
  },
  "Catalog": {
    "SyncIntervalHours": 12,
    "RetireAfterMissingDays": 7,
    "Overrides": []
  },
  "RoleDefaults": {
    "TechnicalAnalyst": "Google",
    "SentimentAnalyst": "xAI",
    "Strategist": "OpenAI",
    "RiskCritic": "Anthropic",
    "Reviewer": "Google"
  },
  "Agents": {
    "MaxAgentsPerUser": 10,
    "CandleCloseDelaySeconds": 10,
    "MaxConcurrentCycles": 50,
    "MaxCycleJitterSeconds": 10,
    "CatchUpGraceMinutes": { "15m": 5, "1H": 15, "4H": 60, "1D": 180 },
    "CycleDeadlineMinutes": { "15m": 3, "1H": 10, "4H": 20, "1D": 30 },
    "CycleErrorsBeforePause": 3,
    "PendingEntryCheckSeconds": 5,
    "ProtectiveStopSeconds": 9,
    "MaxLimitTtlCandles": 10
  },
  "RiskCaps": {
    "MaxLeverage": 5,
    "MaxRiskPerTradePercent": 2,
    "MinLiquidationBufferMultiple": 2,
    "MinRewardToRisk": 1.0
  },
  "Ui": {
    "DefaultTheme": "System",
    "DefaultAnimation": "System"
  },
  "Logging": {
    "MinimumLevel": "Information",
    "Overrides": {
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Sinks": {
      "Console": { "Enabled": true },
      "File": {
        "Enabled": true,
        "Path": "logs/ecnanib-.log",
        "RollingInterval": "Day",
        "RetainedFileCount": 14
      },
      "Database": {
        "Enabled": true,
        "MinimumLevel": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
