<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- EXT-UI-02. Generates the Strings class at build time, so a missing key doesn't compile. -->
  <ItemGroup>
    <EmbeddedResource Update="Components\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Ecnanib.Components</StronglyTypedNamespace>
      <StronglyTypedManifestPrefix>Ecnanib.Components</StronglyTypedManifestPrefix>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.g.cs</StronglyTypedFileName>
    </EmbeddedResource>
    <!-- Identity can't use Strings, which is the Web UI's, so the email it sends has its own file. -->
    <EmbeddedResource Update="Modules\Identity\Emails.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Ecnanib.Modules.Identity</StronglyTypedNamespace>
      <StronglyTypedManifestPrefix>Ecnanib.Modules.Identity</StronglyTypedManifestPrefix>
      <StronglyTypedClassName>Emails</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Emails.g.cs</StronglyTypedFileName>
    </EmbeddedResource>
    <!-- The same for Notifications, under a file name of its own so the two don't overwrite each other. -->
    <EmbeddedResource Update="Modules\Notifications\Emails.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Ecnanib.Modules.Notifications</StronglyTypedNamespace>
      <StronglyTypedManifestPrefix>Ecnanib.Modules.Notifications</StronglyTypedManifestPrefix>
      <StronglyTypedClassName>Emails</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)NotificationEmails.g.cs</StronglyTypedFileName>
    </EmbeddedResource>
    <!-- FR-PRM-04: the initial prompt templates, which PromptSeeds reads. None of their names is a culture. -->
    <EmbeddedResource Include="Modules\AiCouncil\Templates\*.md" LogicalName="Ecnanib.Prompts.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Pinned because PrivateAssets hides Design's EF version from the test project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Draws the QR code for setting up two-factor. The Web UI renders its matrix as SVG. -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
