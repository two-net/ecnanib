<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Ecnanib.styles.css"]" />
    @* The one script that is written into the page. A browser runs it only with the nonce of this answer. *@
    <ImportMap nonce="@Nonce" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@using Ecnanib.Platform.Security

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? Nonce => HttpContext is null ? null : BrowserDefenses.NonceOf(HttpContext);
}
