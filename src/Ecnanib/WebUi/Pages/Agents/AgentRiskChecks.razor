@page "/agents/{Id:guid}/risk-checks"
@attribute [Authorize]
@using Ecnanib.Accounts
@using Ecnanib.Agents
@using Ecnanib.DecisionEngine
@inject IStoredAgents Agents
@inject IRiskCheckRecords Checks
@inject NavigationManager Navigation

@*
    Rendered on the server for each request, and never interactive. The page shows what the Risk
    Guard made of the plans of an agent of the user: for each check the close of the candle that
    its cycle was for, the mode that the agent was in then, what the plan does, the verdict, and
    the outcome of every rule with why it held or did not, in plain language and with the numbers
    (FR-RSK-9, NFR-USA-2). So a user sees exactly why a plan was accepted or rejected. A check of
    a plan that opens a position says the size that the system computed for its order as well:
    its quantity, and on Futures its leverage (FR-RSK-5). The page
    has no form: nothing that is posted at it is taken, and nothing on it switches a rule off
    (FR-RSK-3). An outcome is said as words, and does not rely on a colour. The badge of the mode
    is under the heading, and each check says the mode it was made in (FR-UI-3, FR-BIN-11). A
    check of a test cycle says that it is one: whatever its verdict, it led to no order (FR-CYC-12).
    Its texts are in RiskCheckPages.
*@

@if (_agent is not null && _history is not null)
{
    <PageTitle>@RiskCheckPages.TitleOf(_agent.Name)</PageTitle>

    <h1>@RiskCheckPages.TitleOf(_agent.Name)</h1>

    <p>@RiskCheckPages.ModeLabel <ModeBadge Mode="@_agent.Mode" /> @AgentPages.TradesIn(_agent.Mode)</p>

    <p>@RiskCheckPages.Explained</p>

    <p>@RiskCheckPages.ReducingRiskExplained</p>

    @if (_history.Checks.Count == 0)
    {
        <p>@RiskCheckPages.NoneYet</p>
    }
    else if (_history.Total > _history.Checks.Count)
    {
        <p>@RiskCheckPages.LatestListed(_history.Checks.Count, _history.Total)</p>
    }
    else
    {
        <p>@RiskCheckPages.EveryListed</p>
    }

    @for (var index = 0; index < _history.Checks.Count; index++)
    {
        var check = _history.Checks[index];
        var heading = $"check-{index + 1}-heading";

        <h2 id="@heading">@Times.At(check.ClosedAt): @RiskCheckPages.Describe(check.Action)</h2>

        <p>
            <strong class="guard-verdict">@RiskCheckPages.Describe(check.Verdict)</strong>, @RiskCheckPages.MadeIn <ModeBadge Mode="@check.Mode" />, @RiskCheckPages.ForCandle(Times.At(check.ClosedAt), check.Kind).
            @RiskCheckPages.Explain(check)
        </p>

        @* The size that the check computed, and every rule with its outcome and why. *@
        <RiskCheckRules Check="@check" LabelledBy="@heading" />

        @* The cycle that the check was made in, with what its team was given and answered (FR-CYC-10). *@
        <p><a href="@WebUiModule.AgentCyclePath(_agent.Id, check.CycleId)">@CyclePages.TimelineOfCheckLink</a></p>
    }

    <p><a href="@WebUiModule.AgentCyclesPath(_agent.Id)">@CyclePages.Link</a></p>

    <p><a href="@WebUiModule.AgentStatePath(_agent.Id)">@RiskCheckPages.StateLink</a></p>

    <p><a href="@WebUiModule.AgentPath(_agent.Id)">@RiskCheckPages.SettingsLink</a></p>

    <p><a href="@WebUiModule.AgentsPath">@RiskCheckPages.BackToAgents</a></p>
}

@code {
    /// <summary>The times of the page: every time is written in its time zone (NFR-USA-3). See docs/times.md.</summary>
    [CascadingParameter]
    private PageTimes Times { get; set; } = PageTimes.Utc;

    private AgentView? _agent;
    private RiskCheckHistory? _history;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        // The agent that the path names, among those of the user of the session. An agent of
        // another user is not found, like one that does not exist: a user reads the checks of
        // their own agents.
        _agent = await Agents.FindAsync(request, Id);

        if (_agent is null)
        {
            Navigation.NotFound();

            return;
        }

        // The Decision Engine may not use Accounts, so it is handed the user who is signed in,
        // and asks for the checks of that user alone.
        _history = await Checks.LatestAsync(SignedInUser.RequiredIdOf(request), _agent.Id, request.RequestAborted);
    }
}
