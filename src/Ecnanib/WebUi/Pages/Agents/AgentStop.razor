@page "/agents/{Id:guid}/stop"
@attribute [Authorize]
@using Ecnanib.Agents
@using Ecnanib.Shared
@inject IStoredAgents Agents
@inject IAgentControls Controls
@inject NavigationManager Navigation

@*
    Rendered on the server for each request, and never interactive. The page stops an agent of
    the user. When the agent has an open position, its user chooses here whether the position is
    closed at market or kept with its protective orders: neither is chosen for them, and StopAsync
    stops no agent that has a position without the choice (FR-AGT-11). The form is on the page
    whenever one is posted, whatever state the agent is in by then: a form that is sent twice
    finds the agent stopped the second time, and is answered as the first one was. Its texts are
    in AgentStatePages and AgentPages.
*@

@if (_agent is not null)
{
    <PageTitle>@AgentStatePages.StopTitle(_agent.Name)</PageTitle>

    <h1>@AgentStatePages.StopTitle(_agent.Name)</h1>

    <p>@AgentPages.ModeLabel <ModeBadge Mode="@_agent.Mode" /> @AgentPages.TradesIn(_agent.Mode)</p>

    @if (_said is not null)
    {
        @* What it says of the choice is named by the choice below, so it is read out with it. *@
        <p class="form-error" role="alert" id="@(_said == AgentStatePages.ChoosePositionFirst ? "stop-position-error" : null)">@_said</p>
    }

    @if (_notClosed)
    {
        <p><a href="@WebUiModule.CloseAgentPositionPath(_agent.Id)">@AgentPages.ClosePositionNow</a></p>
    }
    else if (_showForm)
    {
        <p>@AgentPages.Explain(AgentControl.Stop)</p>

        @if (_agent.Mode == TradingMode.Live)
        {
            <p><strong>@AgentPages.ActsOnLive</strong></p>
        }

        <form method="post" @formname="@AgentPages.StopForm" @onsubmit="StopAsync">
            <AntiforgeryToken />

            @if (_agent.HasOpenPosition)
            {
                <fieldset aria-describedby="@(_said == AgentStatePages.ChoosePositionFirst ? "stop-position-error" : null)">
                    <legend>@AgentStatePages.PositionLegend</legend>

                    <div class="choice">
                        <input id="stop-close" type="radio" name="Position" value="@AgentPages.ClosePosition" required
                               checked="@(PositionEntry == AgentPages.ClosePosition)" aria-describedby="stop-close-hint" />
                        <label for="stop-close">@AgentStatePages.CloseAtMarketLabel</label>
                        <p id="stop-close-hint" class="field-hint">@AgentStatePages.CloseAtMarketHint</p>
                    </div>

                    <div class="choice">
                        <input id="stop-keep" type="radio" name="Position" value="@AgentPages.KeepPosition" required
                               checked="@(PositionEntry == AgentPages.KeepPosition)" aria-describedby="stop-keep-hint" />
                        <label for="stop-keep">@AgentStatePages.KeepPositionLabel</label>
                        <p id="stop-keep-hint" class="field-hint">@AgentStatePages.KeepPositionHint</p>
                    </div>
                </fieldset>
            }
            else
            {
                <p>@AgentStatePages.NoOpenPosition</p>
            }

            <button type="submit">@AgentPages.Describe(AgentControl.Stop)</button>
        </form>
    }
    else if (_said is null)
    {
        <p role="status">@NotNow(_agent)</p>
    }

    <p><a href="@WebUiModule.AgentStatePath(_agent.Id)">@(_showForm && !_notClosed ? AgentStatePages.KeepAsItIs : AgentPages.StateLink)</a></p>
}

@code {
    private AgentView? _agent;
    private string? _said;
    private bool _showForm;
    private bool _notClosed;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>What was chosen for the open position: <c>close</c> or <c>keep</c>.</summary>
    [SupplyParameterFromForm(Name = "Position")]
    private string? PositionEntry { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        // The agent that the path names, among those of the user of the session. An agent of
        // another user is not found, like one that does not exist.
        _agent = await Agents.FindAsync(request, Id);

        if (_agent is null)
        {
            Navigation.NotFound();

            return;
        }

        // A form that was posted is answered by StopAsync, whatever state the agent is in now.
        _showForm = !HttpMethods.IsGet(request.Request.Method)
            || AgentStates.After(_agent.State, AgentControl.Stop) is not null;
    }

    private async Task StopAsync()
    {
        if (HttpContext is not { } request || _agent is null)
        {
            return;
        }

        PositionAtStop? choice = PositionEntry switch
        {
            AgentPages.ClosePosition => PositionAtStop.Close,
            AgentPages.KeepPosition => PositionAtStop.Keep,
            _ => null,
        };

        var result = await Controls.StopAsync(request, Id, choice);

        switch (result.Outcome)
        {
            case StopAgentOutcome.Stopped when result.Close == PositionCloseOutcome.Failed:
                // The agent is stopped, and its position is not closed. It is said here, with
                // the control that closes it: the page of the state would not say it.
                _said = AgentStatePages.StoppedNotClosed;
                _notClosed = true;
                _agent = await Agents.FindAsync(request, Id) ?? _agent;
                break;

            case StopAgentOutcome.Stopped:
                // The page that says what state the agent is in now. A reload of it stops nothing again.
                Navigation.NavigateTo(WebUiModule.AgentStatePath(Id));
                break;

            case StopAgentOutcome.ChoiceNeeded:
                // The agent has a position, whatever the page showed when it was opened: the
                // form comes back with the choice.
                _said = AgentStatePages.ChoosePositionFirst;
                _agent = await Agents.FindAsync(request, Id) ?? _agent;
                break;

            case StopAgentOutcome.NotOffered:
                _said = AgentPages.NotOffered(AgentControl.Stop, _agent.State);
                _showForm = false;
                break;

            default:
                // The agent was deleted, on another browser, since the page was shown.
                _agent = null;
                Navigation.NotFound();
                break;
        }
    }

    private static string NotNow(AgentView agent) => agent.State == AgentState.Stopped
        ? AgentStatePages.AlreadyStopped
        : AgentPages.NotOffered(AgentControl.Stop, agent.State);
}
