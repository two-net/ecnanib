@page "/agents/{Id:guid}/cycles"
@attribute [Authorize]
@using Ecnanib.Accounts
@using Ecnanib.Agents
@using Ecnanib.DecisionEngine
@using Ecnanib.Platform.LiveUpdates
@using Ecnanib.Shared
@inject IStoredAgents Agents
@inject IRecordedCycles Cycles
@inject ILiveSignals Live
@inject NavigationManager Navigation

@*
    Rendered on the server for each request. The page lists the cycles
    that were recorded for an agent of the user, latest close first: for each the close of the
    candle that it was for, the mode that the agent was in then, how it ended, in words, and how
    long it took (FR-CYC-10). A cycle that made no decision, or placed no order, is among them.
    Each says what started it: a test cycle, which its user ran, is told apart from the cycles
    that a candle close started (FR-CYC-12). Each leads to its timeline. The page has no form: a
    test cycle is run on a page of its own, which this one leads to. The badge of the mode is
    under the heading, and each cycle says the mode it ran in (FR-UI-3, FR-BIN-11). The page
    follows what changes (FR-NTF-2): a cycle that runs says its steps here as it comes to them,
    over the connection of the page, and when a cycle is recorded the page asks for itself
    again, so the cycle is on the list without a manual refresh. See docs/live-updates.md. Its
    texts are in CyclePages.
*@

@if (_agent is not null && _history is not null)
{
    <PageTitle>@CyclePages.TitleOf(_agent.Name)</PageTitle>

    <h1 id="cycles-heading">@CyclePages.TitleOf(_agent.Name)</h1>

    <p>@CyclePages.ModeLabel <ModeBadge Mode="@_agent.Mode" /> @AgentPages.TradesIn(_agent.Mode)</p>

    @* That the page follows what changes, with what pauses it: see LivePause (NFR-USA-1). *@
    <LivePause />

    <p>@CyclePages.Explained</p>

    <p>@CyclePages.TestsListed <a href="@WebUiModule.AgentTestCyclePath(_agent.Id)">@CyclePages.TestLink</a></p>

    @* The cycles that run now, which are on no list until they are recorded. *@
    <LiveUpdates AgentId="@_agent.Id" Follows="@Followed" Shows="@LiveShows.Cycle" Since="@_since" />

    @if (_history.Cycles.Count == 0)
    {
        <p>@CyclePages.NoneYet</p>
    }
    else
    {
        @if (_history.Total > _history.Cycles.Count)
        {
            <p>@CyclePages.LatestListed(_history.Cycles.Count, _history.Total)</p>
        }
        else
        {
            <p>@CyclePages.EveryListed</p>
        }

        @* The table scrolls by itself on a narrow screen, also by keyboard, as the list of agents does. *@
        <div class="agents agent-cycles" role="region" aria-labelledby="cycles-heading" tabindex="0">
            <table>
                <caption>@CyclePages.ListCaption</caption>
                <thead>
                    <tr>
                        <th scope="col">@CyclePages.CandleCloseHeading</th>
                        <th scope="col">@CyclePages.KindHeading</th>
                        <th scope="col">@CyclePages.ModeHeading</th>
                        <th scope="col">@CyclePages.OutcomeHeading</th>
                        <th scope="col">@CyclePages.MeaningHeading</th>
                        <th scope="col">@CyclePages.TookHeading</th>
                        <th scope="col">@CyclePages.RecordHeading</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cycle in _history.Cycles)
                    {
                        <tr data-key="@cycle.Id">
                            <th scope="row">@Times.At(cycle.ClosedAt)</th>
                            <td><span class="cycle-kind cycle-kind-@(cycle.Kind.ToString().ToLowerInvariant())">@CyclePages.Describe(cycle.Kind)</span></td>
                            <td><ModeBadge Mode="@cycle.Mode" /></td>
                            <td><span class="cycle-outcome cycle-@(cycle.Outcome.ToString().ToLowerInvariant())">@CyclePages.Describe(cycle.Outcome)</span></td>
                            <td>@CyclePages.Explain(cycle.Outcome, cycle.Kind)</td>
                            <td>@CyclePages.Seconds(cycle.EndedAt - cycle.StartedAt)</td>
                            <td><a href="@WebUiModule.AgentCyclePath(_agent.Id, cycle.Id)">@CyclePages.TimelineLink</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <p><a href="@WebUiModule.AgentStatePath(_agent.Id)">@CyclePages.StateLink</a></p>

    <p><a href="@WebUiModule.AgentRiskChecksPath(_agent.Id)">@RiskCheckPages.Link</a></p>

    <p><a href="@WebUiModule.AgentPath(_agent.Id)">@CyclePages.SettingsLink</a></p>

    <p><a href="@WebUiModule.AgentsPath">@CyclePages.BackToAgents</a></p>
}

@code {
    /// <summary>The times of the page: every time is written in its time zone (NFR-USA-3). See docs/times.md.</summary>
    [CascadingParameter]
    private PageTimes Times { get; set; } = PageTimes.Utc;

    // What the page asks for itself again on: a cycle that is recorded, the agent, whose mode
    // the badge says, and the count in the bar.
    private static readonly LiveSubject[] Followed = [LiveSubject.Cycle, LiveSubject.Agent, LiveSubject.Notification];

    private AgentView? _agent;
    private CycleHistory? _history;
    private long _since;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        // An address that makes a choice of following which there is not has no page, as one
        // with a page number that is none has not: see LivePause.
        if (LivePages.PausedOf(request.Request.Query) is null)
        {
            Navigation.NotFound();

            return;
        }

        // Before the page reads: what changes from here on is what the page may not show.
        _since = Live.Mark();

        // The agent that the path names, among those of the user of the session. An agent of
        // another user is not found, like one that does not exist: a user reads the cycles of
        // their own agents.
        _agent = await Agents.FindAsync(request, Id);

        if (_agent is null)
        {
            Navigation.NotFound();

            return;
        }

        // The Decision Engine may not use Accounts, so it is handed the user who is signed in,
        // and asks for the cycles of that user alone.
        _history = await Cycles.LatestAsync(SignedInUser.RequiredIdOf(request), _agent.Id, request.RequestAborted);
    }
}
