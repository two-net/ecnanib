@attribute [Route(WebUiModule.AgentsPath)]
@attribute [Authorize]
@using Ecnanib.Agents
@using Ecnanib.Platform.LiveUpdates
@using Ecnanib.Shared
@inject IStoredAgents Agents
@inject ILiveSignals Live
@inject NavigationManager Navigation

@*
    Rendered on the server for each request. The page lists the agents of
    the user who is signed in, and no others (FR-AGT-1). A form of the page makes a copy of an
    agent: the forms are on the page whenever one is posted, for the agents that are stored then.
    Each agent leads to the page of its state, where it is started, paused, resumed, and stopped,
    and an agent that has an open position leads to the page that closes it (FR-AGT-12). The
    states are explained under the table (NFR-USA-2). Each agent has the badge of its mode
    (FR-UI-3). What a user named an agent is written as text, like everything else on a page.
    The page follows what changes: when an agent of its user, what one holds, or a notification
    of theirs changes, it asks for itself again, so the states and the way to close a position
    are those of now without a manual refresh (FR-NTF-2). See docs/live-updates.md. Its texts
    are in AgentPages.
*@

<PageTitle>@AgentPages.ListTitle</PageTitle>

<h1 id="agents-heading">@AgentPages.ListTitle</h1>

<p>@AgentPages.ListExplained</p>

@* That the page follows what changes, with what pauses it: see LivePause (NFR-USA-1). *@
<LivePause />

@if (_notCopied is not null)
{
    <p class="form-error" role="alert">@_notCopied</p>
}

@if (_list is not null)
{
    @if (_list.Agents.Count == 0)
    {
        <p>@AgentPages.NoAgentYet</p>
    }
    else
    {
        @* The table is wider than a narrow screen, so it scrolls by itself, also by keyboard. *@
        <div class="agents" role="region" aria-labelledby="agents-heading" tabindex="0">
            <table>
                <caption>@AgentPages.ListTitle</caption>
                <thead>
                    <tr>
                        <th scope="col">@AgentPages.Label(AgentField.Name)</th>
                        <th scope="col">@AgentPages.ModeHeading</th>
                        <th scope="col">@AgentPages.Label(AgentField.Market)</th>
                        <th scope="col">@AgentPages.Label(AgentField.Symbol)</th>
                        <th scope="col">@AgentPages.Label(AgentField.Timeframe)</th>
                        <th scope="col">@AgentPages.CapitalHeading</th>
                        <th scope="col">@AgentPages.StateHeading</th>
                        <th scope="col">@AgentPages.ActionsHeading</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var agent in _list.Agents)
                    {
                        @* Its key and its state by name, for what moves: a row that enters, and a state that changed. See docs/motion.md. *@
                        <tr data-key="@agent.Id" data-change="@agent.State">
                            <th scope="row"><a href="@WebUiModule.AgentPath(agent.Id)">@agent.Name</a></th>
                            <td><ModeBadge Mode="@agent.Mode" /></td>
                            <td>@AgentPages.NameOf(agent.Market)</td>
                            <td><code>@agent.Symbol</code></td>
                            <td>@agent.Timeframe.Code()</td>
                            <td>@AgentPages.Capital(agent)</td>
                            <td>@AgentPages.Describe(agent.State)</td>
                            <td>
                                @* Named after the agent, so that each control says what it is for by itself. *@
                                <a href="@WebUiModule.AgentStatePath(agent.Id)">@AgentPages.StateOf(agent.Name)</a>
                                @if (agent.HasOpenPosition)
                                {
                                    <a href="@WebUiModule.CloseAgentPositionPath(agent.Id)">@AgentPages.ClosePositionNowFor(agent.Name)</a>
                                }
                                <form method="post" @formname="@AgentPages.CloneForm(agent.Id)" @onsubmit="() => CloneAsync(agent)">
                                    <AntiforgeryToken />

                                    <button type="submit">@AgentPages.CopyOf(agent.Name)</button>
                                </form>
                                <a href="@WebUiModule.DeleteAgentPath(agent.Id)">@AgentPages.DeleteOf(agent.Name)</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h2>@AgentPages.StatesHeading</h2>

        <AgentStateMeanings />
    }

    <p>@AgentPages.Counted(_list.Agents.Count, _list.MaxAgents)</p>

    @if (AgentPages.Says(_list.Creation, _list.MaxAgents) is { } notNow)
    {
        <p role="status">@notNow</p>
    }
    else
    {
        <p><a href="@WebUiModule.NewAgentPath">@AgentPages.CreateLink</a></p>
    }

    <LiveUpdates Follows="@Followed" Since="@_since" />
}

@code {
    // What the page asks for itself again on: an agent, what one holds, and the count in the bar.
    private static readonly LiveSubject[] Followed = [LiveSubject.Agent, LiveSubject.Holdings, LiveSubject.Notification];

    private StoredAgentList? _list;
    private string? _notCopied;
    private long _since;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        // An address that makes a choice of following which there is not has no page, as one
        // with a page number that is none has not: see LivePause.
        if (LivePages.PausedOf(request.Request.Query) is null)
        {
            Navigation.NotFound();

            return;
        }

        // Before the page reads: what changes from here on is what the page may not show.
        _since = Live.Mark();

        _list = await Agents.ListAsync(request);
    }

    private async Task CloneAsync(AgentView agent)
    {
        if (HttpContext is not { } request || _list is null)
        {
            return;
        }

        var result = await Agents.CloneAsync(request, agent.Id);

        if (result is { Outcome: SaveAgentOutcome.Saved, AgentId: { } copyId })
        {
            // The page of the copy, where it is given a name of its own. A reload of it copies
            // nothing again.
            Navigation.NavigateTo(WebUiModule.AgentPath(copyId));

            return;
        }

        // Nothing was copied. The list is shown as it is now, with why.
        _notCopied = AgentPages.SaysOfCopy(result.Outcome, _list.MaxAgents);
        _list = await Agents.ListAsync(request);
    }
}
