@page "/agents/{Id:guid}/cycles/{CycleId:guid}"
@attribute [Authorize]
@using Ecnanib.Accounts
@using Ecnanib.Agents
@using Ecnanib.DecisionEngine
@using Ecnanib.Platform.LiveUpdates
@using Ecnanib.Shared
@inject IStoredAgents Agents
@inject IRecordedCycles Cycles
@inject ILiveSignals Live
@inject NavigationManager Navigation

@*
    Rendered on the server for each request. The page shows one cycle of an
    agent of the user as a timeline (FR-CYC-10): the close of its candle, its start, the summary of
    its data package, every call of a role with what it answered, what the Risk Guard made of the
    plan with the outcome of every rule, the orders that the cycle placed, or why it placed none,
    and how it ended. Each entry says when it happened, to the second, and everything is explained
    in plain language (NFR-USA-2). An outcome is said as words, and does not rely on a colour. The
    page has no form: a user reads the record of a cycle, and changes none. The badge of the mode
    of the agent is under the heading, and the cycle says the mode it ran in (FR-UI-3, FR-BIN-11).
    A test cycle, which its user ran, says so under the heading, and that it placed no orders
    (FR-CYC-12). It is run at any time after the close of its candle, so its entries say how long
    after its start they happened. An order is shown as it is now, so the page follows what the
    agent holds (FR-NTF-2): when an order of the agent changes, the page asks for itself again.
    Nothing is written to it over its connection. See docs/live-updates.md. Its texts are in
    CyclePages.
*@

@if (_agent is not null && _cycle is not null)
{
    <PageTitle>@CyclePages.TimelineTitleOf(_agent.Name)</PageTitle>

    <h1>@CyclePages.TimelineTitleOf(_agent.Name)</h1>

    <p>@CyclePages.ModeLabel <ModeBadge Mode="@_agent.Mode" /> @AgentPages.TradesIn(_agent.Mode)</p>

    @* That the page follows what changes, with what pauses it: see LivePause (NFR-USA-1). *@
    <LivePause />

    @if (IsTest)
    {
        <p class="cycle-kind cycle-kind-test"><strong>@CyclePages.TestLabel</strong> @CyclePages.TestCycleRan</p>
    }

    <p>
        @CyclePages.TimelineOf(Times.At(_cycle.ClosedAt)) <ModeBadge Mode="@_cycle.Mode" />. @CyclePages.OutcomeLabel
        <strong class="cycle-outcome cycle-@(_cycle.Outcome.ToString().ToLowerInvariant())">@CyclePages.Describe(_cycle.Outcome)</strong>.
        @CyclePages.Explain(_cycle.Outcome, _cycle.Kind)
    </p>

    <p>@CyclePages.TimelineExplained</p>

    @* It is a list also where its look hides the numbers: a screen reader says how many entries it has. *@
    <ol class="timeline" role="list">
        @foreach (var entry in _entries)
        {
            <li class="timeline-entry timeline-@entry.Kind">
                @if (entry.Timed)
                {
                    <p class="timeline-time">@Times.AtSecond(entry.At), @After(entry)</p>
                }

                @switch (entry.What)
                {
                    case Closed:
                        <h2>@CyclePages.CandleClosedHeading</h2>

                        <p>
                            @(_cycle.DataPackage is { } closed
                                ? CyclePages.CandleClosed(closed)
                                : CyclePages.CandleOfCycleClosed)
                            @(IsTest
                                ? CyclePages.TestDecidesOnClosedCandles
                                : CyclePages.DecidesOnClosedCandles)
                        </p>

                        break;

                    case Started:
                        @if (IsTest)
                        {
                            <h2>@CyclePages.TestStartedHeading</h2>

                            <p>@CyclePages.TestStarted</p>
                        }
                        else
                        {
                            <h2>@CyclePages.StartedHeading</h2>

                            <p>@CyclePages.Started</p>
                        }

                        break;

                    case DataPackageSummary package:
                        <h2 id="package-heading">@CyclePages.PackageHeading</h2>

                        <p>@CyclePages.PackageExplained</p>

                        <p class="package-agent">@CyclePages.Says(package)</p>

                        <p class="package-limits">@CyclePages.Limits(package)</p>

                        @* The table scrolls by itself on a narrow screen, also by keyboard, as the list of agents does. *@
                        <div class="agents package-series" role="region" aria-labelledby="package-heading" tabindex="0">
                            <table>
                                <caption>@CyclePages.PackageCaption</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">@CyclePages.LatestCloseHeading</th>
                                        @foreach (var series in package.Series)
                                        {
                                            <th scope="col">@CyclePages.CandlesOf(series.Timeframe)</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var (name, value) in Measures)
                                    {
                                        <tr>
                                            <th scope="row">@name</th>
                                            @foreach (var series in package.Series)
                                            {
                                                <td>@value(series, Times)</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (package.Orders.Count == 0)
                        {
                            <p class="package-orders">@CyclePages.NoOpenOrders</p>
                        }
                        else
                        {
                            <p class="package-orders">@CyclePages.OpenOrdersLabel</p>

                            <ul>
                                @foreach (var resting in package.Orders)
                                {
                                    <li>@CyclePages.Says(resting)</li>
                                }
                            </ul>
                        }

                        @if (package.Futures is { } futures)
                        {
                            <p class="package-futures">@CyclePages.Says(futures, Times)</p>
                        }

                        break;

                    case NoPackage:
                        <h2>@CyclePages.PackageHeading</h2>

                        <p>@CyclePages.NoPackage(_cycle.Outcome)</p>

                        break;

                    case RoleCallView call:
                        <h2>@CyclePages.Title(call)</h2>

                        <p>@AgentPages.Describe(call.Role).Job @CyclePages.CalledWith(call)</p>

                        @* How it ended and what it answered, as the screen of the agent shows it too. *@
                        <RoleCallAnswer Call="@call" />

                        <p class="call-usage">@CyclePages.Usage(call)</p>

                        @if (call.Templates.Count > 0)
                        {
                            <p class="call-templates">@CyclePages.ComposedFrom(call.Templates)</p>
                        }

                        break;

                    case RiskCheckView check:
                        var heading = $"check-{entry.Number}-heading";

                        <h2 id="@heading">@CyclePages.CheckHeading(check.Action)</h2>

                        <p>
                            <strong class="guard-verdict">@RiskCheckPages.Describe(check.Verdict)</strong>.
                            @RiskCheckPages.Explain(check)
                        </p>

                        <RiskCheckRules Check="@check" LabelledBy="@heading" />

                        break;

                    case CycleOrderView order:
                        <h2>@CyclePages.Describe(order.Purpose)</h2>

                        <p>@CyclePages.Says(order)</p>

                        <p>
                            <strong class="order-status">@CyclePages.Describe(order.Status)</strong>, @CyclePages.AsItIsNow.
                            @CyclePages.Became(order)
                        </p>

                        <p class="order-ids">@CyclePages.Identifiers(order)</p>

                        break;

                    case NoOrder:
                        <h2>@CyclePages.NoOrderHeading</h2>

                        <p class="no-order">@CyclePages.NoOrder(_cycle)</p>

                        break;

                    case Ended:
                        <h2>@CyclePages.EndedHeading(_cycle.Kind, _cycle.Outcome)</h2>

                        <p>@CyclePages.Explain(_cycle.Outcome, _cycle.Kind) @CyclePages.RanFor(_cycle.EndedAt - _cycle.StartedAt)</p>

                        break;
                }
            </li>
        }
    </ol>

    <p><a href="@WebUiModule.AgentCyclesPath(_agent.Id)">@CyclePages.Link</a></p>

    <p><a href="@WebUiModule.AgentStatePath(_agent.Id)">@CyclePages.StateLink</a></p>

    <p><a href="@WebUiModule.AgentRiskChecksPath(_agent.Id)">@RiskCheckPages.Link</a></p>

    <p><a href="@WebUiModule.AgentPath(_agent.Id)">@CyclePages.SettingsLink</a></p>

    <p><a href="@WebUiModule.AgentsPath">@CyclePages.BackToAgents</a></p>

    <LiveUpdates AgentId="@_agent.Id" Follows="@Followed" Since="@_since" />
}

@code {
    /// <summary>The times of the page: every time is written in its time zone (NFR-USA-3). See docs/times.md.</summary>
    [CascadingParameter]
    private PageTimes Times { get; set; } = PageTimes.Utc;

    // What the table of a data package says of each series, row by row: the candles that the
    // package held, the latest of them, and the indicators at its close.
    private static readonly (string Name, Func<SeriesSummary, PageTimes, string> Value)[] Measures =
    [
        (CyclePages.PackageCandles, (series, times) => AgentPages.Number(series.Candles)),
        (CyclePages.PackageThrough, (series, times) => series.Latest is { } latest ? times.At(latest.ClosedAt) : CyclePages.NoClosedCandle),
        (CyclePages.LatestOpen, (series, times) => CyclePages.Value(series.Latest?.Open)),
        (CyclePages.LatestHigh, (series, times) => CyclePages.Value(series.Latest?.High)),
        (CyclePages.LatestLow, (series, times) => CyclePages.Value(series.Latest?.Low)),
        (CyclePages.LatestClose, (series, times) => CyclePages.Value(series.Latest?.Close)),
        (CyclePages.LatestVolume, (series, times) => CyclePages.Value(series.Latest?.Volume)),
        (CyclePages.ComputedFrom, (series, times) => AgentPages.Number(series.ComputedFrom)),
        (CyclePages.Sma20, (series, times) => CyclePages.Indicator(series.Indicators.Sma20)),
        (CyclePages.Sma50, (series, times) => CyclePages.Indicator(series.Indicators.Sma50)),
        (CyclePages.Sma200, (series, times) => CyclePages.Indicator(series.Indicators.Sma200)),
        (CyclePages.Ema20, (series, times) => CyclePages.Indicator(series.Indicators.Ema20)),
        (CyclePages.Ema50, (series, times) => CyclePages.Indicator(series.Indicators.Ema50)),
        (CyclePages.Rsi14, (series, times) => CyclePages.Indicator(series.Indicators.Rsi14)),
        (CyclePages.Atr14, (series, times) => CyclePages.Indicator(series.Indicators.Atr14)),
        (CyclePages.VolumeAverage20, (series, times) => CyclePages.Indicator(series.Indicators.VolumeAverage20)),
    ];

    // What the page asks for itself again on: what the agent holds, which its orders are, the
    // agent, whose mode the badge says, and the count in the bar.
    private static readonly LiveSubject[] Followed = [LiveSubject.Holdings, LiveSubject.Agent, LiveSubject.Notification];

    private AgentView? _agent;
    private CycleRecord? _cycle;
    private IReadOnlyList<Entry> _entries = [];
    private long _since;

    // Whether its user ran the cycle as a test, which places no order (FR-CYC-12).
    private bool IsTest => _cycle is { Kind: CycleKind.Test };

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public Guid CycleId { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        // An address that makes a choice of following which there is not has no page, as one
        // with a page number that is none has not: see LivePause.
        if (LivePages.PausedOf(request.Request.Query) is null)
        {
            Navigation.NotFound();

            return;
        }

        // Before the page reads: what changes from here on is what the page may not show.
        _since = Live.Mark();

        // The agent that the path names, among those of the user of the session. An agent of
        // another user is not found, like one that does not exist.
        _agent = await Agents.FindAsync(request, Id);

        if (_agent is null)
        {
            Navigation.NotFound();

            return;
        }

        // The Decision Engine may not use Accounts, so it is handed the user who is signed in,
        // and asks for the cycle of that user and of this agent alone. A cycle of another agent
        // is not found here either.
        _cycle = await Cycles.FindAsync(SignedInUser.RequiredIdOf(request), _agent.Id, CycleId, request.RequestAborted);

        if (_cycle is null)
        {
            Navigation.NotFound();

            return;
        }

        _entries = EntriesOf(_cycle);
    }

    /// <summary>
    /// How long after the close of the candle an entry happened. A test cycle is run at any time
    /// after that close, hours after it for a candle of a day: what happened in it says how long
    /// after its start that was, and the close of its candle stands as the close.
    /// </summary>
    private string After(Entry entry) =>
        IsTest && entry.What is not Closed
            ? CyclePages.AfterStart(_cycle!.StartedAt, entry.At)
            : CyclePages.After(_cycle!.ClosedAt, entry.At);

    /// <summary>
    /// The entries of the timeline of a cycle, in the order they happened. What happened at the
    /// same moment stands in the order of a cycle: its package, the calls of its roles, the
    /// checks of the Risk Guard, and its orders.
    /// </summary>
    private static IReadOnlyList<Entry> EntriesOf(CycleRecord cycle)
    {
        var entries = new List<Entry>
        {
            new(cycle.ClosedAt, 0, "close", Timed: true, new Closed()),
            new(cycle.StartedAt, 1, "start", Timed: true, new Started()),

            // A cycle that kept no summary says so where its package would stand, at no time of its own.
            cycle.DataPackage is { } package
                ? new(package.BuiltAt, 2, "package", Timed: true, package)
                : new(cycle.StartedAt, 2, "package", Timed: false, new NoPackage()),
        };

        entries.AddRange(cycle.Calls.Select(call => new Entry(call.CalledAt, 3, "call", Timed: true, call)));
        entries.AddRange(cycle.Checks.Select(check => new Entry(check.CheckedAt, 4, "check", Timed: true, check, check.Sequence)));
        entries.AddRange(cycle.Orders.Select(order => new Entry(order.CreatedAt, 5, "order", Timed: true, order)));

        if (cycle.Orders.Count == 0)
        {
            // Why no order was placed, before the end of the cycle, at no time of its own.
            entries.Add(new Entry(cycle.EndedAt, 6, "no-order", Timed: false, new NoOrder()));
        }

        entries.Add(new Entry(cycle.EndedAt, 7, "end", Timed: true, new Ended()));

        // A stable sort: the calls, the checks, and the orders keep the order they came in.
        return [.. entries.OrderBy(entry => entry.At).ThenBy(entry => entry.Rank)];
    }

    /// <summary>One entry of the timeline.</summary>
    /// <param name="At">When it happened, or where it stands.</param>
    /// <param name="Rank">Where it stands among what happened at the same moment.</param>
    /// <param name="Kind">What kind of entry it is, as the look of the page names it.</param>
    /// <param name="Timed">Whether it happened at a moment of its own, which the entry says.</param>
    /// <param name="What">What happened.</param>
    /// <param name="Number">Which of its kind it is, where the page names it by a number.</param>
    private sealed record Entry(DateTimeOffset At, int Rank, string Kind, bool Timed, object What, int Number = 0);

    private sealed record Closed;

    private sealed record Started;

    private sealed record NoPackage;

    private sealed record NoOrder;

    private sealed record Ended;
}
