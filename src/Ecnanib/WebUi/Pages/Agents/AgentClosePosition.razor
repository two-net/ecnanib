@page "/agents/{Id:guid}/close-position"
@attribute [Authorize]
@using Ecnanib.Agents
@using Ecnanib.Shared
@inject IStoredAgents Agents
@inject IAgentControls Controls
@inject NavigationManager Navigation

@*
    Rendered on the server for each request, and never interactive. The page closes the open
    position of an agent of the user, at market, in whatever state the agent is: the control is
    there at all times for an agent that has a position (FR-AGT-12). The page asks once more,
    because a close cannot be undone. Agents places no order: ClosePositionAsync records the
    request and asks whatever keeps positions. The form is on the page whenever one is posted,
    whatever the agent holds by then: a form that is sent twice finds no position the second time.
    Its texts are in AgentStatePages and AgentPages.
*@

@if (_agent is not null)
{
    <PageTitle>@AgentStatePages.ClosePositionTitle(_agent.Name)</PageTitle>

    <h1>@AgentStatePages.ClosePositionTitle(_agent.Name)</h1>

    <p>@AgentPages.ModeLabel <ModeBadge Mode="@_agent.Mode" /> @AgentPages.TradesIn(_agent.Mode)</p>

    @if (_notClosed is not null)
    {
        <p class="form-error" role="alert">@_notClosed</p>
    }

    @if (_closed)
    {
        <p class="form-done" role="status">@AgentStatePages.Closed(_agent.State)</p>
    }
    else if (_showForm)
    {
        <p>@AgentStatePages.CloseExplained</p>

        <p>@AgentStatePages.StateStays <strong>@AgentPages.Describe(_agent.State)</strong>. @AgentPages.Explain(_agent.State)</p>

        @if (_agent.Mode == TradingMode.Live)
        {
            <p><strong>@AgentPages.ActsOnLive</strong></p>
        }

        <form method="post" @formname="@AgentPages.ClosePositionForm" @onsubmit="CloseAsync">
            <AntiforgeryToken />

            <button type="submit">@AgentPages.ClosePositionNow</button>
        </form>
    }
    else if (_notClosed is null)
    {
        <p role="status">@AgentPages.NothingOpen</p>
    }

    <p><a href="@WebUiModule.AgentStatePath(_agent.Id)">@(_showForm && !_closed ? AgentStatePages.KeepPositionLink : AgentPages.StateLink)</a></p>
}

@code {
    private AgentView? _agent;
    private string? _notClosed;
    private bool _showForm;
    private bool _closed;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        // The agent that the path names, among those of the user of the session. An agent of
        // another user is not found, like one that does not exist.
        _agent = await Agents.FindAsync(request, Id);

        if (_agent is null)
        {
            Navigation.NotFound();

            return;
        }

        // A form that was posted is answered by CloseAsync, whatever the agent holds now.
        _showForm = !HttpMethods.IsGet(request.Request.Method) || _agent.HasOpenPosition;
    }

    private async Task CloseAsync()
    {
        if (HttpContext is not { } request || _agent is null)
        {
            return;
        }

        switch (await Controls.ClosePositionAsync(request, Id))
        {
            case ClosePositionOutcome.Closed:
                // Said here: no other page says that a position was closed. A reload sends the
                // form again, finds nothing open, and closes nothing.
                _closed = true;
                break;

            case ClosePositionOutcome.NothingOpen:
                _showForm = false;
                break;

            case ClosePositionOutcome.Failed:
                _notClosed = AgentPages.NotClosed;
                break;

            default:
                // The agent was deleted, on another browser, since the page was shown.
                _agent = null;
                Navigation.NotFound();
                break;
        }
    }
}
