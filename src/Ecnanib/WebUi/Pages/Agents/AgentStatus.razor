@page "/agents/{Id:guid}/state"
@attribute [Authorize]
@using Ecnanib.Accounts
@using Ecnanib.Agents
@using Ecnanib.Catalog
@using Ecnanib.DecisionEngine
@using Ecnanib.Notifications
@using Ecnanib.Platform.LiveUpdates
@using Ecnanib.Shared
@using Ecnanib.WebUi.Live
@using Ecnanib.WebUi.Pages.Account
@using Ecnanib.WebUi.Pages.Notifications
@inject IStoredAgents Agents
@inject IAgentControls Controls
@inject INotifications Notifications
@inject IAgentReports Reports
@inject IRecordedCycles Cycles
@inject ICatalogModels Models
@inject ILiveSignals Live
@inject NavigationManager Navigation

@*
    Rendered on the server for each request. The page says what state an
    agent of the user is in, what the state means, and why the agent is in it, and lists the
    changes of its state with their causes and times (FR-AGT-10, NFR-USA-2). Its forms start,
    pause, and resume the agent: each is offered in the states that AgentStates.After names, and
    what a form asks for is decided again on the server, under the lock, by IAgentControls.
    Stopping the agent and closing its position each have a page that asks once more. For an
    agent in Live, starting, pausing, and resuming lead to a page that asks once more as well,
    and a form that is posted here all the same changes nothing: StartAsync, PauseAsync, and
    ResumeAsync are told that nobody was asked (FR-UI-3). When a form is posted, all three forms
    are on the page: a form that is not there cannot be answered, and one that is sent twice
    finds the agent in another state the second time. The badge of the mode is under the
    heading, and each change of the state says the mode it happened in (FR-BIN-11). What the
    service has to tell the user about the agent, and they have not read, is said first: that a
    stop-loss could not be placed, and what became of the position (FR-RSK-7, FR-NTF-1). Each
    has a form that marks it as read, which takes it off this page: it stays on the page of the
    notifications. The page follows what changes (FR-NTF-2): when the agent, what it holds, or a
    notification of its user changes, the page asks for itself again, so its state, its controls,
    and its notifications are those of now without a manual refresh. And two parts are written
    to it over its connection as they change: the steps of a cycle of the agent that runs, and
    its open position with the price that it is valued at. A page that answers a form asks for
    itself again on nothing: what the form answered stays on it. See docs/live-updates.md.

    It is the screen of the agent (FR-RPT-2, FR-UI-2): beside the state and the controls it shows
    the live team status, the current position and its protective orders, an equity curve, the
    trade list, the performance figures, and the decision timeline with every role's output and
    the Risk Guard result. The team is shown at work, as a pipeline (FR-ANI-1): the four roles
    with the model of each, in the order that they work in, each with what it does now, and
    under them the steps of a cycle that runs, or that the team is at rest. The pipeline is of
    the part that is written over the connection, so the page hands that part the team as it
    read it. The figures and the curve are of the mode that the agent is in, and nothing of the
    other mode is in them. The trades and the decisions each say their mode (FR-BIN-11). They
    are asked for by owner: the Decision Engine, which may not use Accounts, is handed the user
    who is signed in. The equity is worked out as the dashboard works it out, with the open
    position at the price that the watch has, and the page never waits for the exchange: a
    figure that is not known says so, and the page asks for itself again when the price of the
    position is first read. It asks for itself again as well when a cycle of the agent is
    recorded and when its equity is. The trades are read a page at a time, which the address
    names: a page that there is not is not found. The page has no field. See
    docs/agent-screen.md.
*@

@if (_agent is not null)
{
    <PageTitle>State of the agent @_agent.Name</PageTitle>

    <h1>State of the agent @_agent.Name</h1>

    <p>Mode: <ModeBadge Mode="@_agent.Mode" /> The agent trades <code>@_agent.Symbol</code> on @_agent.Market in @KeyPages.Describe(_agent.Mode).</p>

    @* That the page follows what changes, with what pauses it: see LivePause (NFR-USA-1). *@
    <LivePause Prices="true" />

    @if (_refused is not null)
    {
        <p class="form-error" role="alert">@_refused</p>

        @if (_roles is not null)
        {
            @* Each role that keeps the agent from running, with what to do about it (FR-TEAM-1). *@
            <ul class="agent-role-blocks">
                @foreach (var role in _roles)
                {
                    <li>@AgentPages.Says(role)</li>
                }
            </ul>

            <p><a href="@WebUiModule.AgentPath(_agent.Id)">Settings of the agent</a></p>
        }

        @if (_keyBlocks || (_roles?.Any(role => AgentPages.IsAboutAKey(role.Problem)) ?? false))
        {
            <p><a href="@WebUiModule.KeysPath">Your keys</a></p>
        }
    }

    @if (_notifications is { Count: > 0 })
    {
        <h2 id="notifications-heading">Notifications</h2>

        <p>What the service has to tell you about this agent, latest first.</p>

        <ul class="agent-notifications" aria-labelledby="notifications-heading">
            @foreach (var notification in _notifications)
            {
                <li data-key="@notification.Id">
                    <span id="@NotificationPages.TextId(notification.Id)"><strong>@NotificationTypes.Describe(notification.Type)</strong>, @PageTimes.At(notification.CreatedAt). @notification.Content</span>

                    <form method="post" @formname="@NotificationPages.MarkReadForm(notification.Id)" @onsubmit="() => MarkReadAsync(notification.Id)">
                        <AntiforgeryToken />

                        @* Every such button says the same: it is described by what its notification says. *@
                        <button type="submit" aria-describedby="@NotificationPages.TextId(notification.Id)">@NotificationPages.MarkRead</button>
                    </form>
                </li>
            }
        </ul>

        <p><a href="@WebUiModule.NotificationsPath">@NotificationPages.AllLink</a></p>
    }

    @* The state by its name, so that what moves shows a change of it as one (FR-ANI-3): see docs/motion.md. *@
    <p data-change="@_agent.State">State: <strong>@AgentPages.Describe(_agent.State)</strong>, since @PageTimes.At(_agent.StateChangedAt). @AgentPages.Explain(_agent.State)</p>

    <p>@AgentPages.Says(_agent.StateCause)</p>

    @if (AgentStates.HaltEnds(_agent.State, _agent.StateCause, _agent.StateChangedAt) is { } ends)
    {
        @* A daily loss limit halts until the next UTC day (FR-RSK-8): the page says when that is. *@
        <p>@AgentPages.HaltEnds(ends)</p>
    }

    @* The team of the agent: who decides for it, and what each of them does now (FR-RPT-2, FR-ANI-1). *@
    <h2 id="team-heading">@AgentReportPages.TeamHeading</h2>

    <p>@AgentReportPages.TeamExplained</p>

    @* The team at work and what the agent holds now, written over the connection of the page as it changes. *@
    <LiveUpdates AgentId="@_agent.Id"
                 Follows="@Followed"
                 Shows="@(LiveShows.Cycle | LiveShows.Position | LiveShows.Team)"
                 Market="@_agent.Market"
                 Mode="@_agent.Mode"
                 Symbol="@_agent.Symbol"
                 QuoteAsset="@_agent.QuoteAsset"
                 Values="true"
                 Team="@_team"
                 Since="@_since" />

    <h2>Controls</h2>

    @foreach (var control in Moves)
    {
        @if (Shows(control))
        {
            <form method="post" @formname="@AgentPages.FormOf(control)" @onsubmit="() => AnswerAsync(control)">
                <AntiforgeryToken />

                <p>@AgentPages.Explain(control)</p>

                <button type="submit">@AgentPages.Describe(control)</button>
            </form>
        }
        else if (AsksFirst(control))
        {
            @* In Live: the control leads to the page that asks once more, as stopping does. *@
            <p>@AgentPages.Explain(control)</p>

            <p><a href="@WebUiModule.ConfirmAgentControlPath(_agent.Id, control)">@AgentPages.Describe(control)</a></p>
        }
    }

    @if (AgentStates.After(_agent.State, AgentControl.Stop) is not null)
    {
        <p>@AgentPages.Explain(AgentControl.Stop)</p>

        <p><a href="@WebUiModule.StopAgentPath(_agent.Id)">@AgentPages.Describe(AgentControl.Stop)</a></p>
    }

    @if (_agent.HasOpenPosition)
    {
        <p>The agent has an open position. You can close it at any time, at the market price, in whatever state the agent is.</p>

        <p><a href="@WebUiModule.CloseAgentPositionPath(_agent.Id)">@AgentPages.ClosePositionNow</a></p>
    }

    @if (_report is not null)
    {
        @* How the agent has performed, in the mode that it is in (FR-RPT-2). *@
        <AgentPerformance Report="@_report" />

        <AgentEquityCurve Curve="@_report.Curve" Mode="@_report.Equity.Mode" Asset="@_report.Equity.Asset" />

        <AgentTradeList AgentId="@_agent.Id" Trades="@_report.Trades" />

        <AgentDecisions AgentId="@_agent.Id" Decisions="@_decisions" />
    }

    <h2>Mode</h2>

    @if (_agent.Mode == TradingMode.Demo)
    {
        <p>In Demo the agent trades in Binance's test environment, and no money is at stake. In Live it trades in your real Binance account, with real money.</p>
    }
    else
    {
        <p>In Live the agent trades in your real Binance account, with real money. In Demo it trades in Binance's test environment, and no money is at stake.</p>
    }

    @if (!_agent.StructureCanChange)
    {
        <p role="note">@AgentPages.ModeLocked</p>
    }
    else if (_agent.Mode == TradingMode.Demo)
    {
        <p><a href="@WebUiModule.SwitchAgentToLivePath(_agent.Id)">Switch the agent to Live</a></p>
    }
    else
    {
        <p><a href="@WebUiModule.SwitchAgentToDemoPath(_agent.Id)">Switch the agent to Demo</a></p>
    }

    @if (_history is not null)
    {
        <h2 id="changes-heading">State changes</h2>

        @if (_history.Total > _history.Changes.Count)
        {
            <p>The latest @_history.Changes.Count of @_history.Total changes, latest first.</p>
        }
        else
        {
            <p>Every change of the agent's state, latest first.</p>
        }

        @* The table scrolls by itself on a narrow screen, also by keyboard, as the list of agents does. *@
        <div class="agents agent-changes" role="region" aria-labelledby="changes-heading" tabindex="0">
            <table>
                <caption>State changes</caption>
                <thead>
                    <tr>
                        <th scope="col">When</th>
                        <th scope="col">Mode</th>
                        <th scope="col">State</th>
                        <th scope="col">Why</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var change in _history.Changes)
                    {
                        <tr data-key="@change.ChangedAt.UtcTicks">
                            @* The time names its row, as in the other tables. *@
                            <th scope="row">@PageTimes.At(change.ChangedAt)</th>
                            <td><ModeBadge Mode="@change.Mode" /></td>
                            <td>@AgentPages.Describe(change.State)</td>
                            <td>@AgentPages.Says(change.Cause)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <p><a href="@WebUiModule.AgentPath(_agent.Id)">Settings of the agent</a></p>

    <p><a href="@WebUiModule.AgentPromptsPath(_agent.Id)">@AgentPages.PromptsLink</a></p>

    <p><a href="@WebUiModule.AgentCyclesPath(_agent.Id)">@CyclePages.Link</a></p>

    <p><a href="@WebUiModule.AgentTestCyclePath(_agent.Id)">@CyclePages.TestLink</a></p>

    <p><a href="@WebUiModule.AgentRiskChecksPath(_agent.Id)">@RiskCheckPages.Link</a></p>

    <p><a href="@WebUiModule.LessonsOfAgentPath(_agent.Id)">@Ecnanib.WebUi.Pages.Experience.LessonPages.OfAgentLink</a></p>

    <p><a href="@WebUiModule.UsageOfAgentPath(_agent.Id)">@Ecnanib.WebUi.Pages.Usage.UsagePages.OfAgentLink</a></p>

    <p><a href="@WebUiModule.AgentsPath">Back to your agents</a></p>
}

@code {
    // The controls that this page has a form for. Stopping has a page of its own.
    private static readonly AgentControl[] Moves = [AgentControl.Start, AgentControl.Pause, AgentControl.Resume];

    // What the page asks for itself again on: the agent, what it holds, a cycle of it that is
    // recorded, its equity as it is recorded, and what its user is told.
    private static readonly LiveSubject[] Followed =
        [LiveSubject.Agent, LiveSubject.Holdings, LiveSubject.Cycle, LiveSubject.Equity, LiveSubject.Notification];

    private long _since;

    private AgentView? _agent;
    private AgentReport? _report;
    private IReadOnlyList<CycleRecord> _decisions = [];
    private IReadOnlyList<LiveRole> _team = [];
    private AgentStateHistory? _history;
    private IReadOnlyList<NotificationView>? _notifications;
    private bool _posted;
    private bool _keyBlocks;
    private IReadOnlyList<RoleBlock>? _roles;
    private string? _refused;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        // An address that makes a choice of following which there is not has no page, as one
        // with a page number that is none has not: see LivePause.
        if (LivePages.PausedOf(request.Request.Query) is null)
        {
            Navigation.NotFound();

            return;
        }

        // Before the page reads: what changes from here on is what the page may not show.
        _since = Live.Mark();

        // The agent that the path names, among those of the user of the session. An agent of
        // another user is not found, like one that does not exist.
        if (!await ReadAsync(request))
        {
            Navigation.NotFound();

            return;
        }

        // How the agent has performed, its decisions, and its team, read once for the request:
        // a form that is answered reads the agent again, and these stay as they were read.
        if (!await ReadReportAsync(request, _agent!))
        {
            _agent = null;
            Navigation.NotFound();

            return;
        }

        // A form was posted, and is answered by AnswerAsync, whatever state the agent is in now.
        _posted = !HttpMethods.IsGet(request.Request.Method);
    }

    private async Task AnswerAsync(AgentControl control)
    {
        if (HttpContext is not { } request || _agent is null)
        {
            return;
        }

        // A form of this page is one press: nobody was asked once more. So it changes nothing
        // of an agent in Live, whatever mode the page showed the agent in.
        var result = control switch
        {
            AgentControl.Start => await Controls.StartAsync(request, Id, confirmedForLive: false),
            AgentControl.Pause => await Controls.PauseAsync(request, Id, confirmedForLive: false),
            _ => await Controls.ResumeAsync(request, Id, confirmedForLive: false),
        };

        switch (result.Outcome)
        {
            case AgentControlOutcome.Done:
                // The page as it is now, by a request that changes nothing: a reload of it
                // sends no form again.
                Navigation.NavigateTo(LivePages.Kept(request.Request, WebUiModule.AgentStatePath(Id)));

                return;

            case AgentControlOutcome.NotFound:
                // The agent was deleted, on another browser, since the page was shown.
                _agent = null;
                Navigation.NotFound();

                return;

            case AgentControlOutcome.NotConfirmedForLive:
                // The agent is in Live, and nothing was done: the page that asks once more.
                Navigation.NavigateTo(WebUiModule.ConfirmAgentControlPath(Id, control));

                return;

            case AgentControlOutcome.KeyBlocks when result.Block is { } block:
                // Names the permission that the key lacks, where that is what blocks (FR-KEY-5).
                _refused = KeyPages.Says(block, _agent.Mode);
                _keyBlocks = true;
                break;

            case AgentControlOutcome.AnotherAgentActive:
                _refused = AgentPages.AnotherAgentActive(_agent);
                break;

            case AgentControlOutcome.RolesBlock when result.Roles is { } roles:
                // Names each role that has no model, or whose model its user cannot select now.
                _refused = AgentPages.RolesBlock(control);
                _roles = roles;
                break;

            case AgentControlOutcome.AccountConflicts when result.Conflict is { } conflict:
                // Says what to change at Binance, where the account stands in the way (FR-BIN-F2).
                _refused = AgentPages.Says(conflict, control, _agent);
                break;

            case AgentControlOutcome.HaltedForTheDay when result.HaltEnds is { } ends:
                // Its daily loss limit halted the agent until the next UTC day (FR-RSK-8).
                _refused = AgentPages.HaltedForTheDay(control, ends);
                break;
        }

        // Nothing changed. The page is shown as the agent is now, with why.
        _posted = false;

        if (!await ReadAsync(request))
        {
            Navigation.NotFound();

            return;
        }

        _refused ??= AgentPages.NotOffered(control, _agent!.State);
    }

    private async Task MarkReadAsync(Guid notificationId)
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        // Asked for by owner again: the notification that the form names, among those of the
        // user of the session.
        await Notifications.MarkReadAsync(request, notificationId);

        // The page as it is now, by a request that changes nothing: a reload of it sends no
        // form again. A page that was paused stays paused.
        Navigation.NavigateTo(LivePages.Kept(request.Request, WebUiModule.AgentStatePath(Id)));
    }

    /// <summary>
    /// Reads the agent, the changes of its state, and what the service has to tell its user
    /// about it. False when the user has no agent of that id.
    /// </summary>
    private async Task<bool> ReadAsync(HttpContext request)
    {
        _agent = await Agents.FindAsync(request, Id);
        _history = _agent is null ? null : await Controls.HistoryAsync(request, Id);

        // Asked for the user of the session, as the agent is: the notifications of another
        // user are not found.
        _notifications = _agent is null ? null : await Notifications.UnreadOfAgentAsync(request, Id);

        return _agent is not null;
    }

    /// <summary>
    /// Reads how the agent has performed, with the page of its trades that the address names,
    /// its latest decisions, and its team. False when the address names a page of the trades
    /// which there is not, and when the agent is gone since it was read.
    /// </summary>
    private async Task<bool> ReadReportAsync(HttpContext request, AgentView agent)
    {
        // An address that names a choice which there is not is not found: the page shows what
        // its address asks for, and never something else in its place.
        if (AgentReportPages.TradesPageOf(request.Request.Query) is not { } tradesPage)
        {
            return false;
        }

        // The Decision Engine may not use Accounts, so it is handed the user who is signed in,
        // and answers with what is of that user alone.
        var userId = SignedInUser.RequiredIdOf(request);
        var cancellationToken = request.RequestAborted;

        var report = await Reports.OfAgentAsync(userId, agent.Id, tradesPage, cancellationToken);

        // A page after the last one is none that there is. The first page is always there.
        if (report is null || tradesPage > report.Trades.Pages)
        {
            return false;
        }

        _report = report;
        _decisions = await Cycles.LatestRecordsAsync(userId, agent.Id, CycleRecord.Detailed, cancellationToken);

        // Each role of the team with the model that it was given, by the names that the catalog
        // has for the model and for its provider. A model that several roles were given is
        // asked for once. A role that was given none says so.
        var providers = new Dictionary<Guid, string?>();

        foreach (var modelId in agent.Roles.Select(given => given.ModelId).Distinct())
        {
            providers[modelId] = (await Models.FindAsync(modelId, cancellationToken))?.ProviderName;
        }

        _team =
        [
            .. Enum.GetValues<Role>().Select(role => new LiveRole(
                role,
                agent.Roles.FirstOrDefault(given => given.Role == role) is { } given
                    ? AgentReportPages.Model(given, providers[given.ModelId])
                    : null)),
        ];

        return true;
    }

    /// <summary>
    /// Whether the page has the one-press form of a control: for an agent in Demo, in the states
    /// that the control is offered in, and whenever a form was posted.
    /// </summary>
    private bool Shows(AgentControl control) =>
        _posted || (_agent is { Mode: TradingMode.Demo } && AgentStates.After(_agent.State, control) is not null);

    /// <summary>Whether a control leads to the page that asks once more: for an agent in Live, in the states that it is offered in.</summary>
    private bool AsksFirst(AgentControl control) =>
        _agent is { Mode: TradingMode.Live } && AgentStates.After(_agent.State, control) is not null;
}
