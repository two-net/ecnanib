@using Ecnanib.DecisionEngine
@using Ecnanib.WebUi.Pages.Experience

@*
    The trade list of an agent, on its screen (FR-RPT-2): the positions that it closed, the
    latest close first, a page of them at a time. Each says the mode that the agent was in when
    it opened it, so a trade in Demo is listed as one in Demo for good (FR-BIN-11). It says it
    as a word: the page has the one badge, which is that of its agent (FR-UI-3). It says how
    much the position held, the prices that it was entered and closed at, how it was closed, and
    its recorded result: what it made after fees and funding, with its sign, the same in R, its
    fees, its funding, and how long it was held. A result is recorded some minutes after the
    close: until then the trade says so. A price that no order of the agent says is not known,
    and is said as that. The pages are links: the page has no field. The texts are in
    AgentReportPages. See docs/agent-screen.md.
*@

<section class="agent-trades">
    <h2 id="@AgentReportPages.TradesHeadingId">@AgentReportPages.TradesHeading</h2>

    @if (Trades.Total == 0)
    {
        <p>@AgentReportPages.NoTrades</p>
    }
    else
    {
        <p>@AgentReportPages.Listed(Trades)</p>

        @* The table is wider than a narrow screen, so it scrolls by itself, also by keyboard. *@
        <div class="agents agent-trade-list" role="region" aria-labelledby="@AgentReportPages.TradesHeadingId" tabindex="0">
            <table>
                <caption>@AgentReportPages.TradesCaption</caption>
                <thead>
                    <tr>
                        <th scope="col">@AgentReportPages.ClosedHeading</th>
                        <th scope="col">@AgentReportPages.ModeHeading</th>
                        <th scope="col">@AgentReportPages.SymbolHeading</th>
                        <th scope="col">@AgentReportPages.MarketHeading</th>
                        <th scope="col">@AgentReportPages.SideHeading</th>
                        <th scope="col">@AgentReportPages.QuantityHeading</th>
                        <th scope="col">@AgentReportPages.EntryPriceHeading</th>
                        <th scope="col">@AgentReportPages.ExitPriceHeading</th>
                        <th scope="col">@AgentReportPages.ExitReasonHeading</th>
                        <th scope="col">@AgentReportPages.NetResult</th>
                        <th scope="col">@AgentReportPages.InRHeading</th>
                        <th scope="col">@AgentReportPages.Fees</th>
                        <th scope="col">@AgentReportPages.Funding</th>
                        <th scope="col">@AgentReportPages.OpenedHeading</th>
                        <th scope="col">@AgentReportPages.HeldHeading</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trade in Trades.Trades)
                    {
                        <tr data-key="@trade.PositionId">
                            <th scope="row">@Times.At(trade.ClosedAt)</th>
                            <td>@AgentReportPages.ModeOf(trade.Mode)</td>
                            <td><code>@trade.Symbol</code></td>
                            <td>@AgentPages.NameOf(trade.Market)</td>
                            <td>@AgentReportPages.Side(trade)</td>
                            <td>@AgentReportPages.Number(trade.Quantity)</td>
                            <td>@AgentReportPages.Number(trade.EntryPrice)</td>
                            <td>@AgentReportPages.Number(trade.ExitPrice)</td>
                            <td>@AgentReportPages.Describe(trade.ExitReason)</td>
                            <td>@AgentReportPages.Result(trade)</td>
                            <td>@AgentReportPages.InR(trade)</td>
                            <td>@AgentReportPages.FeesOf(trade)</td>
                            <td>@AgentReportPages.FundingOf(trade)</td>
                            <td>@Times.At(trade.OpenedAt)</td>
                            <td>@AgentReportPages.HeldOf(trade)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Trades.Trades.Any(trade => trade.Result is null))
        {
            <p>@AgentReportPages.RecordedLater</p>
        }

        @if (Trades.Trades.Any(trade => trade.Estimate))
        {
            <p>@ExperiencePages.EstimatesExplained</p>
        }

        @if (Trades.Pages > 1)
        {
            @* Another page of the list is asked for as a page of its own, so it opens with the focus at its heading (NFR-USA-1). *@
            <nav class="lesson-pages" aria-label="@AgentReportPages.TradesPagesLabel" data-enhance-nav="false">
                @if (Trades.Page > 1)
                {
                    <a href="@LivePages.Kept(HttpContext?.Request, WebUiModule.AgentStatePath(AgentId, Trades.Page - 1))">@AgentReportPages.NewerTrades</a>
                }

                @if (Trades.Page < Trades.Pages)
                {
                    <a href="@LivePages.Kept(HttpContext?.Request, WebUiModule.AgentStatePath(AgentId, Trades.Page + 1))">@AgentReportPages.OlderTrades</a>
                }
            </nav>
        }
    }
</section>

@code {
    /// <summary>The times of the page: every time is written in its time zone (NFR-USA-3). See docs/times.md.</summary>
    [CascadingParameter]
    private PageTimes Times { get; set; } = PageTimes.Utc;

    /// <summary>The agent whose trades they are, which the links to the other pages name.</summary>
    [Parameter, EditorRequired]
    public Guid AgentId { get; set; }

    /// <summary>One page of the closed trades of the agent.</summary>
    [Parameter, EditorRequired]
    public AgentTrades Trades { get; set; } = null!;

    // The request that the page is written for: a page that its user paused stays paused on the other pages of the list.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }
}
