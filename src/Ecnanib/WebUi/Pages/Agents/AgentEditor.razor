@page "/agents/new"
@page "/agents/{Id:guid}"
@attribute [Authorize]
@using Ecnanib.Agents
@using Ecnanib.Catalog
@using Ecnanib.Experience
@using Ecnanib.Platform.Settings
@using Ecnanib.Shared
@using Ecnanib.WebUi.Pages.Experience
@inject IStoredAgents Agents
@inject TradingSettings Trading
@inject ExperienceSettings Experience
@inject NavigationManager Navigation

@*
    Rendered on the server for each request, and never interactive: the settings travel in a
    form post. The page creates an agent, or changes the one that its path names, which is one
    of the user of the session. What is entered is held to the rules by CreateAsync and
    SaveAsync, on the server: the risk settings to the hard bounds of the configuration file,
    and the symbol to the symbols that the chosen market has (FR-AGT-6, FR-RSK-2). The list of
    symbols follows the market with a press of a button, which stores nothing. The form is on
    the page whenever one is posted: a form that is not there cannot be answered. The badge of
    the mode is under the heading: a new agent is in Demo, and the form offers no choice of the
    mode, which is switched on a page of its own (FR-AGT-7). A change to the capital, to a risk
    setting, to the model of a role, or to whether the roles are reassigned automatically is
    asked about once more for an agent in Live before it is stored (FR-UI-3).

    Each of the four roles of the team has a choice of a provider and a choice of a model
    (FR-AGT-5, FR-TEAM-1). On a new agent the providers are those of the default mapping of the
    configuration file, four different ones (FR-TEAM-2, FR-TEAM-3). The models that a role is
    offered are those of its provider that the user's own key can use, and that can be selected
    at all (FR-CAT-6, FR-CAT-9): the list follows the provider with a press of a button, which
    stores nothing, as the symbols follow the market. A provider may hold more than one role,
    and the form warns of it where it shows the providers (FR-TEAM-5).

    Under each role is its strongest candidate by measured strength, on the market and the
    timeframe that the form holds, with which data its score is of and whether the role is
    recommended it (FR-TEAM-4, FR-EXP-4, FR-EXP-9). One button saves the form with the
    recommended models in the roles: they are put in the fields of the roles before the form is
    answered, so everything that holds a form holds it, and an agent in Live is asked about once
    more with them in the form. The form carries what it recommended when it was shown, and the
    button stores that or nothing: where what is recommended now is something else, the form
    comes back with it. Any role is given another model as before. A box turns on that
    the service reassigns the roles by the same rule on its own (FR-TEAM-10).
*@

@if (_found)
{
    <PageTitle>@Title</PageTitle>

    <h1>@Title</h1>

    <p>Mode: <ModeBadge Mode="@_mode" /> @AgentPages.TradesIn(_mode)</p>

    @if (_agent is null)
    {
        <p>A new agent is in Demo. You can switch it to Live once it is created.</p>
    }
    else if (!_agent.StructureCanChange)
    {
        <p role="note">@AgentPages.ModeLocked</p>
    }
    else if (_agent.Mode == TradingMode.Demo)
    {
        <p><a href="@WebUiModule.SwitchAgentToLivePath(_agent.Id)">Switch the agent to Live</a></p>
    }
    else
    {
        <p><a href="@WebUiModule.SwitchAgentToDemoPath(_agent.Id)">Switch the agent to Demo</a></p>
    }

    @if (_notNow is not null)
    {
        <p role="status">@_notNow</p>
    }

    @if (_notSaved is not null)
    {
        <p class="form-error" role="alert">@_notSaved</p>
    }

    @if (_agent is not null)
    {
        @* The state is changed on a page of its own: this form changes settings, and no state. *@
        <p>State: <strong>@AgentPages.Describe(_agent.State)</strong>. @AgentPages.Explain(_agent.State) <a href="@WebUiModule.AgentStatePath(_agent.Id)">State of the agent</a></p>

        @* What the roles of the agent are told is read on a page of its own, and edited nowhere (FR-PRM-7). *@
        <p><a href="@WebUiModule.AgentPromptsPath(_agent.Id)">@AgentPages.PromptsLink</a></p>

        @* What the closed trades of the agent taught is read, and managed, on a page of the lessons (FR-EXP-8). *@
        <p><a href="@WebUiModule.LessonsOfAgentPath(_agent.Id)">@Ecnanib.WebUi.Pages.Experience.LessonPages.OfAgentLink</a></p>
    }

    @if (_showForm)
    {
        <form method="post" @formname="@AgentPages.SaveForm" @onsubmit="SaveAsync">
            <AntiforgeryToken />

            <div class="field">
                <label for="agent-name">Name</label>
                <input id="agent-name" name="Name" type="text" value="@NameEntry" autocomplete="off" required
                       maxlength="@AgentRules.MaximumNameLength"
                       aria-invalid="@Invalid(AgentField.Name)" aria-describedby="agent-name-hint" />
                <p id="agent-name-hint" class="field-hint">What you call the agent. Each of your agents has a name of its own.</p>
                @if (Problem(AgentField.Name) is { } nameProblem)
                {
                    <p class="field-error" role="alert">@nameProblem</p>
                }
            </div>

            @if (_structureCanChange)
            {
                <div class="field">
                    <label for="agent-market">Market</label>
                    <select id="agent-market" name="Market" required
                            aria-invalid="@Invalid(AgentField.Market)" aria-describedby="agent-market-hint">
                        @foreach (var market in Enum.GetValues<Market>())
                        {
                            <option value="@market" selected="@(market == _market)">@market</option>
                        }
                    </select>
                    <p id="agent-market-hint" class="field-hint">On Spot the agent buys and sells the asset itself, and only goes long. On Futures it trades USDⓈ-margined perpetual contracts, long and short, with leverage. The market sets which actions the agent may take and which prompt its roles are given.</p>
                    @if (Problem(AgentField.Market) is { } marketProblem)
                    {
                        <p class="field-error" role="alert">@marketProblem</p>
                    }

                    @* Stores nothing: the form comes back with the symbols of the market that is chosen now. *@
                    <button type="submit" name="Show" value="@AgentPages.ShowSymbols" formnovalidate>Show the symbols of this market</button>
                </div>

                <div class="field">
                    <label for="agent-symbol">Symbol on @_market</label>
                    <select id="agent-symbol" name="Symbol" required
                            aria-invalid="@Invalid(AgentField.Symbol)" aria-describedby="agent-symbol-hint">
                        @foreach (var symbol in _offered)
                        {
                            <option value="@symbol.Symbol" selected="@(symbol.Symbol == SymbolEntry)">@symbol.Symbol, priced in @symbol.QuoteAsset</option>
                        }
                    </select>
                    <p id="agent-symbol-hint" class="field-hint">The symbols that @_market has. An agent trades one symbol.</p>
                    @if (!_symbolsKnown)
                    {
                        <p role="note">Binance gave no answer about which symbols @_market has, so none can be chosen now. Try again in a moment.</p>
                    }
                    @if (Problem(AgentField.Symbol) is { } symbolProblem)
                    {
                        <p class="field-error" role="alert">@symbolProblem</p>
                    }
                </div>

                <div class="field">
                    <label for="agent-timeframe">Timeframe</label>
                    <select id="agent-timeframe" name="Timeframe" required
                            aria-invalid="@Invalid(AgentField.Timeframe)" aria-describedby="agent-timeframe-hint">
                        <option value="" selected="@(Timeframes.WithCode(TimeframeEntry) is null)">Choose a timeframe</option>
                        @foreach (var timeframe in Timeframes.All)
                        {
                            <option value="@timeframe.Code()" selected="@(timeframe.Code() == TimeframeEntry)">@AgentPages.Describe(timeframe)</option>
                        }
                    </select>
                    <p id="agent-timeframe-hint" class="field-hint">The agent decides once for each candle that closes. The timeframe sets how often its cycle runs, which candles it reads, and which prompt its roles are given.</p>
                    @if (Problem(AgentField.Timeframe) is { } timeframeProblem)
                    {
                        <p class="field-error" role="alert">@timeframeProblem</p>
                    }
                </div>
            }
            else if (_agent is not null)
            {
                @* Shown as they are stored, and not offered for a change. The form still brings them. *@
                <input type="hidden" name="Market" value="@_agent.Market" />
                <input type="hidden" name="Symbol" value="@_agent.Symbol" />
                <input type="hidden" name="Timeframe" value="@_agent.Timeframe.Code()" />

                <p>Market: <strong>@_agent.Market</strong>. Symbol: <strong>@_agent.Symbol</strong>. Timeframe: <strong>@_agent.Timeframe.Code()</strong>.</p>

                <p role="note">@AgentPages.StructureLocked</p>
            }

            <div class="field">
                <label for="agent-capital">Allocated capital</label>
                <input id="agent-capital" name="AllocatedCapital" type="text" inputmode="decimal" value="@CapitalEntry" autocomplete="off" required
                       aria-invalid="@Invalid(AgentField.AllocatedCapital)" aria-describedby="agent-capital-hint" />
                <p id="agent-capital-hint" class="field-hint">How much the agent may trade with, in the asset that its symbol is priced in: for BTCUSDT, an amount of USDT. The agent's equity is this capital plus its profit or loss so far.</p>
                @if (Problem(AgentField.AllocatedCapital) is { } capitalProblem)
                {
                    <p class="field-error" role="alert">@capitalProblem</p>
                }
            </div>

            <fieldset>
                <legend>Risk settings</legend>

                <p>Every agent trades the one profile, Aggressive. These are its hard limits: the AI roles cannot override them. They are deliberately aggressive, and make large losses more likely. A change applies from the agent's next cycle.</p>

                <div class="field">
                    <label for="agent-risk-per-trade">Risk per trade, in percent</label>
                    <input id="agent-risk-per-trade" name="RiskPerTradePercent" type="text" inputmode="decimal" value="@RiskPerTradeEntry" autocomplete="off" required
                           aria-invalid="@Invalid(AgentField.RiskPerTradePercent)" aria-describedby="agent-risk-per-trade-hint" />
                    <p id="agent-risk-per-trade-hint" class="field-hint">The share of the agent's equity that one trade loses when its stop-loss is hit. @AgentPages.Within(Trading.Aggressive.RiskPerTradePercent)</p>
                    @if (Problem(AgentField.RiskPerTradePercent) is { } riskPerTradeProblem)
                    {
                        <p class="field-error" role="alert">@riskPerTradeProblem</p>
                    }
                </div>

                <div class="field">
                    <label for="agent-reward-to-risk">Minimum reward-to-risk ratio</label>
                    <input id="agent-reward-to-risk" name="MinRewardToRisk" type="text" inputmode="decimal" value="@RewardToRiskEntry" autocomplete="off" required
                           aria-invalid="@Invalid(AgentField.MinRewardToRisk)" aria-describedby="agent-reward-to-risk-hint" />
                    <p id="agent-reward-to-risk-hint" class="field-hint">How much a trade must aim to gain for what it risks, before the agent enters it. At 1.5, a trade that loses 100 at its stop-loss must aim for a profit of 150 or more. @AgentPages.Within(Trading.Aggressive.MinRewardToRisk)</p>
                    @if (Problem(AgentField.MinRewardToRisk) is { } rewardToRiskProblem)
                    {
                        <p class="field-error" role="alert">@rewardToRiskProblem</p>
                    }
                </div>

                <div class="field">
                    <label for="agent-leverage-cap">Leverage cap</label>
                    <input id="agent-leverage-cap" name="LeverageCap" type="text" inputmode="numeric" value="@LeverageCapEntry" autocomplete="off" required
                           aria-invalid="@Invalid(AgentField.LeverageCap)" aria-describedby="agent-leverage-cap-hint" />
                    <p id="agent-leverage-cap-hint" class="field-hint">The highest leverage the agent uses. It counts on Futures only: on Spot there is no leverage. @AgentPages.Within(Trading.Aggressive.LeverageCap)</p>
                    @if (Problem(AgentField.LeverageCap) is { } leverageCapProblem)
                    {
                        <p class="field-error" role="alert">@leverageCapProblem</p>
                    }
                </div>

                <div class="field">
                    <label for="agent-liquidation-buffer">Liquidation buffer</label>
                    <input id="agent-liquidation-buffer" name="LiquidationBuffer" type="text" inputmode="decimal" value="@LiquidationBufferEntry" autocomplete="off" required
                           aria-invalid="@Invalid(AgentField.LiquidationBuffer)" aria-describedby="agent-liquidation-buffer-hint" />
                    <p id="agent-liquidation-buffer-hint" class="field-hint">How many times further from the entry price than the stop-loss the estimated liquidation price must be. At 2, a trade whose stop-loss is 1 percent away is entered only when its liquidation price is 2 percent away or more. It counts on Futures only: on Spot nothing is liquidated. @AgentPages.Within(Trading.Aggressive.LiquidationBuffer)</p>
                    @if (Problem(AgentField.LiquidationBuffer) is { } liquidationBufferProblem)
                    {
                        <p class="field-error" role="alert">@liquidationBufferProblem</p>
                    }
                </div>

                <div class="field">
                    <label for="agent-daily-loss">Daily loss limit, in percent</label>
                    <input id="agent-daily-loss" name="DailyLossPercent" type="text" inputmode="decimal" value="@DailyLossEntry" autocomplete="off" required
                           aria-invalid="@Invalid(AgentField.DailyLossPercent)" aria-describedby="agent-daily-loss-hint" />
                    <p id="agent-daily-loss-hint" class="field-hint">When the agent has lost this share of its equity within one day, it is halted. @AgentPages.Within(Trading.Aggressive.DailyLossPercent)</p>
                    @if (Problem(AgentField.DailyLossPercent) is { } dailyLossProblem)
                    {
                        <p class="field-error" role="alert">@dailyLossProblem</p>
                    }
                </div>

                <div class="field">
                    <label for="agent-drawdown">Drawdown limit, in percent</label>
                    <input id="agent-drawdown" name="DrawdownPercent" type="text" inputmode="decimal" value="@DrawdownEntry" autocomplete="off" required
                           aria-invalid="@Invalid(AgentField.DrawdownPercent)" aria-describedby="agent-drawdown-hint" />
                    <p id="agent-drawdown-hint" class="field-hint">When the agent's equity has fallen this far below its highest, it is halted. @AgentPages.Within(Trading.Aggressive.DrawdownPercent)</p>
                    @if (Problem(AgentField.DrawdownPercent) is { } drawdownProblem)
                    {
                        <p class="field-error" role="alert">@drawdownProblem</p>
                    }
                </div>

                <div class="field">
                    <label for="agent-entry-distance">Maximum entry distance, in percent</label>
                    <input id="agent-entry-distance" name="MaxEntryDistancePercent" type="text" inputmode="decimal" value="@EntryDistanceEntry" autocomplete="off" required
                           aria-invalid="@Invalid(AgentField.MaxEntryDistancePercent)" aria-describedby="agent-entry-distance-hint" />
                    <p id="agent-entry-distance-hint" class="field-hint">How far the price of an entry may be from the current price. @AgentPages.Within(Trading.Aggressive.MaxEntryDistancePercent)</p>
                    @if (Problem(AgentField.MaxEntryDistancePercent) is { } entryDistanceProblem)
                    {
                        <p class="field-error" role="alert">@entryDistanceProblem</p>
                    }
                </div>

                @* The limits that the specification fixes: said, and never asked for (FR-RSK-2). *@
                <p>@AgentPages.FixedLimitsIntro</p>
                <ul>
                    @foreach (var limit in AgentPages.FixedLimitsExplained)
                    {
                        <li>@limit</li>
                    }
                </ul>
            </fieldset>

            <fieldset class="agent-roles">
                <legend>Roles</legend>

                <p>@AgentPages.RolesExplained</p>

                @* Said with the choices that mark the models that search live: it may add provider charges (FR-CYC-3). *@
                <p>@AgentPages.LiveSearchExplained</p>

                @* Said of the providers that the form holds now, so before a reduced team is saved (FR-TEAM-5). *@
                @foreach (var warning in Warnings())
                {
                    <p class="form-warning" role="note">@warning</p>
                }

                @* What a candidate is, the formula of its score, and what the figures cannot tell (FR-TEAM-4, FR-EXP-4, FR-EXP-11). *@
                <p>@AgentPages.StrengthExplained</p>

                <p>@ExperiencePages.StrengthFormula(Experience.Damping) @ExperiencePages.EnoughExplained(Experience.MinSamples)</p>

                <p role="note">@ExperiencePages.PastResults @ExperiencePages.SmallSamples(Experience.MinSamples) @ExperiencePages.DemoDiffers</p>

                @if (_recommendations is { } scores)
                {
                    <p><a href="@ExperiencePages.Path(TrackRecordFilter.None with { Market = scores.Market, Timeframe = scores.Timeframe })">@AgentPages.StrengthsLink</a></p>
                }
                else
                {
                    <p role="note">@AgentPages.CandidatesNeedTimeframe</p>
                }

                @foreach (var role in AgentRoleRules.All)
                {
                    var (name, job) = AgentPages.Describe(role);
                    var id = AgentPages.IdOf(role);
                    var provider = ProviderOf(role);
                    var models = ModelsOf(role);
                    var chosen = ModelIdEntry(role) is { } chosenId ? models.FirstOrDefault(model => model.Id == chosenId) : null;

                    <div class="field">
                        <h3>@name</h3>

                        <p id="agent-@(id)-hint" class="field-hint">@job</p>

                        <label for="agent-@(id)-provider">Provider of the @name</label>
                        <select id="agent-@(id)-provider" name="@AgentPages.ProviderField(role)">
                            @foreach (var offered in _choices.Providers)
                            {
                                <option value="@offered.Provider.Value" selected="@(offered.Provider == provider?.Provider)">@offered.Name</option>
                            }
                        </select>

                        <label for="agent-@(id)-model">Model of the @name</label>
                        <select id="agent-@(id)-model" name="@AgentPages.ModelField(role)"
                                aria-invalid="@Invalid(role)" aria-describedby="agent-@(id)-hint">
                            <option value="" selected="@(chosen is null)">@AgentPages.ChooseModel</option>
                            @foreach (var model in models)
                            {
                                <option value="@model.Id" selected="@(model == chosen)">@AgentPages.Describe(model)@(Selectable(role, model) ? "" : ", cannot be selected now")</option>
                            }
                        </select>

                        @if (models.Any(model => !Selectable(role, model)))
                        {
                            <p role="note">@AgentPages.ModelNotSelectableNow</p>
                        }

                        @* A note, and no warning: the role runs with such a model. A model that cannot be selected now has its own. *@
                        @if (role == Role.SentimentAnalyst && chosen is { LiveSearch: false } && Selectable(role, chosen))
                        {
                            <p role="note">@AgentPages.SentimentWithoutLiveSearch</p>
                        }

                        @if (provider is not null && AgentPages.Says(provider) is { } nothingOffered)
                        {
                            <p role="note">@nothingOffered <a href="@WebUiModule.KeysPath">Your keys</a></p>
                        }

                        @* Against the model that the role has as it is stored, whatever the form holds: the rule of the service is the same. *@
                        @if (_recommendations is { } recommendations)
                        {
                            <p id="agent-@(id)-candidate" class="role-candidate">@AgentPages.CandidateOf(recommendations, role, StoredModelOf(role))</p>
                        }

                        @if (Problem(role) is { } roleProblem)
                        {
                            <p class="field-error" role="alert">@roleProblem</p>
                        }
                    </div>
                }

                @* Stores nothing: the form comes back with the models of the providers that are chosen now. *@
                <button type="submit" name="Show" value="@AgentPages.ShowModels" formnovalidate>@AgentPages.ShowModelsButton</button>

                @* Stores nothing: the form comes back with the candidates of the market and the timeframe that are chosen now. *@
                <button type="submit" name="Show" value="@AgentPages.ShowCandidates" formnovalidate>@AgentPages.ShowCandidatesButton</button>

                <div class="field">
                    @* Not ticked for its user: an agent opts in (FR-TEAM-10). *@
                    <input id="agent-reassigns-roles" name="@AgentPages.ReassignsRolesField" type="checkbox" value="@AgentPages.ReassignsRolesOn"
                           checked="@ReassignsRoles" aria-describedby="agent-reassigns-roles-hint" />
                    <label for="agent-reassigns-roles">@AgentPages.ReassignsRolesLabel</label>
                    <p id="agent-reassigns-roles-hint" class="field-hint">@AgentPages.ReassignsRolesExplained(Trading.RoleReassignmentDays)</p>
                    @if (_agent?.RolesReassignedAt is { } reassignedAt)
                    {
                        <p role="note">@AgentPages.RolesLastReassigned(reassignedAt, Trading.RoleReassignmentDays)</p>
                    }
                </div>
            </fieldset>

            @if (_confirmLive)
            {
                @* Asked once more: nothing is stored until this button is pressed. *@
                <p class="form-error" role="alert">@AgentPages.ConfirmSaveForLive</p>

                <button type="submit" name="Confirm" value="@AgentPages.ConfirmLive">@AgentPages.SaveForLive</button>
            }
            else
            {
                <button type="submit">@(_agent is null ? "Create the agent" : "Save the agent")</button>

                @if (_recommendations is not null)
                {
                    @if (Recommended().Count > 0)
                    {
                        @* Said of the team that the button below saves, so before it is saved (FR-TEAM-5). *@
                        @foreach (var warning in RecommendedWarnings())
                        {
                            <p class="form-warning recommended-team" role="note">@AgentPages.OfRecommendedTeam(warning)</p>
                        }

                        @* What the form recommends now, which the button saves: a recommendation that is another by then is shown first, and not stored. *@
                        <input type="hidden" name="@AgentPages.RecommendedField" value="@AgentPages.RecommendedAs(_recommendations, Recommended())" />

                        @* One action (FR-TEAM-4): the form is saved with the recommended model in each role that has one. *@
                        <button type="submit" name="@AgentPages.ApplyField" value="@AgentPages.ApplyRecommended">@(_agent is null ? AgentPages.CreateRecommendedButton : AgentPages.SaveRecommendedButton)</button>
                    }
                    else
                    {
                        <p role="note">@AgentPages.NothingRecommended</p>
                    }
                }
            }
        </form>
    }

    <p><a href="@WebUiModule.AgentsPath">Back to your agents</a></p>
}

@code {
    private AgentView? _agent;
    private bool _found;
    private bool _showForm;
    private bool _structureCanChange = true;
    private bool _symbolsKnown = true;
    private TradingMode _mode = TradingMode.Demo;
    private Market _market = Market.Spot;
    private IReadOnlyList<SymbolChoice> _offered = [];
    private IReadOnlyDictionary<AgentField, AgentProblem> _problems = new Dictionary<AgentField, AgentProblem>();
    private IReadOnlyDictionary<Role, RoleProblem> _roleProblems = new Dictionary<Role, RoleProblem>();
    private RoleChoices _choices = new([], new Dictionary<Role, AiProviderCode>());
    private RoleRecommendations? _recommendations;
    private bool _recommendationChanged;
    private string? _notNow;
    private string? _notSaved;
    private bool _confirmLive;

    /// <summary>The agent that the path names. The page that creates an agent names none.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(Name = "Name")]
    private string? NameEntry { get; set; }

    [SupplyParameterFromForm(Name = "Market")]
    private string? MarketEntry { get; set; }

    [SupplyParameterFromForm(Name = "Symbol")]
    private string? SymbolEntry { get; set; }

    [SupplyParameterFromForm(Name = "Timeframe")]
    private string? TimeframeEntry { get; set; }

    [SupplyParameterFromForm(Name = "AllocatedCapital")]
    private string? CapitalEntry { get; set; }

    [SupplyParameterFromForm(Name = "RiskPerTradePercent")]
    private string? RiskPerTradeEntry { get; set; }

    [SupplyParameterFromForm(Name = "MinRewardToRisk")]
    private string? RewardToRiskEntry { get; set; }

    [SupplyParameterFromForm(Name = "LeverageCap")]
    private string? LeverageCapEntry { get; set; }

    [SupplyParameterFromForm(Name = "LiquidationBuffer")]
    private string? LiquidationBufferEntry { get; set; }

    [SupplyParameterFromForm(Name = "DailyLossPercent")]
    private string? DailyLossEntry { get; set; }

    [SupplyParameterFromForm(Name = "DrawdownPercent")]
    private string? DrawdownEntry { get; set; }

    [SupplyParameterFromForm(Name = "MaxEntryDistancePercent")]
    private string? EntryDistanceEntry { get; set; }

    // The provider and the model of each role, as the form brings them. A form field is a
    // property of its own, so there are eight: see ProviderEntry and ModelEntry.
    [SupplyParameterFromForm(Name = "MarketAnalystProvider")]
    private string? MarketAnalystProviderEntry { get; set; }

    [SupplyParameterFromForm(Name = "MarketAnalystModel")]
    private string? MarketAnalystModelEntry { get; set; }

    [SupplyParameterFromForm(Name = "SentimentAnalystProvider")]
    private string? SentimentAnalystProviderEntry { get; set; }

    [SupplyParameterFromForm(Name = "SentimentAnalystModel")]
    private string? SentimentAnalystModelEntry { get; set; }

    [SupplyParameterFromForm(Name = "StrategistProvider")]
    private string? StrategistProviderEntry { get; set; }

    [SupplyParameterFromForm(Name = "StrategistModel")]
    private string? StrategistModelEntry { get; set; }

    [SupplyParameterFromForm(Name = "RiskManagerProvider")]
    private string? RiskManagerProviderEntry { get; set; }

    [SupplyParameterFromForm(Name = "RiskManagerModel")]
    private string? RiskManagerModelEntry { get; set; }

    /// <summary>
    /// The button that shows the symbols of the chosen market, or the one that shows the models
    /// of the chosen providers, when that is what was pressed. Either stores nothing.
    /// </summary>
    [SupplyParameterFromForm]
    private string? Show { get; set; }

    /// <summary>
    /// The button that saves a change to the capital, to a risk setting, to the model of a
    /// role, or to whether the roles are reassigned automatically for an agent in Live, when
    /// that is what was pressed: the page asked once more, and this is the answer.
    /// </summary>
    [SupplyParameterFromForm]
    private string? Confirm { get; set; }

    /// <summary>
    /// The button that saves the form with the recommended team, when that is what was pressed
    /// (FR-TEAM-4).
    /// </summary>
    [SupplyParameterFromForm]
    private string? Apply { get; set; }

    /// <summary>What the form recommended when it was shown, which the button of the recommended team saves.</summary>
    [SupplyParameterFromForm(Name = "Recommended")]
    private string? RecommendedEntry { get; set; }

    /// <summary>
    /// The box that turns on that the service reassigns the roles by strength, when it is
    /// ticked (FR-TEAM-10). A box that is not ticked brings nothing.
    /// </summary>
    [SupplyParameterFromForm(Name = "ReassignsRoles")]
    private string? ReassignsRolesEntry { get; set; }

    private bool ReassignsRoles => string.Equals(ReassignsRolesEntry, AgentPages.ReassignsRolesOn, StringComparison.Ordinal);

    private string Title => _agent is null ? "Create an agent" : $"Settings of the agent {_agent.Name}";

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        if (Id is { } agentId)
        {
            // The agent that the path names, among those of the user of the session. An agent
            // of another user is not found, like one that does not exist.
            _agent = await Agents.FindAsync(request, agentId);

            if (_agent is null)
            {
                Navigation.NotFound();

                return;
            }

            _mode = _agent.Mode;
            _structureCanChange = _agent.StructureCanChange;
        }

        _found = true;

        if (!HttpMethods.IsGet(request.Request.Method))
        {
            // A form was posted, and is answered by SaveAsync, with what it brought.
            _showForm = true;
            await OfferSymbolsAsync(request);
            _choices = await Agents.RoleChoicesAsync(request);
            await RecommendAsync(request);

            if (Apply == AgentPages.ApplyRecommended && Show is null)
            {
                // The button saves what the form showed, and nothing that its user did not
                // see: another market or timeframe was chosen since, the scores changed, or a
                // role was given another model meanwhile. Then nothing is stored, and the form
                // is back with what is recommended now.
                var recommended = Recommended();

                if (_recommendations is null
                    || recommended.Count == 0
                    || !string.Equals(RecommendedEntry, AgentPages.RecommendedAs(_recommendations, recommended), StringComparison.Ordinal))
                {
                    _recommendationChanged = true;
                }
                else
                {
                    // The recommended models are put in the fields of the roles before the form
                    // is answered: SaveAsync reads them as it reads what a user chose, and the
                    // form comes back with them when it is not stored, as for an agent in Live.
                    EnterRecommended();
                }
            }

            return;
        }

        if (_agent is null)
        {
            // No form for a user who may create no agent: one whose address is not verified, or
            // who has as many agents as an account can have (FR-ACC-1, FR-ACC-7).
            var list = await Agents.ListAsync(request);
            _notNow = AgentPages.Says(list.Creation, list.MaxAgents);

            if (_notNow is not null)
            {
                return;
            }

            // A new agent starts from the defaults of the one profile (FR-RSK-1). Its timeframe
            // is for its user to choose.
            var defaults = Trading.Aggressive;
            MarketEntry = Market.Spot.ToString();
            RiskPerTradeEntry = AgentPages.Number(defaults.RiskPerTradePercent.Default);
            RewardToRiskEntry = AgentPages.Number(defaults.MinRewardToRisk.Default);
            LeverageCapEntry = AgentPages.Number(defaults.LeverageCap.Default);
            LiquidationBufferEntry = AgentPages.Number(defaults.LiquidationBuffer.Default);
            DailyLossEntry = AgentPages.Number(defaults.DailyLossPercent.Default);
            DrawdownEntry = AgentPages.Number(defaults.DrawdownPercent.Default);
            EntryDistanceEntry = AgentPages.Number(defaults.MaxEntryDistancePercent.Default);
        }
        else
        {
            NameEntry = _agent.Name;
            MarketEntry = _agent.Market.ToString();
            SymbolEntry = _agent.Symbol;
            TimeframeEntry = _agent.Timeframe.Code();
            CapitalEntry = AgentPages.Number(_agent.AllocatedCapital);
            RiskPerTradeEntry = AgentPages.Number(_agent.Risk.RiskPerTradePercent);
            RewardToRiskEntry = AgentPages.Number(_agent.Risk.MinRewardToRisk);
            LeverageCapEntry = AgentPages.Number(_agent.Risk.LeverageCap);
            LiquidationBufferEntry = AgentPages.Number(_agent.Risk.LiquidationBuffer);
            DailyLossEntry = AgentPages.Number(_agent.Risk.DailyLossPercent);
            DrawdownEntry = AgentPages.Number(_agent.Risk.DrawdownPercent);
            EntryDistanceEntry = AgentPages.Number(_agent.Risk.MaxEntryDistancePercent);
            ReassignsRolesEntry = _agent.ReassignsRoles ? AgentPages.ReassignsRolesOn : null;
        }

        _showForm = true;
        await OfferSymbolsAsync(request);
        _choices = await Agents.RoleChoicesAsync(request);
        await RecommendAsync(request);

        // A role that has a model starts from it, and from its provider. A role that has none,
        // which is every role of a new agent, starts from the provider that the configuration
        // file gives it (FR-TEAM-2, FR-TEAM-3), and its model is for its user to choose.
        foreach (var role in AgentRoleRules.All)
        {
            var has = _agent?.Roles.FirstOrDefault(given => given.Role == role);

            Enter(
                role,
                (has?.Provider ?? _choices.Defaults.GetValueOrDefault(role)).Value,
                has?.ModelId.ToString());
        }
    }

    private async Task SaveAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        if (Show is not null)
        {
            // Another button: nothing is stored, and the form is back with the symbols of the
            // market that is chosen now, with the models of the providers that are chosen now,
            // and with everything else as it was entered.
            return;
        }

        if (_recommendationChanged)
        {
            _notSaved = AgentPages.RecommendationChanged;

            return;
        }

        var entry = new AgentEntry(
            NameEntry,
            MarketEntry,
            SymbolEntry,
            TimeframeEntry,
            CapitalEntry,
            RiskPerTradeEntry,
            RewardToRiskEntry,
            LeverageCapEntry,
            LiquidationBufferEntry,
            DailyLossEntry,
            DrawdownEntry,
            EntryDistanceEntry,
            [.. AgentRoleRules.All.Select(role => new RoleEntry(role, ProviderEntry(role), ModelEntry(role)))],
            ReassignsRoles);

        var result = _agent is null
            ? await Agents.CreateAsync(request, entry)
            : await Agents.SaveAsync(request, _agent.Id, entry, confirmedForLive: Confirm == AgentPages.ConfirmLive);

        switch (result.Outcome)
        {
            case SaveAgentOutcome.Saved:
                // The page that lists the agents as they are now. A reload of it stores nothing again.
                Navigation.NavigateTo(WebUiModule.AgentsPath);
                break;

            case SaveAgentOutcome.NotFound:
                // The agent was deleted, on another browser, since the form was shown.
                _found = false;
                Navigation.NotFound();
                break;

            case SaveAgentOutcome.Invalid:
                _problems = result.Problems;
                _roleProblems = result.RoleProblems;
                break;

            case SaveAgentOutcome.EmailNotVerified:
                _notNow = AgentPages.VerifyFirst;
                break;

            case SaveAgentOutcome.AgentLimitReached:
                _notNow = AgentPages.LimitReached((await Agents.ListAsync(request)).MaxAgents);
                break;

            case SaveAgentOutcome.SymbolsUnknown:
                _notSaved = AgentPages.SymbolsUnknown;
                break;

            case SaveAgentOutcome.StructureLocked:
                _notSaved = $"Nothing was saved. {AgentPages.StructureLocked}";
                break;

            case SaveAgentOutcome.NotConfirmedForLive:
                // Nothing was stored. The form is back as it was entered, with the button that
                // says so once more.
                _confirmLive = true;
                break;
        }
    }

    /// <summary>
    /// The symbols that the form offers: those of the market that is chosen, in the environment
    /// of the agent. The symbol that an agent has stays among them while it has that market, so
    /// that its other settings can be saved while the exchange gives no answer.
    /// </summary>
    private async Task OfferSymbolsAsync(HttpContext request)
    {
        _market = AgentRules.MarketNamed(MarketEntry) ?? _agent?.Market ?? Market.Spot;

        var there = (await Agents.SymbolsAsync(_mode, request.RequestAborted)).Single(symbols => symbols.Market == _market);

        _symbolsKnown = there.Known;
        _offered = there.Symbols;

        if (_agent is not null && _agent.Market == _market && _offered.All(symbol => symbol.Symbol != _agent.Symbol))
        {
            _offered = [new SymbolChoice(_agent.Symbol, _agent.QuoteAsset), .. _offered];
        }
    }

    /// <summary>
    /// The models that have a strength score in each role, on the market and the timeframe that
    /// the form holds now: those of the agent when the form is first shown. A score is of one
    /// market and one timeframe, so there is none to show while no timeframe is chosen.
    /// </summary>
    private async Task RecommendAsync(HttpContext request)
    {
        _recommendations = Timeframes.WithCode(TimeframeEntry?.Trim()) is { } timeframe
            ? await Agents.RoleRecommendationsAsync(request, _market, timeframe)
            : null;
    }

    /// <summary>The model that a role has as it is stored, which a new agent has none of.</summary>
    private Guid? StoredModelOf(Role role) => _agent?.Roles.FirstOrDefault(given => given.Role == role)?.ModelId;

    /// <summary>
    /// The roles that are recommended another model than they have, each with that model
    /// (FR-TEAM-4): its strongest candidate, when it scores above the model that the role has.
    /// </summary>
    private IReadOnlyList<(Role Role, ScoredModel Model)> Recommended()
    {
        if (_recommendations is not { } recommendations)
        {
            return [];
        }

        var recommended = new List<(Role, ScoredModel)>();
        foreach (var role in AgentRoleRules.All)
        {
            if (recommendations.RecommendedFor(role, StoredModelOf(role)) is { } model)
            {
                recommended.Add((role, model));
            }
        }

        return recommended;
    }

    /// <summary>
    /// Puts the recommended model of each role that has one in its fields, with its provider. A
    /// role that is recommended none keeps what the form holds for it.
    /// </summary>
    private void EnterRecommended()
    {
        foreach (var (role, model) in Recommended())
        {
            Enter(role, model.Slice.Model.Provider.Value, model.ModelId.ToString());
        }
    }

    private string? Problem(AgentField field) =>
        _problems.TryGetValue(field, out var problem) ? AgentPages.Says(field, problem, Trading.Aggressive) : null;

    private string? Invalid(AgentField field) => _problems.ContainsKey(field) ? "true" : null;

    private string? Problem(Role role)
    {
        if (!_roleProblems.TryGetValue(role, out var problem))
        {
            return null;
        }

        // A form that names a provider which is none says nothing that the page can name: it
        // is told to choose from the list, and not that a model is "not one of" another provider.
        if (problem == RoleProblem.NotOfProvider && !HoldsAProvider(role))
        {
            problem = RoleProblem.NotAModel;
        }

        return AgentPages.Says(role, problem, ProviderOf(role)?.Name ?? "the provider");
    }

    private string? Invalid(Role role) => _roleProblems.ContainsKey(role) ? "true" : null;

    /// <summary>The code of the provider that the form holds for a role.</summary>
    private string? ProviderEntry(Role role) => role switch
    {
        Role.MarketAnalyst => MarketAnalystProviderEntry,
        Role.SentimentAnalyst => SentimentAnalystProviderEntry,
        Role.Strategist => StrategistProviderEntry,
        _ => RiskManagerProviderEntry,
    };

    /// <summary>The id of the model that the form holds for a role, or nothing when none is chosen.</summary>
    private string? ModelEntry(Role role) => role switch
    {
        Role.MarketAnalyst => MarketAnalystModelEntry,
        Role.SentimentAnalyst => SentimentAnalystModelEntry,
        Role.Strategist => StrategistModelEntry,
        _ => RiskManagerModelEntry,
    };

    /// <summary>
    /// The model that the form holds for a role, read as the server reads it: an id, whatever
    /// way it is written. Null when none is chosen, and when what was brought is no id.
    /// </summary>
    private Guid? ModelIdEntry(Role role) =>
        Guid.TryParse((ModelEntry(role) ?? string.Empty).Trim(), out var id) ? id : null;

    /// <summary>Whether the provider that the form holds for a role is one of the providers.</summary>
    private bool HoldsAProvider(Role role)
    {
        var held = (ProviderEntry(role) ?? string.Empty).Trim();

        return held.Length > 0 && _choices.Of(new AiProviderCode(held)) is not null;
    }

    /// <summary>Puts a provider and a model in the fields of a role, as the form shows them first.</summary>
    private void Enter(Role role, string provider, string? model)
    {
        switch (role)
        {
            case Role.MarketAnalyst:
                (MarketAnalystProviderEntry, MarketAnalystModelEntry) = (provider, model);
                break;

            case Role.SentimentAnalyst:
                (SentimentAnalystProviderEntry, SentimentAnalystModelEntry) = (provider, model);
                break;

            case Role.Strategist:
                (StrategistProviderEntry, StrategistModelEntry) = (provider, model);
                break;

            default:
                (RiskManagerProviderEntry, RiskManagerModelEntry) = (provider, model);
                break;
        }
    }

    /// <summary>
    /// The provider that is chosen for a role now: the one that the form holds, when it is one
    /// of the providers. Otherwise the one of the model that the role has, or the default one.
    /// </summary>
    private ProviderChoice? ProviderOf(Role role)
    {
        var held = (ProviderEntry(role) ?? string.Empty).Trim();

        if (held.Length > 0 && _choices.Of(new AiProviderCode(held)) is { } chosen)
        {
            return chosen;
        }

        var fallback = _agent?.Roles.FirstOrDefault(given => given.Role == role)?.Provider
            ?? _choices.Defaults.GetValueOrDefault(role);

        return _choices.Of(fallback) ?? _choices.Providers.FirstOrDefault();
    }

    /// <summary>
    /// The models that the form lists for a role: those of its provider that the user can
    /// select. The model that the role has stays among them while the role has that provider,
    /// also when it cannot be selected any more, so that the form shows what is stored, and the
    /// other settings can be saved while a key is gone.
    /// </summary>
    private IReadOnlyList<SelectableModel> ModelsOf(Role role)
    {
        if (ProviderOf(role) is not { } provider)
        {
            return [];
        }

        var has = _agent?.Roles.FirstOrDefault(given => given.Role == role);

        return has is not null && has.Provider == provider.Provider && provider.Models.All(model => model.Id != has.ModelId)
            ? [new SelectableModel(has.ModelId, has.Provider, has.Identifier, has.DisplayName, LiveSearch: false), .. provider.Models]
            : provider.Models;
    }

    /// <summary>Whether a model that the form lists for a role is one that the user can select now.</summary>
    private bool Selectable(Role role, SelectableModel model) =>
        ProviderOf(role) is { } provider && provider.Models.Any(offered => offered.Id == model.Id);

    /// <summary>
    /// What the form warns of for the providers that it holds for the roles now (FR-TEAM-5): a
    /// provider that holds more than one role, and the Strategist and the Risk Manager on the
    /// same one.
    /// </summary>
    private IReadOnlyList<string> Warnings() => WarningsOf(ProvidersHeld());

    /// <summary>
    /// What the form warns of for the team that the button of the recommended team would save
    /// (FR-TEAM-5): the providers that the form holds, with the provider of the recommended model
    /// in each role that has one. Strength may give two roles to one provider.
    /// </summary>
    private IReadOnlyList<string> RecommendedWarnings()
    {
        var providers = ProvidersHeld();
        foreach (var (role, model) in Recommended())
        {
            providers[role] = model.Slice.Model.Provider;
        }

        return WarningsOf(providers);
    }

    /// <summary>The provider that the form holds for each role now.</summary>
    private Dictionary<Role, AiProviderCode> ProvidersHeld()
    {
        var providers = new Dictionary<Role, AiProviderCode>();
        foreach (var role in AgentRoleRules.All)
        {
            if (ProviderOf(role) is { } provider)
            {
                providers[role] = provider.Provider;
            }
        }

        return providers;
    }

    private IReadOnlyList<string> WarningsOf(Dictionary<Role, AiProviderCode> providers)
    {
        var warned = AgentRoleRules.WarningsOf(providers);
        var warnings = new List<string>();

        if (warned.Reduced)
        {
            warnings.Add(AgentPages.ReducedTeam([.. warned.Repeated.Select(NameOf)]));
        }

        if (warned.StrategistAndRiskManager is { } both)
        {
            warnings.Add(AgentPages.SameProviderReviews(NameOf(both)));
        }

        return warnings;

        string NameOf(AiProviderCode provider) => _choices.Of(provider)?.Name ?? provider.Value;
    }
}
