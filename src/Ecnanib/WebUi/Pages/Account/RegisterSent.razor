@page "/register/sent"
@using Ecnanib.Accounts

@*
    The same page whatever the address was, so that it does not tell whether an address already
    has an account. Its texts are in RegistrationPages.
*@

<PageTitle>@AccountPages.CheckYourEmail</PageTitle>

<h1>@AccountPages.CheckYourEmail</h1>

<p>@RegistrationPages.SentExplained</p>

<p>@RegistrationPages.LinkWorksFor((int)EmailVerification.LinkLifetime.TotalHours) <a href="/register">@RegistrationPages.RegisterAgainLink</a> @RegistrationPages.GetNewOne</p>
