@attribute [Route(WebUiModule.KeysPath)]
@attribute [Authorize]
@using Ecnanib.Credentials
@inject IStoredKeys StoredKeys

@*
    Rendered on the server for each request, and never interactive. The page shows which keys are
    stored, each by its last four characters. A key itself is never read for it, and so is never
    in what the browser gets (FR-KEY-8).
*@

<PageTitle>Your API keys</PageTitle>

<h1>Your API keys</h1>

<p>Your agents work with your own keys: one for each AI provider, and one for Binance in each environment. Ecnanib has no key of its own for a decision or an order.</p>

<p>A key is stored encrypted and is never shown again. After saving, you see only its last four characters. You can replace or delete a key at any time.</p>

@if (_state is not null)
{
    @if (!_state.AddressVerified)
    {
        <p role="status">@KeyPages.VerifyFirst</p>
    }

    <h2>AI providers</h2>

    <ul class="keys">
        @foreach (var slot in _state.AiKeys)
        {
            <li>
                <strong>@slot.ProviderName</strong>
                <div>
                    @if (slot.Key is { } key)
                    {
                        <span>Key <code>@KeyPages.Masked(key)</code>, saved @KeyPages.Saved(key).</span>
                        <a href="@WebUiModule.AiKeyPath(slot.Provider)">Replace the @slot.ProviderName key</a>
                        <a href="@WebUiModule.DeleteAiKeyPath(slot.Provider)">Delete the @slot.ProviderName key</a>
                    }
                    else
                    {
                        <span>No key stored.</span>
                        @if (_state.AddressVerified)
                        {
                            <a href="@WebUiModule.AiKeyPath(slot.Provider)">Add a @slot.ProviderName key</a>
                        }
                    }
                </div>
            </li>
        }
    </ul>

    <h2>Binance</h2>

    <ul class="keys">
        @foreach (var slot in _state.ExchangeKeys)
        {
            <li>
                <strong>@slot.Environment</strong>
                <div>
                    @if (slot.Key is { } key)
                    {
                        <span>API key <code>@KeyPages.Masked(key)</code>, saved @KeyPages.Saved(key).</span>
                        <a href="@WebUiModule.ExchangeKeyPath(slot.Environment)">Replace the @slot.Environment key</a>
                        <a href="@WebUiModule.DeleteExchangeKeyPath(slot.Environment)">Delete the @slot.Environment key</a>
                    }
                    else
                    {
                        <span>No key stored.</span>
                        @if (_state.AddressVerified)
                        {
                            <a href="@WebUiModule.ExchangeKeyPath(slot.Environment)">Add a @slot.Environment key</a>
                        }
                    }
                </div>
            </li>
        }
    </ul>
}

<p><a href="/account">Back to your account</a></p>

@code {
    private StoredKeysState? _state;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is { } request)
        {
            _state = await StoredKeys.StateAsync(request);
        }
    }
}
