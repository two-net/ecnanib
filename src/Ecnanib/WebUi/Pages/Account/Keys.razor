@attribute [Route(WebUiModule.KeysPath)]
@attribute [Authorize]
@using Ecnanib.Accounts
@using Ecnanib.Credentials
@using Ecnanib.DecisionEngine
@using Ecnanib.Platform.Settings
@using Ecnanib.Shared
@using Ecnanib.WebUi.Pages.Agents
@using Ecnanib.WebUi.Pages.Usage
@inject IStoredKeys StoredKeys
@inject IAiUsage AiUsage
@inject BinanceSettings Binance

@*
    Rendered on the server for each request, and never interactive. The page shows which keys are
    stored, each by its last four characters, with what its provider said when it was last asked
    about it (FR-KEY-3). A key itself is never read for it, and so is never in what the browser
    gets (FR-KEY-8). A form of the page asks the provider about a stored key again: the forms
    are on the page whenever one is posted, for the keys that are stored then. Under each key
    for an AI provider the page says its usage: the calls that were made with it, their tokens,
    and what they are estimated to cost where the price is known (FR-KEY-11). Its texts are in
    KeyPages.
*@

<PageTitle>@KeyPages.Title</PageTitle>

<h1>@KeyPages.Title</h1>

<p>@KeyPages.Explained</p>

<p>@KeyPages.Kept</p>

@if (_checked is not null)
{
    <p class="form-done" role="status">@_checked</p>
}

@if (_state is not null)
{
    @if (!_state.AddressVerified)
    {
        <p role="status">@KeyPages.VerifyFirst</p>
    }

    <h2>@KeyPages.AiProvidersHeading</h2>

    @* What the providers are sent under these keys, and under whose terms (NFR-SEC-8). *@
    <p>@KeyPages.SentToProviders</p>

    <ul class="keys">
        @foreach (var slot in _state.AiKeys)
        {
            <li>
                <strong>@slot.ProviderName</strong>
                <div>
                    @if (slot.Key is { } key)
                    {
                        <span>@KeyPages.Key <code>@KeyPages.Masked(key)</code>, @KeyPages.WasSaved(key, Times)</span>
                        <span>@KeyPages.Checked(key, slot.ProviderName, Times)</span>
                        @if (_usage.TryGetValue(slot.Provider, out var usage))
                        {
                            <span>@KeyPages.Usage(usage)</span>
                        }
                        <a href="@WebUiModule.AiKeyPath(slot.Provider)">@KeyPages.ReplaceLink(slot.ProviderName)</a>
                        <a href="@WebUiModule.DeleteAiKeyPath(slot.Provider)">@KeyPages.DeleteLink(slot.ProviderName)</a>
                        <form method="post" @formname="@KeyPages.CheckAiForm(slot.Provider)" @onsubmit="() => CheckAiKeyAsync(slot)">
                            <AntiforgeryToken />

                            <button type="submit">@KeyPages.CheckAgain(slot.ProviderName)</button>
                        </form>
                    }
                    else
                    {
                        <span>@KeyPages.NoKey</span>
                        @if (_state.AddressVerified)
                        {
                            <a href="@WebUiModule.AiKeyPath(slot.Provider)">@KeyPages.AddLink(slot.ProviderName)</a>
                        }
                    }
                </div>
            </li>
        }
    </ul>

    @if (_usage.Count > 0)
    {
        @* What the usage under a key is, and where it is shown by day (FR-KEY-11, FR-RPT-3). *@
        <p>@KeyPages.UsageExplained <a href="@WebUiModule.UsagePath">@UsagePages.ByDayLink</a></p>
    }

    <h2>@KeyPages.BinanceHeading</h2>

    <p>@KeyPages.NeverWithdraws</p>

    <ul class="keys">
        @foreach (var slot in _state.ExchangeKeys)
        {
            <li>
                <strong>@AgentPages.NameOf(slot.Environment)</strong>
                <div>
                    @if (slot.Key is { } key)
                    {
                        <span>@KeyPages.ApiKey <code>@KeyPages.Masked(key)</code>, @KeyPages.WasSaved(key, Times)</span>
                        <span>@KeyPages.CheckedByBinance(key, Times)</span>
                        @if (slot.Permissions is { } permissions)
                        {
                            <span>@KeyPages.Trades(permissions)</span>
                        }
                        <a href="@WebUiModule.ExchangeKeyPath(slot.Environment)">@KeyPages.ReplaceLink(AgentPages.NameOf(slot.Environment))</a>
                        <a href="@WebUiModule.DeleteExchangeKeyPath(slot.Environment)">@KeyPages.DeleteLink(AgentPages.NameOf(slot.Environment))</a>
                        <form method="post" @formname="@KeyPages.CheckExchangeForm(slot.Environment)" @onsubmit="() => CheckExchangeKeyAsync(slot)">
                            <AntiforgeryToken />

                            <button type="submit">@KeyPages.CheckAgain(AgentPages.NameOf(slot.Environment))</button>
                        </form>
                        @if (slot.Permissions is { IpRestricted: false })
                        {
                            @* Only where Binance reports it: its test environment does not (FR-KEY-4). *@
                            <p class="key-warning" role="note">@KeyPages.WorksFromAnyAddress(KeyPages.OutboundAddresses(Binance))</p>
                        }
                    }
                    else
                    {
                        <span>@KeyPages.NoKey</span>
                        @if (_state.AddressVerified)
                        {
                            <a href="@WebUiModule.ExchangeKeyPath(slot.Environment)">@KeyPages.AddLink(AgentPages.NameOf(slot.Environment))</a>
                        }
                    }
                </div>
            </li>
        }
    </ul>
}

<p><a href="/account">@AccountPages.BackToAccount</a></p>

@code {
    /// <summary>The times of the page: every time is written in its time zone (NFR-USA-3). See docs/times.md.</summary>
    [CascadingParameter]
    private PageTimes Times { get; set; } = PageTimes.Utc;

    private StoredKeysState? _state;
    private IReadOnlyDictionary<AiProviderCode, KeyUsage> _usage = new Dictionary<AiProviderCode, KeyUsage>();
    private string? _checked;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is { } request)
        {
            await ShowAsync(request);
        }
    }

    private async Task CheckAiKeyAsync(AiKeySlot slot)
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        var outcome = await StoredKeys.CheckAiKeyAsync(request, slot.Provider);

        // What the provider said, and the keys as they are stored now.
        _checked = KeyPages.Says(outcome, KeyPages.AiKeyName(slot.ProviderName));
        await ShowAsync(request);
    }

    private async Task CheckExchangeKeyAsync(ExchangeKeySlot slot)
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        var outcome = await StoredKeys.CheckExchangeKeyAsync(request, slot.Environment);

        _checked = KeyPages.Says(outcome, KeyPages.ExchangeKeyName(slot.Environment));
        await ShowAsync(request);
    }

    /// <summary>Reads the keys as they are stored now, and the usage of each key for an AI provider.</summary>
    private async Task ShowAsync(HttpContext request)
    {
        var state = await StoredKeys.StateAsync(request);

        // Credentials may not use the Decision Engine, which keeps the calls, so the page asks
        // it: with the user who is signed in, and with when each key that is stored now was
        // stored, because a call before then was made with another key.
        var keys = state.AiKeys
            .Where(slot => slot.Key is not null)
            .Select(slot => new KeyInUse(slot.Provider, slot.Key!.SavedAt))
            .ToList();
        var usage = await AiUsage.OfKeysAsync(SignedInUser.RequiredIdOf(request), keys, request.RequestAborted);

        _usage = usage.ToDictionary(key => key.Provider);
        _state = state;
    }
}
