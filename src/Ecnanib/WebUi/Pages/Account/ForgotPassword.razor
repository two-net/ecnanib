@page "/forgot-password"
@using Ecnanib.Accounts
@using Ecnanib.Platform.Settings
@inject IPasswordReset PasswordReset
@inject LimitsSettings Limits
@inject NavigationManager Navigation

<PageTitle>Forgot your password?</PageTitle>

<h1>Forgot your password?</h1>

@if (_emailNotSent)
{
    <p class="form-error" role="alert">We could not send the email. Try again in a few minutes.</p>
}
@if (_tooManyAttempts)
{
    <p class="form-error" role="alert">Too many attempts. Try again in up to @Limits.PasswordReset.Minutes minutes.</p>
}

<form method="post" @formname="forgot-password" @onsubmit="RequestAsync">
    <AntiforgeryToken />

    <p>Enter the email address of your account. We send a link to it, and with the link you choose a new password.</p>

    <div class="field">
        <label for="email">Email address</label>
        <input id="email" name="Email" type="email" autocomplete="email" required value="@Email"
               aria-invalid="@(_invalid ? "true" : null)"
               aria-describedby="@(_invalid ? "email-error" : null)" />
        @if (_invalid)
        {
            <p id="email-error" class="field-error">Enter an email address, such as name@example.com.</p>
        }
    </div>

    <button type="submit">Send the link</button>
</form>

@code {
    private bool _invalid;
    private bool _emailNotSent;
    private bool _tooManyAttempts;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private string? Email { get; set; }

    private async Task RequestAsync()
    {
        var outcome = await PasswordReset.RequestAsync(
            Email ?? string.Empty,
            HttpContext is { } request ? AuditOrigin.Of(request) : AuditOrigin.Unknown,
            HttpContext?.RequestAborted ?? CancellationToken.None);

        switch (outcome)
        {
            case PasswordResetRequestOutcome.Accepted:
                // A page of its own, so that reloading it does not send another email.
                Navigation.NavigateTo("/forgot-password/sent");
                break;

            case PasswordResetRequestOutcome.Invalid:
                _invalid = true;
                break;

            case PasswordResetRequestOutcome.EmailNotSent:
                _emailNotSent = true;
                break;

            case PasswordResetRequestOutcome.TooManyAttempts:
                // The answer says so in its status too, for whatever sent the form without reading the page.
                _tooManyAttempts = true;
                HttpContext?.Response.StatusCode = StatusCodes.Status429TooManyRequests;
                break;
        }
    }
}
