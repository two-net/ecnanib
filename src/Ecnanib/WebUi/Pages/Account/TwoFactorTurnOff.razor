@page "/account/two-factor/turn-off"
@attribute [Authorize]
@using Ecnanib.Accounts
@inject ITwoFactor TwoFactorAuthentication
@inject NavigationManager Navigation

@*
    Rendered on the server for each request, and never interactive: the code travels in a form
    post. The form is on the page whatever the account says, so that a form which is posted from a
    page left open is answered.
*@

<PageTitle>Turn off two-factor authentication</PageTitle>

<h1>Turn off two-factor authentication</h1>

<p>After this, signing in takes your password alone, and your recovery codes stop working. You can turn it on again at any time, which is also how to move to another phone.</p>

@if (_outcome is TwoFactorChangeOutcome.CodesRefused)
{
    <p class="form-error" role="alert">Too many wrong codes were entered. No code is accepted for the next @((int)TwoFactorRules.RefusedFor.TotalMinutes) minutes.</p>
}

<form method="post" @formname="turn-off" @onsubmit="TurnOffAsync">
    <AntiforgeryToken />

    <div class="field">
        <label for="code">Code from your authenticator app</label>
        @* One field for both kinds of code, so it is not limited to digits. A code is never written back into the page. *@
        <input id="code" name="Code" type="text" autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" required
               aria-invalid="@(_outcome is TwoFactorChangeOutcome.WrongCode ? "true" : null)"
               aria-describedby="code-hint" />
        <p id="code-hint" class="field-hint">If you have lost the app, enter one of your recovery codes instead.</p>
        @if (_outcome is TwoFactorChangeOutcome.WrongCode)
        {
            <p class="field-error" role="alert">That code is not right. A code from the app works once, for about half a minute.</p>
        }
    </div>

    <button type="submit">Turn off two-factor authentication</button>
</form>

<p><a href="/account/two-factor">Keep it on</a></p>

@code {
    private TwoFactorChangeOutcome? _outcome;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // There is nothing to turn off for an account that does not have it on.
        if (HttpContext is { } request
            && HttpMethods.IsGet(request.Request.Method)
            && !(await TwoFactorAuthentication.StateAsync(request)).IsOn)
        {
            Navigation.NavigateTo("/account/two-factor");
        }
    }

    private async Task TurnOffAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        _outcome = await TwoFactorAuthentication.TurnOffAsync(request, Code ?? string.Empty);

        if (_outcome is TwoFactorChangeOutcome.Done or TwoFactorChangeOutcome.NotOn)
        {
            // The page that says how things stand now. A reload of it turns nothing off again.
            Navigation.NavigateTo("/account/two-factor");
        }
    }
}
