@*
    The recovery codes of an account, on the one page view that shows them. The application keeps
    only their hashes, so it cannot show them a second time. Its texts are in TwoFactorPages.
*@

<h2>@TwoFactorPages.CodesHeading</h2>

<p>@TwoFactorPages.KeepCodesSafe</p>

<ul class="recovery-codes">
    @foreach (var recoveryCode in Codes)
    {
        <li><code>@recoveryCode</code></li>
    }
</ul>

<p><strong>@TwoFactorPages.ShownOnlyNow</strong> @TwoFactorPages.WriteThemDown</p>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Codes { get; set; } = [];
}
