@attribute [Route(EmailVerification.Path)]
@using Ecnanib.Accounts
@inject IRegistration Registration

@*
    Opening the link only shows this page. The address is verified when the button is pressed,
    so that a mail scanner that opens every link in a message verifies nothing.
*@

<PageTitle>Confirm your email address</PageTitle>

<HeadContent>
    @* The address of this page holds the token, so it is not passed on to a page that is linked from here. *@
    <meta name="referrer" content="no-referrer" />
</HeadContent>

<h1>Confirm your email address</h1>

@if (_outcome is EmailVerificationOutcome.Verified)
{
    <p role="status">Your email address is confirmed.</p>
    <p><a href="@SessionAuthentication.SignInPath">Sign in</a></p>
}
else if (_outcome is EmailVerificationOutcome.LinkNotValid || string.IsNullOrEmpty(Token))
{
    <p role="alert">This link does not work any more. It may have been used, replaced by a later one, or be older than @((int)EmailVerification.LinkLifetime.TotalHours) hours.</p>
    <p><a href="/register">Register again</a> to get a new link.</p>
}
else
{
    <form method="post" @formname="verify-email" @onsubmit="ConfirmAsync">
        <AntiforgeryToken />

        @if (_outcome is null)
        {
            <p>Confirm that this email address is yours to finish registering.</p>
        }
        else
        {
            @* The link of an address that was registered again: whoever reads its mail chooses the password. *@
            <p>This address was registered more than once before it was confirmed. Choose the password of your account now. A password chosen earlier stops working.</p>

            <div class="field">
                <label for="password">Password</label>
                @* The password is never written back into the page. *@
                <input id="password" name="Password" type="password" autocomplete="new-password" required
                       minlength="@PasswordRules.MinimumLength"
                       aria-invalid="@(_outcome is EmailVerificationOutcome.PasswordTooShort or EmailVerificationOutcome.PasswordTooLong ? "true" : null)"
                       aria-describedby="password-hint" />
                <p id="password-hint" class="field-hint">At least @PasswordRules.MinimumLength characters. A long phrase is a good password.</p>
                @if (_outcome is EmailVerificationOutcome.PasswordTooShort)
                {
                    <p class="field-error" role="alert">Choose a password of at least @PasswordRules.MinimumLength characters.</p>
                }
                @if (_outcome is EmailVerificationOutcome.PasswordTooLong)
                {
                    <p class="field-error" role="alert">Choose a password of at most @PasswordRules.MaximumLength characters.</p>
                }
            </div>
        }

        <button type="submit">Confirm my email address</button>
    </form>
}

@code {
    private EmailVerificationOutcome? _outcome;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // The form posts to the address of the page, so the token is in the query both times.
    [SupplyParameterFromQuery(Name = EmailVerification.TokenParameter)]
    private string? Token { get; set; }

    // Asked for only when the link is of an address that was registered again.
    [SupplyParameterFromForm]
    private string? Password { get; set; }

    private async Task ConfirmAsync() =>
        _outcome = await Registration.VerifyEmailAsync(
            Token ?? string.Empty,
            Password,
            HttpContext is { } request ? AuditOrigin.Of(request) : AuditOrigin.Unknown,
            HttpContext?.RequestAborted ?? CancellationToken.None);
}
