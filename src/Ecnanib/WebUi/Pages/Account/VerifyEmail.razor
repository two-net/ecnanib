@attribute [Route(EmailVerification.Path)]
@using Ecnanib.Accounts
@inject IRegistration Registration

@*
    Opening the link only shows this page. The address is verified when the button is pressed,
    so that a mail scanner that opens every link in a message verifies nothing. Its texts are in
    RegistrationPages.
*@

<PageTitle>@RegistrationPages.VerifyTitle</PageTitle>

<HeadContent>
    @* The address of this page holds the token, so it is not passed on to a page that is linked from here. *@
    <meta name="referrer" content="no-referrer" />
</HeadContent>

<h1>@RegistrationPages.VerifyTitle</h1>

@if (_outcome is EmailVerificationOutcome.Verified)
{
    <p class="form-done" role="status">@RegistrationPages.Confirmed</p>
    <p><a href="@SessionAuthentication.SignInPath">@AccountPages.SignInLink</a></p>
}
else if (_outcome is EmailVerificationOutcome.LinkNotValid || string.IsNullOrEmpty(Token))
{
    <p class="form-error" role="alert">@RegistrationPages.LinkNotValid((int)EmailVerification.LinkLifetime.TotalHours)</p>
    <p><a href="/register">@RegistrationPages.RegisterAgain</a> @RegistrationPages.GetNewLink</p>
}
else
{
    <form method="post" @formname="verify-email" @onsubmit="ConfirmAsync">
        <AntiforgeryToken />

        @if (_outcome is null)
        {
            <p>@RegistrationPages.ConfirmToFinish</p>
        }
        else
        {
            @* The link of an address that was registered again: whoever reads its mail chooses the password. *@
            <p>@RegistrationPages.RegisteredAgain</p>

            <div class="field">
                <label for="password">@AccountPages.PasswordLabel</label>
                @* The password is never written back into the page. *@
                <input id="password" name="Password" type="password" autocomplete="new-password" required
                       minlength="@PasswordRules.MinimumLength"
                       aria-invalid="@PageFields.Invalid(PasswordRefused)"
                       aria-describedby="@PageFields.DescribedBy(PageFields.ErrorOf("password", PasswordRefused), "password-hint")"
                       autofocus="@PasswordRefused" />
                <p id="password-hint" class="field-hint">@AccountPages.PasswordHint(PasswordRules.MinimumLength)</p>
                @if (_outcome is EmailVerificationOutcome.PasswordTooShort)
                {
                    <p id="password-error" class="field-error">@AccountPages.PasswordTooShort(PasswordRules.MinimumLength)</p>
                }
                @if (_outcome is EmailVerificationOutcome.PasswordTooLong)
                {
                    <p id="password-error" class="field-error">@AccountPages.PasswordTooLong(PasswordRules.MaximumLength)</p>
                }
            </div>
        }

        <button type="submit">@RegistrationPages.Confirm</button>
    </form>
}

@code {
    private EmailVerificationOutcome? _outcome;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // The form posts to the address of the page, so the token is in the query both times.
    [SupplyParameterFromQuery(Name = EmailVerification.TokenParameter)]
    private string? Token { get; set; }

    // Asked for only when the link is of an address that was registered again.
    [SupplyParameterFromForm]
    private string? Password { get; set; }

    // The field is marked as wrong then, names what says why, and has the focus when the page opens.
    private bool PasswordRefused => _outcome is EmailVerificationOutcome.PasswordTooShort or EmailVerificationOutcome.PasswordTooLong;

    private async Task ConfirmAsync() =>
        _outcome = await Registration.VerifyEmailAsync(
            Token ?? string.Empty,
            Password,
            HttpContext is { } request ? AuditOrigin.Of(request) : AuditOrigin.Unknown,
            HttpContext?.RequestAborted ?? CancellationToken.None);
}
