@attribute [Route(PasswordResetLink.Path)]
@using Ecnanib.Accounts
@inject IPasswordReset PasswordReset
@inject NavigationManager Navigation

@*
    Rendered on the server for each request, and never interactive: the password travels in a form
    post, and not over the connection that an interactive page keeps open. Its texts are in
    PasswordPages.
*@

<PageTitle>@PasswordPages.ResetTitle</PageTitle>

<HeadContent>
    @* The address of this page holds the token, so it is not passed on to a page that is linked from here. *@
    <meta name="referrer" content="no-referrer" />
</HeadContent>

<h1>@PasswordPages.ResetTitle</h1>

@if (_outcome is PasswordResetOutcome.LinkNotValid || string.IsNullOrEmpty(Token))
{
    <p class="form-error" role="alert">@PasswordPages.LinkNotValid((int)PasswordResetLink.Lifetime.TotalMinutes)</p>
    <p><a href="/forgot-password">@PasswordPages.NewLinkLink</a>.</p>
}
else
{
    <form method="post" @formname="reset-password" @onsubmit="ResetAsync">
        <AntiforgeryToken />

        <div class="field">
            <label for="password">@PasswordPages.NewPasswordLabel</label>
            @* The password is never written back into the page. *@
            <input id="password" name="Password" type="password" autocomplete="new-password" required
                   minlength="@PasswordRules.MinimumLength"
                   aria-invalid="@PageFields.Invalid(PasswordRefused)"
                   aria-describedby="@PageFields.DescribedBy(PageFields.ErrorOf("password", PasswordRefused), "password-hint")"
                   autofocus="@PasswordRefused" />
            <p id="password-hint" class="field-hint">@AccountPages.PasswordHint(PasswordRules.MinimumLength)</p>
            @if (_outcome is PasswordResetOutcome.PasswordTooShort)
            {
                <p id="password-error" class="field-error">@AccountPages.PasswordTooShort(PasswordRules.MinimumLength)</p>
            }
            @if (_outcome is PasswordResetOutcome.PasswordTooLong)
            {
                <p id="password-error" class="field-error">@AccountPages.PasswordTooLong(PasswordRules.MaximumLength)</p>
            }
        </div>

        <p>@PasswordPages.SignsOut</p>

        <button type="submit">@PasswordPages.SetPassword</button>
    </form>
}

@code {
    private PasswordResetOutcome? _outcome;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // The form posts to the address of the page, so the token is in the query both times.
    [SupplyParameterFromQuery(Name = PasswordResetLink.TokenParameter)]
    private string? Token { get; set; }

    [SupplyParameterFromForm]
    private string? Password { get; set; }

    // The field is marked as wrong then, names what says why, and has the focus when the page opens.
    private bool PasswordRefused => _outcome is PasswordResetOutcome.PasswordTooShort or PasswordResetOutcome.PasswordTooLong;

    private async Task ResetAsync()
    {
        _outcome = await PasswordReset.ResetAsync(
            Token ?? string.Empty,
            Password ?? string.Empty,
            HttpContext is { } request ? AuditOrigin.Of(request) : AuditOrigin.Unknown,
            HttpContext?.RequestAborted ?? CancellationToken.None);

        if (_outcome is PasswordResetOutcome.Done)
        {
            // A page of its own, without the token in its address.
            Navigation.NavigateTo("/reset-password/done");
        }
    }
}
