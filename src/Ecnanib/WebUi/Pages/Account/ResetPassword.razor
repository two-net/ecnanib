@attribute [Route(PasswordResetLink.Path)]
@using Ecnanib.Accounts
@inject IPasswordReset PasswordReset
@inject NavigationManager Navigation

@*
    Rendered on the server for each request, and never interactive: the password travels in a form
    post, and not over the connection that an interactive page keeps open.
*@

<PageTitle>Choose a new password</PageTitle>

<HeadContent>
    @* The address of this page holds the token, so it is not passed on to a page that is linked from here. *@
    <meta name="referrer" content="no-referrer" />
</HeadContent>

<h1>Choose a new password</h1>

@if (_outcome is PasswordResetOutcome.LinkNotValid || string.IsNullOrEmpty(Token))
{
    <p role="alert">This link does not work any more. It may have been used, replaced by a later one, or be older than @((int)PasswordResetLink.Lifetime.TotalMinutes) minutes.</p>
    <p><a href="/forgot-password">Ask for a new link</a>.</p>
}
else
{
    <form method="post" @formname="reset-password" @onsubmit="ResetAsync">
        <AntiforgeryToken />

        <div class="field">
            <label for="password">New password</label>
            @* The password is never written back into the page. *@
            <input id="password" name="Password" type="password" autocomplete="new-password" required
                   minlength="@PasswordRules.MinimumLength"
                   aria-invalid="@(_outcome is PasswordResetOutcome.PasswordTooShort or PasswordResetOutcome.PasswordTooLong ? "true" : null)"
                   aria-describedby="password-hint" />
            <p id="password-hint" class="field-hint">At least @PasswordRules.MinimumLength characters. A long phrase is a good password.</p>
            @if (_outcome is PasswordResetOutcome.PasswordTooShort)
            {
                <p class="field-error" role="alert">Choose a password of at least @PasswordRules.MinimumLength characters.</p>
            }
            @if (_outcome is PasswordResetOutcome.PasswordTooLong)
            {
                <p class="field-error" role="alert">Choose a password of at most @PasswordRules.MaximumLength characters.</p>
            }
        </div>

        <p>Choosing a new password signs your account out on every device.</p>

        <button type="submit">Set the new password</button>
    </form>
}

@code {
    private PasswordResetOutcome? _outcome;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // The form posts to the address of the page, so the token is in the query both times.
    [SupplyParameterFromQuery(Name = PasswordResetLink.TokenParameter)]
    private string? Token { get; set; }

    [SupplyParameterFromForm]
    private string? Password { get; set; }

    private async Task ResetAsync()
    {
        _outcome = await PasswordReset.ResetAsync(
            Token ?? string.Empty, Password ?? string.Empty, HttpContext?.RequestAborted ?? CancellationToken.None);

        if (_outcome is PasswordResetOutcome.Done)
        {
            // A page of its own, without the token in its address.
            Navigation.NavigateTo("/reset-password/done");
        }
    }
}
