@page "/reset-password/done"
@using Ecnanib.Accounts

@* What a visitor is told after choosing a new password. Its texts are in PasswordPages. *@

<PageTitle>@PasswordPages.DoneTitle</PageTitle>

<h1>@PasswordPages.DoneTitle</h1>

<p role="status">@PasswordPages.Done</p>

<p><a href="@SessionAuthentication.SignInPath">@AccountPages.SignInLink</a> @PasswordPages.WithNewPassword</p>
