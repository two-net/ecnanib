@page "/forgot-password/sent"
@using Ecnanib.Accounts

@*
    The same page whatever the address was, so that it does not tell whether an address has an
    account.
*@

<PageTitle>Check your email</PageTitle>

<h1>Check your email</h1>

<p>We sent a message to the address you entered. If the address has an account, the message holds a link to choose a new password.</p>

<p>The link works for @((int)PasswordResetLink.Lifetime.TotalMinutes) minutes. If no message arrives, look in your spam folder, or <a href="/forgot-password">ask for a new one</a>.</p>
