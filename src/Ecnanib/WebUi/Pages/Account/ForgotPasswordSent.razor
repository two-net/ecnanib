@page "/forgot-password/sent"
@using Ecnanib.Accounts

@*
    The same page whatever the address was, so that it does not tell whether an address has an
    account. Its texts are in PasswordPages.
*@

<PageTitle>@AccountPages.CheckYourEmail</PageTitle>

<h1>@AccountPages.CheckYourEmail</h1>

<p>@PasswordPages.SentExplained</p>

<p>@PasswordPages.LinkWorksFor((int)PasswordResetLink.Lifetime.TotalMinutes) <a href="/forgot-password">@PasswordPages.AskAgainLink</a>.</p>
