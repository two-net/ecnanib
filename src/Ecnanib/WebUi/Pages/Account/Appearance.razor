@attribute [Route(WebUiModule.AppearancePath)]
@attribute [Authorize]
@using Ecnanib.Accounts
@using Ecnanib.WebUi.Animation
@using Ecnanib.WebUi.Themes
@inject IThemeChoice Choice
@inject IMotionChoice MotionChoice
@inject ITimeDisplayChoice TimeChoice
@inject TimeProvider Clock
@inject NavigationManager Navigation

@*
    Rendered on the server for each request, and never interactive. The appearance among the
    settings (FR-UI-2): the user who is signed in chooses Dark, Light, or System here, and the
    choice is saved to their account, so it holds on every device that they sign in on
    (FR-THM-1, FR-THM-3). The page that comes back is written in the theme that was chosen, as
    every page is from then on (FR-THM-4). The choice exposes no key and moves no money, so the
    page asks for no proof of identity. Its texts are in AppearancePages. A visitor chooses for
    their device on a page of their own: DeviceAppearance.

    Under the theme, in a form of its own, the user chooses how much of the pages moves: as
    their device asks, or reduced (FR-ANI-4). That choice is saved to the account too, and each
    of the two is saved by itself. Nothing is stored for a visitor: their pages move as their
    device asks. See docs/motion.md.

    Under that, in a third form, the user chooses the time zone that the pages write a time in:
    the one of their device, or UTC (NFR-USA-3). The choice is saved to the account. Which time
    zone a device is in is the device's to say: the form carries it, as the form of the sign-in
    does, and saving "This device" keeps it on the device, so a device that changed its time
    zone need not be signed in on again. The page says which time zone the device has said. See
    docs/times.md.
*@

<PageTitle>@Screens.Appearance.Name</PageTitle>

<h1>@Screens.Appearance.Name</h1>

<p>@AppearancePages.SavedToAccount</p>

@if (_said is not null)
{
    <p class="form-error" role="alert">@_said</p>
}

<form method="post" @formname="@AppearancePages.Form" @onsubmit="SaveAsync">
    <AntiforgeryToken />

    <ThemeChoices Chosen="@_chosen" />

    <button type="submit">@AppearancePages.Save</button>
</form>

<form method="post" @formname="@AppearancePages.MotionForm" @onsubmit="SaveMotionAsync">
    <AntiforgeryToken />

    <MotionChoices Chosen="@_moves" />

    <button type="submit">@AppearancePages.SaveMotion</button>
</form>

<form method="post" @formname="@AppearancePages.TimeForm" @onsubmit="SaveTimeAsync">
    <AntiforgeryToken />
    <DeviceTimeZoneField />

    <TimeChoices Chosen="@_display" />

    @* What the device has said, which is what "This device" goes by. *@
    <p>@(_deviceZone is null ? AppearancePages.DeviceSaysNone : AppearancePages.DeviceSays(_deviceZone, _deviceOffset))</p>

    <button type="submit">@AppearancePages.SaveTime</button>
</form>

@code {
    private Theme _chosen;
    private Motion _moves;
    private TimeDisplay _display;
    private string? _deviceZone;
    private string _deviceOffset = string.Empty;
    private string? _said;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>The theme that was chosen, as the form spells it.</summary>
    [SupplyParameterFromForm(Name = AppearancePages.Field, FormName = AppearancePages.Form)]
    private string? ThemeEntry { get; set; }

    /// <summary>How much moves, as the other form spells what was chosen.</summary>
    [SupplyParameterFromForm(Name = AppearancePages.MotionField, FormName = AppearancePages.MotionForm)]
    private string? MotionEntry { get; set; }

    /// <summary>Which time zone the pages write a time in, as the third form spells what was chosen.</summary>
    [SupplyParameterFromForm(Name = AppearancePages.TimeField, FormName = AppearancePages.TimeForm)]
    private string? TimeEntry { get; set; }

    /// <summary>What the device says its time zone is, which that form carries, or nothing where no script wrote it.</summary>
    [SupplyParameterFromForm(Name = DeviceTimeZone.Field, FormName = AppearancePages.TimeForm)]
    private string? TimeZoneEntry { get; set; }

    protected override void OnInitialized()
    {
        // The theme of the account of the session, and how much of its pages moves, as this
        // request was told them when it was signed in.
        if (HttpContext is { } request)
        {
            _chosen = PageTheme.Of(request);
            _moves = PageMotion.Of(request);
            _display = PageTimeZone.DisplayOf(request);

            // What the device has said, whatever the account says: it is what "This device" goes by.
            _deviceZone = DeviceTimeZone.NameOf(request.Request);
            _deviceOffset = PageTimes.In(_deviceZone).OffsetAt(Clock.GetUtcNow());
        }
    }

    private async Task SaveAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        if (PageTheme.OfWord(ThemeEntry) is not { } theme)
        {
            // A form that names no theme stores nothing, and comes back as it was.
            _said = AppearancePages.ChooseOne;

            return;
        }

        // The choice of the user of the session, and of no other: no form names a user.
        await Choice.SetAsync(request, theme);

        // The page as it is now, by a request that changes nothing, and in the theme that was
        // chosen: a reload of it sends no form again.
        Navigation.NavigateTo(WebUiModule.AppearancePath);
    }

    private async Task SaveMotionAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        if (PageMotion.OfWord(MotionEntry) is not { } motion)
        {
            // A form that names no choice stores nothing, and comes back as it was.
            _said = AppearancePages.ChooseMotion;

            return;
        }

        // The choice of the user of the session, and of no other: no form names a user.
        await MotionChoice.SetAsync(request, motion);

        // The page as it is now, which says what was chosen to the stylesheet, as every page
        // does from then on.
        Navigation.NavigateTo(WebUiModule.AppearancePath);
    }

    private async Task SaveTimeAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        if (PageTimeZone.OfWord(TimeEntry) is not { } display)
        {
            // A form that names no choice stores nothing, and comes back as it was.
            _said = AppearancePages.ChooseTime;

            return;
        }

        // The choice of the user of the session, and of no other: no form names a user.
        await TimeChoice.SetAsync(request, display);

        // Whoever chooses the device says which time zone it is in now, with the same form: a
        // device that has moved is not signed in on again for it. A choice of UTC leaves what
        // the device said as it is.
        if (display == TimeDisplay.Device)
        {
            DeviceTimeZone.Keep(request.Response, TimeZoneEntry);
        }

        // The page as it is now, by a request that changes nothing: its times are in the time
        // zone that was chosen, as those of every page are from then on.
        Navigation.NavigateTo(WebUiModule.AppearancePath);
    }
}
