@page "/account"
@attribute [Authorize]
@using Ecnanib.Accounts
@inject ITwoFactor TwoFactorAuthentication

<PageTitle>Your account</PageTitle>

<h1>Your account</h1>

<p>You are signed in as @HttpContext?.User.Identity?.Name.</p>

<h2>Two-factor authentication</h2>

@if (_twoFactor is { IsOn: true })
{
    <p>On. Signing in takes a code from your authenticator app after your password. You have @_twoFactor.RecoveryCodesLeft of @TwoFactorRules.RecoveryCodeCount recovery codes left.</p>

    <p><a href="/account/two-factor">Manage two-factor authentication</a></p>
}
else
{
    <p>Off. Signing in takes your password alone.</p>

    <p><a href="/account/two-factor">Turn on two-factor authentication</a></p>
}

<h2>API keys</h2>

<p>Your agents work with your own keys of the AI providers and of Binance. A key is stored encrypted, and after saving you see only its last four characters.</p>

<p><a href="@WebUiModule.KeysPath">Manage your API keys</a></p>

<h2>Your data</h2>

<p>What is stored about you is your email address, when you registered and verified it, the legal documents you accepted, the devices you are signed in on, the security-relevant actions of your account, and which keys you stored. Your password is stored only as a hash, and a key only encrypted: neither is in a download, which names a key by its last four characters.</p>

@* Marked as a download, so that the browser asks for the file once and does not try to show it as a page. *@
<p><a href="@WebUiModule.ExportPath" download>Download your data</a></p>

<h2>Delete your account</h2>

<p>Deleting your account removes it and everything that belongs to it, for good. You are asked to confirm that it is you first.</p>

<p><a href="@WebUiModule.DeleteAccountPath">Delete your account</a></p>

@code {
    private TwoFactorState? _twoFactor;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is { } request)
        {
            _twoFactor = await TwoFactorAuthentication.StateAsync(request);
        }
    }
}
