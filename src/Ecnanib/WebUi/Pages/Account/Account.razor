@page "/account"
@attribute [Authorize]
@using Ecnanib.Accounts
@using Ecnanib.Notifications
@using Ecnanib.WebUi.Animation
@using Ecnanib.WebUi.Themes
@inject ITwoFactor TwoFactorAuthentication
@inject IEmailOptIn EmailOptIn

@* The page of the account itself: what is set for it, with the way to each of its settings. Its texts are in AccountPages. *@

<PageTitle>@AccountPages.Title</PageTitle>

<h1>@AccountPages.Title</h1>

<p>@AccountPages.SignedInAs(HttpContext?.User.Identity?.Name)</p>

<h2>@AccountPages.TwoFactorHeading</h2>

@if (_twoFactor is { IsOn: true })
{
    <p>@AccountPages.TwoFactorOn(_twoFactor.RecoveryCodesLeft, TwoFactorRules.RecoveryCodeCount)</p>

    <p><a href="/account/two-factor">@AccountPages.ManageTwoFactorLink</a></p>
}
else
{
    <p>@AccountPages.TwoFactorOff</p>

    <p><a href="/account/two-factor">@AccountPages.TurnOnTwoFactorLink</a></p>
}

<h2>@AccountPages.KeysHeading</h2>

<p>@AccountPages.KeysExplained</p>

<p><a href="@WebUiModule.KeysPath">@AccountPages.KeysLink</a></p>

<h2>@AccountPages.NotificationsHeading</h2>

<p>@AccountPages.NotificationsExplained <a href="@WebUiModule.NotificationsPath">@AccountPages.NotificationsLink</a>.</p>

@* A preference that is stored: whether the user is sent email for critical events (FR-NTF-3). It is chosen on a page of its own. *@
@if (_emailOn)
{
    <p>@AccountPages.EmailOn</p>

    <p><a href="@WebUiModule.NotificationEmailPath">@AccountPages.ManageEmailLink</a></p>
}
else
{
    <p>@AccountPages.EmailOff</p>

    <p><a href="@WebUiModule.NotificationEmailPath">@AccountPages.TurnOnEmailLink</a></p>
}

<h2>@AccountPages.AppearanceHeading</h2>

@* Another preference that is stored: the theme of the account (FR-THM-3). It is chosen on a page of its own. *@
<p>@AppearancePages.Stored(_theme)</p>

@* And how much of the pages moves (FR-ANI-4), which is chosen on the same page. *@
<p>@AppearancePages.Stored(_motion)</p>

@* And the time zone that the pages write a time in (NFR-USA-3), which is chosen there too. *@
<p>@AppearancePages.Stored(_display)</p>

<p><a href="@WebUiModule.AppearancePath">@AccountPages.AppearanceLink</a></p>

<h2>@AccountPages.DataHeading</h2>

<p>@AccountPages.DataExplained</p>

@* The other preference that is stored: whether the user left the board (FR-EXP-10). It is chosen on the board itself. *@
<p>@AccountPages.BoardCounts <a href="@WebUiModule.BoardPath">@AccountPages.BoardLink</a>, @AccountPages.BoardExplained</p>

@* Marked as a download, so that the browser asks for the file once and does not try to show it as a page. *@
<p><a href="@WebUiModule.ExportPath" download>@AccountPages.DownloadLink</a></p>

@* What the agents of the user traded and decided is not in that download: it is two files of its own (FR-RPT-4). *@
<p>@ExportFiles.Explained</p>

<p><a href="@WebUiModule.TradesExportPath" download>@ExportFiles.TradesLink</a></p>

<p><a href="@WebUiModule.DecisionsExportPath" download>@ExportFiles.DecisionsLink</a></p>

<h2>@AccountPages.DeleteTitle</h2>

<p>@AccountPages.DeleteExplained</p>

<p><a href="@WebUiModule.DeleteAccountPath">@AccountPages.DeleteTitle</a></p>

@code {
    private TwoFactorState? _twoFactor;
    private bool _emailOn;
    private Theme _theme;
    private Motion _motion;
    private TimeDisplay _display;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is { } request)
        {
            _twoFactor = await TwoFactorAuthentication.StateAsync(request);
            _emailOn = (await EmailOptIn.StateAsync(request)).On;

            // The theme of the account, and how much of its pages moves, as this request was
            // told them when it was signed in.
            _theme = PageTheme.Of(request);
            _motion = PageMotion.Of(request);
            _display = PageTimeZone.DisplayOf(request);
        }
    }
}
