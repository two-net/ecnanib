@attribute [Route(WebUiModule.NotificationsPath)]
@attribute [Authorize]
@using Ecnanib.Agents
@using Ecnanib.Notifications
@using Ecnanib.Platform.LiveUpdates
@using Ecnanib.Shared
@inject INotifications Stored
@inject IStoredAgents Agents
@inject ILiveSignals Live
@inject NavigationManager Navigation

@*
    Rendered on the server for each request. The page shows what the
    service told the user who is signed in, and nobody else (FR-NTF-1): every notification, read
    and not read, the newest first, a page of them at a time. A form of the page marks one
    notification as read, and another marks all of them: the forms are on the page whenever one
    is posted, for the notifications that are not read then. The form that marks all names the
    newest notification that the page showed, so that one which was raised since is not marked
    as read by a user who has not seen it. A notification says whether it is read in words, and
    names its agent by the name that its user gave it, where the user still has the agent. What
    a notification says is written as text, like everything else on a page (NFR-SEC-4). An
    address that names a page which there is not is answered with "not found". The times are UTC.
    The page follows what changes (FR-NTF-2): when a notification of its user is raised or read,
    or an agent of theirs changes, whose name a notification says, the page asks for itself
    again, so a notification shows without a manual refresh. See docs/live-updates.md. Its texts
    are in NotificationPages.
*@

@if (_list is not null)
{
    <PageTitle>@NotificationPages.Title</PageTitle>

    <h1 id="notifications-heading">@NotificationPages.Title</h1>

    <p>@NotificationPages.Explained</p>

    @* That the page follows what changes, with what pauses it: see LivePause (NFR-USA-1). *@
    <LivePause />

    @if (_list.Total == 0)
    {
        <p>@NotificationPages.None</p>
    }
    else
    {
        <p>@NotificationPages.Listed(_list)</p>

        @if (_list.Unread > 0 && _list.Latest is { } latest)
        {
            <form method="post" @formname="@NotificationPages.MarkAllForm" @onsubmit="MarkAllAsync">
                <AntiforgeryToken />

                @* The newest that this page knows of: what is raised after it stays not read. *@
                <input type="hidden" name="@NotificationPages.ThroughField" value="@latest" />

                <button type="submit">@NotificationPages.MarkAll</button>
            </form>
        }

        <ul class="notifications" aria-labelledby="notifications-heading">
            @foreach (var notification in _list.Notifications)
            {
                <li class="@(notification.IsRead ? "notification" : "notification notification-unread")" data-key="@notification.Id">
                    <p><strong>@NotificationTypes.Describe(notification.Type)</strong>, @Times.At(notification.CreatedAt). @(notification.IsRead ? NotificationPages.Read : NotificationPages.NotRead)</p>

                    <p id="@NotificationPages.TextId(notification.Id)">@notification.Content</p>

                    @if (!notification.IsRead || NameOf(notification) is not null)
                    {
                        <div class="lesson-actions">
                            @if (NameOf(notification) is { } name && notification.AgentId is { } agentId)
                            {
                                @* The agent by the name that its user gave it. One that was deleted has no page. *@
                                <a href="@WebUiModule.AgentStatePath(agentId)">@NotificationPages.AgentLink(name)</a>
                            }

                            @if (!notification.IsRead)
                            {
                                <form method="post" @formname="@NotificationPages.MarkReadForm(notification.Id)" @onsubmit="() => MarkReadAsync(notification.Id)">
                                    <AntiforgeryToken />

                                    @* Every such button says the same: it is described by what its notification says. *@
                                    <button type="submit" aria-describedby="@NotificationPages.TextId(notification.Id)">@NotificationPages.MarkRead</button>
                                </form>
                            }
                        </div>
                    }
                </li>
            }
        </ul>

        @if (_list.Pages > 1)
        {
            @* Another page of the list is asked for as a page of its own, so it opens with the focus at its heading (NFR-USA-1). *@
            <nav class="lesson-pages" aria-label="@NotificationPages.PagesNavigation" data-enhance-nav="false">
                @if (_list.Page > 1)
                {
                    <a href="@LivePages.Kept(HttpContext?.Request, WebUiModule.NotificationsPagePath(_list.Page - 1))">@NotificationPages.NewerLink</a>
                }

                @if (_list.Page < _list.Pages)
                {
                    <a href="@LivePages.Kept(HttpContext?.Request, WebUiModule.NotificationsPagePath(_list.Page + 1))">@NotificationPages.OlderLink</a>
                }
            </nav>
        }
    }

    <p><a href="@WebUiModule.NotificationEmailPath">@NotificationPages.EmailTitle</a></p>

    <p><a href="@WebUiModule.AgentsPath">@NotificationPages.AgentsLink</a></p>

    <LiveUpdates Follows="@Followed" Since="@_since" />
}

@code {
    /// <summary>The times of the page: every time is written in its time zone (NFR-USA-3). See docs/times.md.</summary>
    [CascadingParameter]
    private PageTimes Times { get; set; } = PageTimes.Utc;

    // What the page asks for itself again on: a notification, and an agent, whose name one says.
    private static readonly LiveSubject[] Followed = [LiveSubject.Notification, LiveSubject.Agent];

    private NotificationList? _list;
    private IReadOnlyDictionary<Guid, string> _names = new Dictionary<Guid, string>();
    private int _page = 1;
    private long _since;

    // What the form that marks all as read says the page showed.
    [SupplyParameterFromForm(Name = NotificationPages.ThroughField)]
    private string? ThroughEntry { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        // An address that makes a choice of following which there is not has no page, as one
        // with a page number that is none has not: see LivePause.
        if (LivePages.PausedOf(request.Request.Query) is null)
        {
            Navigation.NotFound();

            return;
        }

        // An address that names a page which there is not is not found: the page shows what
        // its address asks for, and never something else in its place.
        if (NotificationPages.PageOf(request.Request.Query) is not { } page)
        {
            Navigation.NotFound();

            return;
        }

        // Before the page reads: what changes from here on is what the page may not show.
        _since = Live.Mark();

        // Asked for the user of the session: the notifications of another user are not found.
        var list = await Stored.OfUserAsync(request, page);

        // A page after the last one is none that there is. The first page is always there.
        if (page > list.Pages)
        {
            Navigation.NotFound();

            return;
        }

        // The agents of the user of the session, by the names that their user gave them. A
        // notification stays when its agent is deleted, and then names none.
        _names = (await Agents.ListAsync(request)).Agents.ToDictionary(agent => agent.Id, agent => agent.Name);
        _page = page;
        _list = list;
    }

    private string? NameOf(NotificationView notification) =>
        notification.AgentId is { } agentId && _names.TryGetValue(agentId, out var name) ? name : null;

    private async Task MarkReadAsync(Guid notificationId)
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        // Asked for by owner again: the notification that the form names, among those of the
        // user of the session.
        await Stored.MarkReadAsync(request, notificationId);

        // The page as it is now, by the address that it was asked for by. A reload of it sends
        // no form again.
        Navigation.NavigateTo(LivePages.Kept(request.Request, WebUiModule.NotificationsPagePath(_page)));
    }

    private async Task MarkAllAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        // What the form says is an id as the page wrote it, and names a notification of the
        // user of the session: anything else marks nothing.
        if (Guid.TryParseExact(ThroughEntry, "D", out var through))
        {
            await Stored.MarkAllReadAsync(request, through);
        }

        Navigation.NavigateTo(LivePages.Kept(request.Request, WebUiModule.NotificationsPagePath(_page)));
    }
}
