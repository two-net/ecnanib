@page "/Error"
@using Ecnanib.Platform.Logging

<PageTitle>Something went wrong</PageTitle>

<h1>Something went wrong.</h1>

<p>The error has been recorded. Try again in a moment.</p>

@if (Reference is not null)
{
    <p>
        If it keeps happening, report it with this reference: <code>@Reference</code>
    </p>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // The id the error was logged under (NFR-LOG-6). Nothing of the error itself is shown.
    private string? Reference { get; set; }

    protected override void OnInitialized() =>
        Reference = HttpContext is null ? null : UnhandledErrors.ReferenceOf(HttpContext);
}
