@page "/Error"
@using Ecnanib.Platform.Logging

@* What a page that failed says in its place. Its texts are in HomePages. *@

<PageTitle>@HomePages.ErrorTitle</PageTitle>

<h1>@HomePages.ErrorHeading</h1>

<p>@HomePages.ErrorRecorded</p>

@if (Reference is not null)
{
    <p>@HomePages.ErrorReference <code>@Reference</code></p>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // The id the error was logged under (NFR-LOG-6). Nothing of the error itself is shown.
    private string? Reference { get; set; }

    protected override void OnInitialized() =>
        Reference = HttpContext is null ? null : UnhandledErrors.ReferenceOf(HttpContext);
}
