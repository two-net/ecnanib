<th scope="col">@ExperiencePages.AverageRHeading</th>
<th scope="col">@ExperiencePages.TotalRHeading</th>
<th scope="col">@ExperiencePages.ProfitFactorHeading</th>
<th scope="col">@ExperiencePages.DrawdownHeading</th>
<th scope="col">@ExperiencePages.HeldHeading</th>
<th scope="col">@ExperiencePages.NotesHeading</th>
