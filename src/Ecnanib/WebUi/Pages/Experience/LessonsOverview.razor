@attribute [Route(WebUiModule.LessonsPath)]
@attribute [Authorize]
@using Ecnanib.Accounts
@using Ecnanib.Agents
@using Ecnanib.Experience
@using Ecnanib.Platform.Settings
@inject ILessons Stored
@inject IStoredAgents Agents
@inject ExperienceSettings Settings
@inject NavigationManager Navigation

@*
    Rendered on the server for each request, and never interactive. The page shows the lessons of
    the user who is signed in, and no others (FR-EXP-8): what the models of the Risk Managers of
    their agents wrote after closed positions, the most recently closed first, a page of them at
    a time, of every agent or of the one that the address names. A form of the page disables a
    lesson, or enables it again: the forms are on the page whenever one is posted, for the
    lessons that it shows then. Deleting a lesson and resetting the lessons of an agent each have
    a page of their own, which asks once more. The page says what a lesson is, who writes it and
    under whose key, and where it is recalled (FR-EXP-6, FR-EXP-7, NFR-SEC-8), and states what
    every experience screen states (FR-EXP-11). A lesson says its mode as a word: the page shows
    lessons of both modes, and has no badge (FR-BIN-11). What a model wrote is written as text,
    like everything else on a page (NFR-SEC-4). An address that names a choice which there is not
    is answered with "not found". The times are UTC. Its texts are in LessonPages.
*@

@if (_list is not null)
{
    var title = _agent is null ? LessonPages.Title : LessonPages.TitleOf(_agent.Name);

    <PageTitle>@title</PageTitle>

    <h1 id="lessons-heading">@title</h1>

    <p>@LessonPages.Explained</p>

    <p>@LessonPages.RecallExplained(Settings.LessonsPerPrompt)</p>

    <p>@LessonPages.ManageExplained</p>

    <ExperienceNotes />

    @if (LessonPages.Waiting(_list.Waiting) is { } waiting)
    {
        <p role="note">@waiting</p>
    }

    @if (LessonPages.Unwritten(_list.Unwritten) is { } unwritten)
    {
        <p role="note">@unwritten</p>
    }

    @if (_list.Lessons.Count == 0)
    {
        <p>@(_agent is null ? LessonPages.None : LessonPages.NoneOfAgent)</p>
    }
    else
    {
        <p>@LessonPages.Listed(_list.Written) @LessonPages.PageOf(_list).</p>

        <section class="lessons" aria-labelledby="lessons-heading">
            @foreach (var lesson in _list.Lessons)
            {
                <article class="lesson" aria-labelledby="@LessonPages.HeadingId(lesson.Id)">
                    <h2 id="@LessonPages.HeadingId(lesson.Id)">@LessonPages.HeadingOf(lesson)</h2>

                    @* The agent by the name that its user gave it, and the mode of the trade as a word. *@
                    <p>@LessonPages.AgentLabel <a href="@WebUiModule.LessonsOfAgentPath(lesson.AgentId)">@NameOf(lesson.AgentId)</a>, @LessonPages.TradedIn(lesson) @LessonPages.ClosedAt(Times.At(lesson.ClosedAt))</p>

                    <dl>
                        <dt>@LessonPages.SetupLabel</dt>
                        <dd>@lesson.Setup</dd>
                        <dt>@LessonPages.ExpectedLabel</dt>
                        <dd>@lesson.Expected</dd>
                        <dt>@LessonPages.HappenedLabel</dt>
                        <dd>@lesson.Happened</dd>
                        <dt>@LessonPages.TakeawayLabel</dt>
                        <dd>@lesson.Takeaway</dd>
                        @if (lesson.Tags.Count > 0)
                        {
                            <dt>@LessonPages.TagsLabel</dt>
                            <dd>@LessonPages.Tags(lesson)</dd>
                        }
                    </dl>

                    <p>@(lesson.Enabled ? LessonPages.EnabledExplained : LessonPages.DisabledExplained)</p>

                    @* Named after the lesson, so that each control says what it is for by itself. *@
                    <div class="lesson-actions">
                        @if (lesson.Enabled)
                        {
                            <form method="post" @formname="@LessonPages.DisableForm(lesson.Id)" @onsubmit="() => SetEnabledAsync(lesson, enabled: false)">
                                <AntiforgeryToken />

                                <button type="submit">@LessonPages.DisableLesson(lesson, Times)</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" @formname="@LessonPages.EnableForm(lesson.Id)" @onsubmit="() => SetEnabledAsync(lesson, enabled: true)">
                                <AntiforgeryToken />

                                <button type="submit">@LessonPages.EnableLesson(lesson, Times)</button>
                            </form>
                        }

                        <a href="@WebUiModule.DeleteAgentLessonPath(lesson.AgentId, lesson.Id)">@LessonPages.DeleteLesson(lesson, Times)</a>
                    </div>
                </article>
            }
        </section>

        @if (_list.Pages > 1)
        {
            @* Another page of the list is asked for as a page of its own, so it opens with the focus at its heading (NFR-USA-1). *@
            <nav class="lesson-pages" aria-label="@LessonPages.PagesLabel" data-enhance-nav="false">
                @if (_list.Page > 1)
                {
                    <a href="@WebUiModule.LessonsOfAgentPath(_agent?.Id, _list.Page - 1)">@LessonPages.NewerLessons</a>
                }

                @if (_list.Page < _list.Pages)
                {
                    <a href="@WebUiModule.LessonsOfAgentPath(_agent?.Id, _list.Page + 1)">@LessonPages.OlderLessons</a>
                }
            </nav>
        }
    }

    @if (_agent is not null)
    {
        <p><a href="@WebUiModule.ResetAgentLessonsPath(_agent.Id)">@LessonPages.ResetOf(_agent.Name)</a></p>

        <p><a href="@WebUiModule.AgentStatePath(_agent.Id)">@LessonPages.StateLink</a></p>

        <p><a href="@WebUiModule.LessonsPath">@LessonPages.OfEveryAgentLink</a></p>
    }

    <p><a href="@WebUiModule.ExperiencePath">@ExperiencePages.Title</a></p>

    <p><a href="@WebUiModule.AgentsPath">@LessonPages.AgentsLink</a></p>
}

@code {
    /// <summary>The times of the page: every time is written in its time zone (NFR-USA-3). See docs/times.md.</summary>
    [CascadingParameter]
    private PageTimes Times { get; set; } = PageTimes.Utc;

    private LessonList? _list;
    private AgentView? _agent;
    private IReadOnlyDictionary<Guid, string> _names = new Dictionary<Guid, string>();
    private int _page = 1;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        // An address that names a choice which there is not is not found: the page shows what
        // its address asks for, and never something else in its place.
        if (LessonPages.ChoicesOf(request.Request.Query) is not var (agentId, page))
        {
            Navigation.NotFound();

            return;
        }

        // The agents of the user of the session, by the names that their user gave them. An
        // agent of another user is not among them, so its lessons are not found, like those of
        // an agent that does not exist.
        var agents = (await Agents.ListAsync(request)).Agents;

        if (agentId is { } asked && agents.All(agent => agent.Id != asked))
        {
            Navigation.NotFound();

            return;
        }

        // Experience may not use Accounts, so it is handed the user who is signed in, and
        // answers with the lessons of that user alone.
        var list = await Stored.OfUserAsync(SignedInUser.RequiredIdOf(request), agentId, page, request.RequestAborted);

        // A page after the last one is none that there is. The first page is always there.
        if (page > list.Pages)
        {
            Navigation.NotFound();

            return;
        }

        _agent = agents.SingleOrDefault(agent => agent.Id == agentId);
        _names = agents.ToDictionary(agent => agent.Id, agent => agent.Name);
        _page = page;
        _list = list;
    }

    // The lessons of an agent go with it, so every lesson has an agent that is listed.
    private string NameOf(Guid agentId) => _names.TryGetValue(agentId, out var name) ? name : LessonPages.UnnamedAgent;

    private async Task SetEnabledAsync(LessonView lesson, bool enabled)
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        // Asked for by owner again: the lesson that the form names, among those of the user of
        // the session. One that went meanwhile changes nothing.
        await Stored.SetEnabledAsync(SignedInUser.RequiredIdOf(request), lesson.Id, enabled, request.RequestAborted);

        // The page as it is now, by the address that it was asked for by. A reload of it sends
        // no form again.
        Navigation.NavigateTo(WebUiModule.LessonsOfAgentPath(_agent?.Id, _page));
    }
}
