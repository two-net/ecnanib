@page "/experience/models/{ModelId:guid}"
@attribute [Authorize]
@using Ecnanib.Accounts
@using Ecnanib.Catalog
@using Ecnanib.Experience
@using Ecnanib.WebUi.Pages.Agents
@using Ecnanib.WebUi.Pages.Catalog
@inject ICatalogModels Models
@inject ITrackRecords Records
@inject IRoleStrengths Strengths
@inject NavigationManager Navigation

@*
    Rendered on the server for each request, and never interactive. It is the page of a model's
    experience record, which the catalog links each model to (FR-CAT-10): the track record of
    the model from the closed trades of the user who is signed in, in each role and in any role,
    filterable by market, timeframe, mode, and period (FR-EXP-2). It shows one mode, as a badge
    under its heading, and leads to the other: Demo and Live are never added up (FR-EXP-9,
    FR-BIN-11). It states what the figures cannot tell whatever it has to show (FR-EXP-11).
    Under the records it shows the strength score of the model in each role, market, and
    timeframe, in the same mode, with its formula (FR-EXP-3, FR-EXP-4). A model is named by its
    id in the catalog, and a path that names none is answered with "not found", as an address is
    that names a choice which there is not. A model is never deleted, so the page of one that
    its provider no longer offers stays, and so does the page of one that no trade of the user
    counts for: it says so. The records are asked for by owner. Its texts are in ExperiencePages.
*@

@if (_model is not null && _view is not null && _strengths is not null && _filter is not null)
{
    var scope = _view.Scope;

    <PageTitle>@ExperiencePages.TitleOf(CatalogPages.NameOf(_model))</PageTitle>

    <h1>@ExperiencePages.TitleOf(CatalogPages.NameOf(_model))</h1>

    <p>@ExperiencePages.BadgeLabel <ModeBadge Mode="@scope.Mode" /> @ExperiencePages.ModeExplained(scope) @ExperiencePages.NeverAddedUp <a href="@ExperiencePages.ModelPath(_model.Id, _filter with { Mode = ExperiencePages.OtherThan(scope.Mode) })">@ExperiencePages.OtherModeLink(scope)</a></p>

    <p>@ExperiencePages.ModelOfProvider(_model.ProviderName) <code>@_model.Identifier</code>.</p>

    <p>@ExperiencePages.StatusInCatalog(CatalogPages.Status(_model, Times))</p>

    <ExperienceNotes />

    <ExperienceFilter Action="@WebUiModule.ModelExperiencePath(_model.Id)" Filter="@_filter" WithRole="false" />

    <p>@ExperiencePages.PeriodExplained(scope, Times) @ExperiencePages.CountsForModel</p>

    @if (ExperiencePages.Awaiting(scope) is { } awaiting)
    {
        <p role="note">@awaiting</p>
    }

    @if (ExperiencePages.WithoutR(scope) is { } withoutR)
    {
        <p role="note">@withoutR</p>
    }

    <h2 id="model-experience-roles">@ExperiencePages.ByRoleHeading</h2>

    @if (scope.Trades == 0)
    {
        <p>@ExperiencePages.NoTradesOfModel(scope)</p>
    }
    else
    {
        @* The table is wider than a narrow screen, so it scrolls by itself, also by keyboard. *@
        <div class="track-records" role="region" aria-labelledby="model-experience-roles" tabindex="0">
            <table>
                <caption>@ExperiencePages.RolesCaption(scope.Mode)</caption>
                <thead>
                    <tr>
                        <th scope="col">@ExperiencePages.RoleHeading</th>
                        <TrackRecordHeadings />
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in _view.Roles)
                    {
                        <tr>
                            <th scope="row">@ExperiencePages.NameOf(role.Role)</th>
                            <TrackRecordCells Record="@role.Record" />
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p>@ExperiencePages.EstimatesExplained</p>
    }

    <p>@ExperiencePages.FollowsPositions</p>

    <RoleStrengthsTable View="@_strengths" Filter="@_filter" HeadingId="model-experience-strengths" WithModel="false" />

    <p><a href="@ExperiencePages.Path(_filter with { Role = null })">@ExperiencePages.OfEveryModelLink</a></p>

    <p><a href="@WebUiModule.CatalogPath">@ExperiencePages.BackToCatalogLink</a></p>
}

@code {
    /// <summary>The times of the page: every time is written in its time zone (NFR-USA-3). See docs/times.md.</summary>
    [CascadingParameter]
    private PageTimes Times { get; set; } = PageTimes.Utc;

    private CatalogModel? _model;
    private TrackRecordFilter? _filter;
    private ModelTrackRecordView? _view;
    private RoleStrengthView? _strengths;

    [Parameter]
    public Guid ModelId { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        _model = await Models.FindAsync(ModelId, request.RequestAborted);

        // An address that names a choice which there is not is not found, like a path that
        // names no model: the page shows what its address asks for, and nothing in its place.
        _filter = ExperiencePages.FilterOf(request.Request.Query);

        if (_model is null || _filter is null)
        {
            Navigation.NotFound();

            return;
        }

        // The catalog is the same for everyone, and the trades are not: Experience is handed
        // the user who is signed in, and works out the record from the trades of that user alone.
        _view = await Records.OfModelAsync(SignedInUser.RequiredIdOf(request), _model.Id, _filter, request.RequestAborted);

        // The strength scores of the model are of the mode that the page shows, which its
        // records above say: a page shows one mode, and never both (FR-EXP-9, FR-BIN-11).
        _strengths = await Strengths.OfModelAsync(
            SignedInUser.RequiredIdOf(request), _model.Id, _filter, _view.Scope.Mode, request.RequestAborted);
    }
}
