@page "/experience/models/{ModelId:guid}"
@attribute [Authorize]
@using Ecnanib.Accounts
@using Ecnanib.Catalog
@using Ecnanib.Experience
@using Ecnanib.WebUi.Pages.Agents
@using Ecnanib.WebUi.Pages.Catalog
@inject ICatalogModels Models
@inject ITrackRecords Records
@inject NavigationManager Navigation

@*
    Rendered on the server for each request, and never interactive. It is the page of a model's
    experience record, which the catalog links each model to (FR-CAT-10): the track record of
    the model from the closed trades of the user who is signed in, in each role and in any role,
    filterable by market, timeframe, mode, and period (FR-EXP-2). It shows one mode, as a badge
    under its heading, and leads to the other: Demo and Live are never added up (FR-EXP-9,
    FR-BIN-11). It states what the figures cannot tell whatever it has to show (FR-EXP-11). A
    model is named by its id in the catalog, and a path that names none is answered with "not
    found", as an address is that names a choice which there is not. A model is never deleted,
    so the page of one that its provider no longer offers stays, and so does the page of one
    that no trade of the user counts for: it says so. The records are asked for by owner.
*@

@if (_model is not null && _view is not null && _filter is not null)
{
    var scope = _view.Scope;

    <PageTitle>Experience of @CatalogPages.NameOf(_model)</PageTitle>

    <h1>Experience of @CatalogPages.NameOf(_model)</h1>

    <p>Mode: <ModeBadge Mode="@scope.Mode" /> @ExperiencePages.ModeExplained(scope) @ExperiencePages.NeverAddedUp <a href="@ExperiencePages.ModelPath(_model.Id, _filter with { Mode = ExperiencePages.OtherThan(scope.Mode) })">@ExperiencePages.OtherModeLink(scope)</a></p>

    <p>A model of @_model.ProviderName, which names it <code>@_model.Identifier</code>.</p>

    <p>Status in the catalog: @CatalogPages.Status(_model)</p>

    <ExperienceNotes />

    <ExperienceFilter Action="@WebUiModule.ModelExperiencePath(_model.Id)" Filter="@_filter" WithRole="false" />

    <p>@ExperiencePages.PeriodExplained(scope) @ExperiencePages.CountsForModel</p>

    @if (ExperiencePages.Awaiting(scope) is { } awaiting)
    {
        <p role="note">@awaiting</p>
    }

    @if (ExperiencePages.WithoutR(scope) is { } withoutR)
    {
        <p role="note">@withoutR</p>
    }

    <h2 id="model-experience-roles">By role</h2>

    @if (scope.Trades == 0)
    {
        <p>@ExperiencePages.NoTradesOfModel(scope)</p>
    }
    else
    {
        @* The table is wider than a narrow screen, so it scrolls by itself, also by keyboard. *@
        <div class="track-records" role="region" aria-labelledby="model-experience-roles" tabindex="0">
            <table>
                <caption>The track record of the model in @scope.Mode, by the role that it held</caption>
                <thead>
                    <tr>
                        <th scope="col">Role</th>
                        <TrackRecordHeadings />
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in _view.Roles)
                    {
                        <tr>
                            <th scope="row">@ExperiencePages.NameOf(role.Role)</th>
                            <TrackRecordCells Record="@role.Record" />
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p>@ExperiencePages.EstimatesExplained</p>
    }

    <p>@ExperiencePages.FollowsPositions</p>

    <p><a href="@ExperiencePages.Path(_filter with { Role = null })">Experience of every provider and model</a></p>

    <p><a href="@WebUiModule.CatalogPath">Back to the model catalog</a></p>
}

@code {
    private CatalogModel? _model;
    private TrackRecordFilter? _filter;
    private ModelTrackRecordView? _view;

    [Parameter]
    public Guid ModelId { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not { } request)
        {
            return;
        }

        _model = await Models.FindAsync(ModelId, request.RequestAborted);

        // An address that names a choice which there is not is not found, like a path that
        // names no model: the page shows what its address asks for, and nothing in its place.
        _filter = ExperiencePages.FilterOf(request.Request.Query);

        if (_model is null || _filter is null)
        {
            Navigation.NotFound();

            return;
        }

        // The catalog is the same for everyone, and the trades are not: Experience is handed
        // the user who is signed in, and works out the record from the trades of that user alone.
        _view = await Records.OfModelAsync(SignedInUser.RequiredIdOf(request), _model.Id, _filter, request.RequestAborted);
    }
}
