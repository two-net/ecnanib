@using Ecnanib.Accounts
@using Ecnanib.WebUi.Pages.Account

@*
    The choice of the time zone that the pages write a time in, as the page of the appearance
    offers it: this device, and UTC, one under another, each with what it means below it
    (NFR-USA-3). It is the fields of a form and no form itself, as the choice of a theme is: the
    page around it has the form. The one that is chosen now is ticked. Its texts are in
    AppearancePages.
*@

<fieldset>
    <legend>@AppearancePages.TimeLegend</legend>

    @foreach (var display in AppearancePages.TimeChoices)
    {
        var word = PageTimeZone.WordOf(display);

        <div class="choice">
            <input id="times-@(word)" type="radio" name="@AppearancePages.TimeField" value="@word" required
                   checked="@(display == Chosen)" aria-describedby="times-@(word)-hint" />
            <label for="times-@(word)">@AppearancePages.NameOf(display)</label>
            <p id="times-@(word)-hint" class="field-hint">@AppearancePages.Explain(display)</p>
        </div>
    }
</fieldset>

@code {
    /// <summary>What is chosen now.</summary>
    [Parameter, EditorRequired]
    public TimeDisplay Chosen { get; set; }
}
