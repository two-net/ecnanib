<script type="module" src="@Assets["WebUi/Layout/ReconnectModal.razor.js"]"></script>

@*
    The dialog that says the page is rejoining the server, on a page that follows what changes.
    It has a name, and what it says is one part that a screen reader reads out as it changes
    (NFR-USA-1): the framework shows one sentence of it at a time. The seconds that count down
    are left out of that, so they are not read out one by one. Its buttons stand after it.
    Its texts are in ConnectionPages.
*@
<dialog id="components-reconnect-modal" data-nosnippet aria-label="@Screens.ServerConnection" aria-describedby="components-reconnect-said">
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <div id="components-reconnect-said" role="status">
            <p class="components-reconnect-first-attempt-visible">@ConnectionPages.Rejoining</p>
            @* The words around the seconds bring their own blanks: see ConnectionPages. *@
            <p class="components-reconnect-repeated-attempt-visible">@ConnectionPages.RejoinFailed<span aria-hidden="true">@ConnectionPages.TriesAgainIn<span id="components-seconds-to-next-attempt"></span>@ConnectionPages.Seconds</span>.</p>
            <p class="components-reconnect-failed-visible">@ConnectionPages.NotRejoined<br />@ConnectionPages.RetryOrReload</p>
            <p class="components-pause-visible">@ConnectionPages.Paused</p>
            <p class="components-resume-failed-visible">@ConnectionPages.NotResumed<br />@ConnectionPages.RetryOrReload</p>
        </div>
        <button type="button" id="components-reconnect-button" class="components-reconnect-failed-visible">@ConnectionPages.Retry</button>
        <button type="button" id="components-resume-button" class="components-pause-visible components-resume-failed-visible">@ConnectionPages.Resume</button>
    </div>
</dialog>
