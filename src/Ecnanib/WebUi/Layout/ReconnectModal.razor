<script type="module" src="@Assets["WebUi/Layout/ReconnectModal.razor.js"]"></script>

@*
    The dialog that says the page is rejoining the server, on a page that follows what changes.
    It has a name, and what it says is one part that a screen reader reads out as it changes
    (NFR-USA-1): the framework shows one sentence of it at a time. The seconds that count down
    are left out of that, so they are not read out one by one. Its buttons stand after it.
*@
<dialog id="components-reconnect-modal" data-nosnippet aria-label="@Screens.ServerConnection" aria-describedby="components-reconnect-said">
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <div id="components-reconnect-said" role="status">
            <p class="components-reconnect-first-attempt-visible">
                Rejoining the server...
            </p>
            <p class="components-reconnect-repeated-attempt-visible">
                Rejoin failed... trying again<span aria-hidden="true"> in <span id="components-seconds-to-next-attempt"></span> seconds</span>.
            </p>
            <p class="components-reconnect-failed-visible">
                Failed to rejoin.<br />Please retry or reload the page.
            </p>
            <p class="components-pause-visible">
                The session has been paused by the server.
            </p>
            <p class="components-resume-failed-visible">
                Failed to resume the session.<br />Please retry or reload the page.
            </p>
        </div>
        <button type="button" id="components-reconnect-button" class="components-reconnect-failed-visible">
            Retry
        </button>
        <button type="button" id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            Resume
        </button>
    </div>
</dialog>
