@using Ecnanib.Shared

@*
    What a page writes to follow what changes without a manual refresh (FR-NTF-2): one part,
    for which the page makes a connection once it is in the browser. The page says which
    subjects it is to ask for itself again on, and which parts are written to it over the
    connection. A page that answers a form asks for itself again on nothing: what the form
    answered would be gone from it. The part is told apart by the path of the page, so that it
    stays when the page asks for itself again, and is another one on another page. Everything
    else of the page is rendered on the server for each request, as before.

    A page that its user paused (NFR-USA-1) makes no connection: its parts are written once,
    with what they show as the page is written, and nothing is followed for it, so it changes
    no more by itself. That is how every page is written before its connection is made, so
    nothing else is needed for it. A page that shows no part writes nothing then. What pauses
    a page, and has it follow again, is LivePause, which the page writes under its heading.

    The part stands in an element of its own, in both cases. The framework takes the element
    that holds such a part for another kind of element than one that holds none, and puts a new
    one in its place when a page goes from the one to the other: without an element of its own
    that would be the content of the page, and whatever had the focus there, such as the link
    that pauses, would lose it.
*@

@if (!_paused)
{
    <div class="live-parts">
        <LiveIsland @key="_page" @rendermode="InteractiveServer" View="@_view" />
    </div>
}
else if (Shows != LiveShows.None)
{
    @* Marked, so the stylesheet lets nothing in it move for as long as a state lasts: no state of it lasts. *@
    <div class="live-parts" data-live="paused">
        <LiveIsland View="@_view" />
    </div>
}

@code {
    private string _page = string.Empty;
    private LiveView _view = default!;
    private bool _paused;

    /// <summary>The agent that the page is of, or null for a page of every agent of its user.</summary>
    [Parameter]
    public Guid? AgentId { get; set; }

    /// <summary>The subjects that the page asks for itself again on.</summary>
    [Parameter]
    public LiveSubject[] Follows { get; set; } = [];

    /// <summary>The parts that are written to the page over its connection.</summary>
    [Parameter]
    public LiveShows Shows { get; set; }

    /// <summary>The market of the agent, for the price that the page shows.</summary>
    [Parameter]
    public Market? Market { get; set; }

    /// <summary>The mode of the agent.</summary>
    [Parameter]
    public TradingMode? Mode { get; set; }

    /// <summary>The symbol of the agent.</summary>
    [Parameter]
    public string? Symbol { get; set; }

    /// <summary>The asset that the symbol of the agent is priced in.</summary>
    [Parameter]
    public string? QuoteAsset { get; set; }

    /// <summary>
    /// Whether the page values the open positions of its user at their prices, as the dashboard
    /// does: their prices are followed while the page is open, and the page asks for itself
    /// again when one of them is first read. A page of one agent values what that agent holds,
    /// at the price that it follows for the position.
    /// </summary>
    [Parameter]
    public bool Values { get; set; }

    /// <summary>
    /// The roles of the team of the agent, each with the model that it was given, for a page
    /// that shows the team at work as a pipeline (FR-ANI-1).
    /// </summary>
    [Parameter]
    public IReadOnlyList<LiveRole>? Team { get; set; }

    /// <summary>What ILiveSignals.Mark said before the page read what it shows.</summary>
    [Parameter, EditorRequired]
    public long Since { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnParametersSet()
    {
        // A page is written for a request. Without one there is nothing to follow for.
        var request = HttpContext?.Request ?? throw new InvalidOperationException("A page that follows is written for a request, and there is none.");

        _page = request.Path.Value ?? string.Empty;
        _view = LiveView.Of(request, AgentId, Follows, Shows, Market, Mode, Symbol, QuoteAsset, Since, Values, Team);

        // A choice that there is not is answered by LivePause, with the page that says so.
        _paused = LivePages.PausedOf(request.Query) == true;
    }
}
